
; ---- physical memory ---------------------------------------------

fn rd32(i64) -> i64 {
  entry(a: i64):
    %p = bitcast ptr a
    %v = load i32, %p
    %r = zext i64 %v
    ret %r
}

fn rd64(i64) -> i64 {
  entry(a: i64):
    %p = bitcast ptr a
    %v = load i64, %p
    ret %v
}

fn bm_ptr(i64) -> ptr {
  entry(f: i64):
    %w = lshr i64 f, 6
    %b = call ptr ksf(4096)
    %p = gep i64 %b, %w
    ret %p
}

fn bm_test(i64) -> i64 {
  entry(f: i64):
    %p = call ptr bm_ptr(f)
    %w = load i64, %p
    %bit = and i64 f, 63
    %m = shl i64 1, %bit
    %t = and i64 %w, %m
    %r = icmp.ne i64 %t, 0
    %rv = zext i64 %r
    ret %rv
}

fn bm_set(i64) -> void {
  entry(f: i64):
    %p = call ptr bm_ptr(f)
    %w = load i64, %p
    %bit = and i64 f, 63
    %m = shl i64 1, %bit
    %w2 = or i64 %w, %m
    store i64 %p, %w2
    ret
}

fn bm_clear(i64) -> void {
  entry(f: i64):
    %p = call ptr bm_ptr(f)
    %w = load i64, %p
    %bit = and i64 f, 63
    %m = shl i64 1, %bit
    %nm = xor i64 %m, -1
    %w2 = and i64 %w, %nm
    store i64 %p, %w2
    ret
}

fn set_range(i64, i64) -> void {
  entry(f0: i64, f1: i64):
    br loop(f0, f1)
  loop(f: i64, f1: i64):
    %done = icmp.sge i64 f, f1
    condbr %done, fin(), body(f, f1)
  body(f: i64, f1: i64):
    call void bm_set(f)
    %f2 = add i64 f, 1
    br loop(%f2, f1)
  fin():
    ret
}

fn clear_range(i64, i64) -> void {
  entry(f0: i64, f1: i64):
    %tot = call i64 ld64(480)
    %c1 = icmp.sle i64 f1, %tot
    %e1 = select i64 %c1, f1, %tot
    %c0 = icmp.sle i64 f0, %e1
    %s0 = select i64 %c0, f0, %e1
    br loop(%s0, %e1)
  loop(f: i64, f1: i64):
    %done = icmp.sge i64 f, f1
    condbr %done, fin(), body(f, f1)
  body(f: i64, f1: i64):
    call void bm_clear(f)
    %f2 = add i64 f, 1
    br loop(%f2, f1)
  fin():
    ret
}

fn count_free() -> i64 {
  entry():
    %tot = call i64 ld64(480)
    br loop(0, %tot, 0)
  loop(f: i64, tot: i64, acc: i64):
    %done = icmp.sge i64 f, tot
    condbr %done, fin(acc), body(f, tot, acc)
  body(f: i64, tot: i64, acc: i64):
    %u = call i64 bm_test(f)
    %free = xor i64 %u, 1
    %acc2 = add i64 acc, %free
    %f2 = add i64 f, 1
    br loop(%f2, tot, %acc2)
  fin(acc: i64):
    ret acc
}

fn pmm_fillw(i64) -> void {
  entry(words: i64):
    br loop(0, words)
  loop(w: i64, words: i64):
    %done = icmp.sge i64 w, words
    condbr %done, fin(), body(w, words)
  body(w: i64, words: i64):
    %off = mul i64 w, 8
    %o2 = add i64 4096, %off
    %p = call ptr ksf(%o2)
    store i64 %p, -1
    %w2 = add i64 w, 1
    br loop(%w2, words)
  fin():
    ret
}

fn pmm_walk(i64, i64) -> void {
  entry(addr: i64, end: i64):
    br loop(addr, end)
  loop(addr: i64, end: i64):
    %done = icmp.sge i64 addr, end
    condbr %done, fin(), body(addr, end)
  body(addr: i64, end: i64):
    %a4 = add i64 addr, 4
    %base = call i64 rd64(%a4)
    %a12 = add i64 addr, 12
    %len = call i64 rd64(%a12)
    %a20 = add i64 addr, 20
    %ty = call i64 rd32(%a20)
    %size = call i64 rd32(addr)
    %ist = icmp.eq i64 %ty, 1
    condbr %ist, usable(addr, end, %base, %len, %size), skip(addr, end, %size)
  usable(addr: i64, end: i64, base: i64, len: i64, size: i64):
    %bend = add i64 base, len
    %f0raw = add i64 base, 4095
    %f0 = lshr i64 %f0raw, 12
    %f1 = lshr i64 %bend, 12
    call void clear_range(%f0, %f1)
    br skip(addr, end, size)
  skip(addr: i64, end: i64, size: i64):
    %step = add i64 size, 4
    %next = add i64 addr, %step
    br loop(%next, end)
  fin():
    ret
}

fn pmm_init(ptr) -> void {
  entry(mbi: ptr):
    %ma = bitcast i64 mbi
    %f4 = add i64 %ma, 4
    %lower = call i64 rd32(%f4)
    %f8 = add i64 %ma, 8
    %upper = call i64 rd32(%f8)
    %ramkb = add i64 %lower, %upper
    call void st64(496, %ramkb)
    %ab1 = add i64 1024, %upper
    %bytes = mul i64 %ab1, 1024
    %fr = lshr i64 %bytes, 12
    %over = icmp.sgt i64 %fr, 131072
    %frames = select i64 %over, 131072, %fr
    call void st64(480, %frames)
    call void zero_range(4096, 16384)
    %wraw = add i64 %frames, 63
    %words = lshr i64 %wraw, 6
    call void pmm_fillw(%words)
    %flags = call i64 rd32(%ma)
    %has = and i64 %flags, 64
    %ok = icmp.ne i64 %has, 0
    condbr %ok, walk(%ma), reserve()
  walk(ma: i64):
    %f44 = add i64 ma, 44
    %mlen = call i64 rd32(%f44)
    %f48 = add i64 ma, 48
    %maddr = call i64 rd32(%f48)
    %mend = add i64 %maddr, %mlen
    call void pmm_walk(%maddr, %mend)
    br reserve()
  reserve():
    call void set_range(0, 1536)
    call void st64(504, -1)
    %free = call i64 count_free()
    call void st64(488, %free)
    ret
}

fn pmm_alloc() -> i64 {
  entry():
    %e1 = iconst i64 1
    %tot = call i64 ld64(480)
    br loop(1536, %tot)
  loop(f: i64, tot: i64):
    %done = icmp.sge i64 f, tot
    condbr %done, none(), body(f, tot)
  body(f: i64, tot: i64):
    %u = call i64 bm_test(f)
    %isfree = icmp.eq i64 %u, 0
    condbr %isfree, take(f), next(f, tot)
  next(f: i64, tot: i64):
    %f2 = add i64 f, 1
    br loop(%f2, tot)
  take(f: i64):
    call void bm_set(f)
    %fr = call i64 ld64(488)
    %fr2 = sub i64 %fr, 1
    call void st64(488, %fr2)
    %addr = shl i64 f, 12
    ret %addr
  none():
    ret -1
}

fn pmm_free(i64) -> void {
  entry(addr: i64):
    %f = lshr i64 addr, 12
    %u = call i64 bm_test(%f)
    %was = icmp.eq i64 %u, 1
    condbr %was, go(%f), fin()
  go(f: i64):
    call void bm_clear(f)
    %fr = call i64 ld64(488)
    %fr2 = add i64 %fr, 1
    call void st64(488, %fr2)
    br fin()
  fin():
    ret
}

; ---- interrupts ---------------------------------------------------

fn idt_init() -> void {
  entry():
    %e2 = iconst i64 2
    %base = call i64 k_stub_base()
    %idt = call ptr ksf(32768)
    br loop(0, %base, %idt)
  loop(v: i64, base: i64, idt: ptr):
    %done = icmp.sge i64 v, 256
    condbr %done, fin(%base, idt), body(v, base, idt)
  body(v: i64, base: i64, idt: ptr):
    %lt = icmp.slt i64 v, 48
    %sel = select i64 %lt, v, 48
    %soff = mul i64 %sel, 16
    %stub = add i64 base, %soff
    %eoff = mul i64 v, 16
    %e = gep i8 idt, %eoff
    %lo = and i64 %stub, 65535
    %lo16 = trunc i16 %lo
    store i16 %e, %lo16
    %e2 = gep i8 idt, %eoff
    %e2b = gep i8 %e2, 2
    store i16 %e2b, 8
    %e4 = gep i8 idt, %eoff
    %e4b = gep i8 %e4, 4
    store i8 %e4b, 0
    %e5 = gep i8 idt, %eoff
    %e5b = gep i8 %e5, 5
    store i8 %e5b, 142
    %mid = lshr i64 %stub, 16
    %midv = and i64 %mid, 65535
    %mid16 = trunc i16 %midv
    %e6 = gep i8 idt, %eoff
    %e6b = gep i8 %e6, 6
    store i16 %e6b, %mid16
    %hi = lshr i64 %stub, 32
    %hi32 = trunc i32 %hi
    %e8 = gep i8 idt, %eoff
    %e8b = gep i8 %e8, 8
    store i32 %e8b, %hi32
    %e12 = gep i8 idt, %eoff
    %e12b = gep i8 %e12, 12
    store i32 %e12b, 0
    %v2 = add i64 v, 1
    br loop(%v2, base, idt)
  fin(base: i64, idt: ptr):
    %idtr = call ptr ksf(36864)
    store i16 %idtr, 4095
    %b2 = gep i8 %idtr, 2
    %ia = bitcast i64 idt
    store i64 %b2, %ia
    call void k_lidt(%idtr)
    ret
}

fn pic_init() -> void {
  entry():
    call void k_out8(0x20, 0x11)
    call void k_out8(0xa0, 0x11)
    call void k_out8(0x21, 0x20)
    call void k_out8(0xa1, 0x28)
    call void k_out8(0x21, 0x04)
    call void k_out8(0xa1, 0x02)
    call void k_out8(0x21, 0x01)
    call void k_out8(0xa1, 0x01)
    call void k_out8(0x21, 0xfc)
    call void k_out8(0xa1, 0xff)
    ret
}

fn pit_init() -> void {
  entry():
    call void k_out8(0x43, 0x36)
    call void k_out8(0x40, 0x9c)
    call void k_out8(0x40, 0x2e)
    ret
}

fn eoi(i64) -> void {
  entry(vec: i64):
    call void k_out8(0x20, 0x20)
    %hi = icmp.sge i64 vec, 40
    condbr %hi, slave(), fin()
  slave():
    call void k_out8(0xa0, 0x20)
    br fin()
  fin():
    ret
}

fn k_dispatch(i64) -> void {
  entry(vec: i64):
    %e1 = iconst i64 1
    %e48 = iconst i64 48
    %exc = icmp.slt i64 vec, 32
    condbr %exc, panic(vec), chk(vec)
  chk(vec: i64):
    %ist = icmp.eq i64 vec, 32
    condbr %ist, tick(), chk2(vec)
  chk2(vec: i64):
    %isk = icmp.eq i64 vec, 33
    condbr %isk, kbd(), other(vec)
  other(vec: i64):
    %isirq = icmp.slt i64 vec, 48
    condbr %isirq, irqother(vec), fin()
  irqother(vec: i64):
    call void eoi(vec)
    br fin()
  fin():
    ret
  tick():
    %t = call i64 ld64(0)
    %t2 = add i64 %t, 1
    call void st64(0, %t2)
    %r = srem i64 %t2, 100
    %sec = icmp.eq i64 %r, 0
    condbr %sec, secup(), teoi()
  secup():
    %s = call i64 ld64(8)
    %s2 = add i64 %s, 1
    call void st64(8, %s2)
    br teoi()
  teoi():
    call void eoi(32)
    ret
  kbd():
    %sc = call i32 k_in8(0x60)
    %v = zext i64 %sc
    %head = call i64 ld64(32)
    %h1 = add i64 %head, 1
    %next = and i64 %h1, 255
    %tail = call i64 ld64(40)
    %full = icmp.eq i64 %next, %tail
    condbr %full, keoi(), kstore(%v, %head, %next)
  kstore(v: i64, head: i64, next: i64):
    %off = add i64 48, head
    %p = call ptr ksf(%off)
    %b = trunc i8 v
    store i8 %p, %b
    call void st64(32, next)
    br keoi()
  keoi():
    call void eoi(33)
    ret
  panic(vec: i64):
    call void k_cli()
    %m = call ptr s_exc()
    call void con_write(%m)
    call void putu(vec)
    %h = call ptr s_halt()
    call void con_write(%h)
    call void con_putc(10)
    br ploop()
  ploop():
    call void k_hlt()
    br ploop()
}

; ---- tasks and the scheduler ----------------------------------------

fn task_init(i64, i64) -> void {
  entry(id: i64, period: i64):
    %io = mul i64 id, 48
    %b = add i64 512, %io
    call void st64(%b, period)
    %t = call i64 ld64(0)
    %nx = add i64 %t, period
    %b8 = add i64 %b, 8
    call void st64(%b8, %nx)
    %b16 = add i64 %b, 16
    call void st64(%b16, 0)
    %b24 = add i64 %b, 24
    call void st64(%b24, 0)
    ret
}

fn task_setup() -> void {
  entry():
    call void task_init(0, 0)
    call void task_init(1, 100)
    call void task_init(2, 7)
    call void task_init(3, 10)
    ret
}

fn clock_step() -> void {
  entry():
    call void bar_paint()
    ret
}

fn beat_step() -> void {
  entry():
    ret
}

fn spin_step() -> void {
  entry():
    %idx = call i64 ld64(600)
    %tab = call ptr s_spin()
    %p = gep i8 %tab, %idx
    %b = load i8, %p
    %ch = zext i64 %b
    call void cell_write(79, 0, %ch, 31)
    %i2 = add i64 %idx, 1
    %nx = and i64 %i2, 3
    call void st64(600, %nx)
    ret
}

fn task_due(i64) -> i64 {
  entry(id: i64):
    %io = mul i64 id, 48
    %b = add i64 512, %io
    %b8 = add i64 %b, 8
    %nx = call i64 ld64(%b8)
    %t = call i64 ld64(0)
    %due = icmp.sge i64 %t, %nx
    %r = zext i64 %due
    ret %r
}

fn task_run(i64) -> void {
  entry(id: i64):
    %io = mul i64 id, 48
    %b = add i64 512, %io
    %is1 = icmp.eq i64 id, 1
    condbr %is1, run1(%b), chk2(id, %b)
  chk2(id: i64, b: i64):
    %is2 = icmp.eq i64 id, 2
    condbr %is2, run2(%b), chk3(id, %b)
  chk3(id: i64, b: i64):
    %is3 = icmp.eq i64 id, 3
    condbr %is3, run3(%b), resched(%b)
  run1(b: i64):
    call void clock_step()
    br resched(b)
  run2(b: i64):
    call void beat_step()
    br resched(b)
  run3(b: i64):
    call void spin_step()
    br resched(b)
  resched(b: i64):
    %b16 = add i64 b, 16
    %w = call i64 ld64(%b16)
    %w2 = add i64 %w, 1
    call void st64(%b16, %w2)
    %b8 = add i64 b, 8
    %nx = call i64 ld64(%b8)
    %per = call i64 ld64(b)
    %cand = add i64 %nx, %per
    %t = call i64 ld64(0)
    %late = icmp.sle i64 %cand, %t
    %fix = add i64 %t, %per
    %fin = select i64 %late, %fix, %cand
    call void st64(%b8, %fin)
    ret
}

; ---- the shell ------------------------------------------------------

fn kbd_getc() -> i64 {
  entry():
    %head = call i64 ld64(32)
    %tail = call i64 ld64(40)
    %empty = icmp.eq i64 %head, %tail
    condbr %empty, none(), got(%tail)
  none():
    ret -1
  got(tail: i64):
    %off = add i64 48, tail
    %p = call ptr ksf(%off)
    %b = load i8, %p
    %v = zext i64 %b
    %t2 = add i64 tail, 1
    %nt = and i64 %t2, 255
    call void st64(40, %nt)
    ret %v
}

fn prompt() -> void {
  entry():
    %p = call ptr s_prompt()
    call void con_write(%p)
    ret
}

fn putn(ptr, i64) -> void {
  entry(p: ptr, n: i64):
    br loop(p, n, 0)
  loop(p: ptr, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(p, n, i)
  body(p: ptr, n: i64, i: i64):
    %a = gep i8 p, i
    %b = load i8, %a
    %v = zext i64 %b
    call void con_putc(%v)
    %i2 = add i64 i, 1
    br loop(p, n, %i2)
  fin():
    ret
}

fn match(ptr, i64, ptr) -> i64 {
  entry(lp: ptr, n: i64, cp: ptr):
    %e0 = iconst i64 0
    br loop(lp, n, cp, 0)
  loop(lp: ptr, n: i64, cp: ptr, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, tailck(cp, n), body(lp, n, cp, i)
  body(lp: ptr, n: i64, cp: ptr, i: i64):
    %a = gep i8 lp, i
    %x = load i8, %a
    %b2 = gep i8 cp, i
    %y = load i8, %b2
    %eq = icmp.eq i8 %x, %y
    condbr %eq, next(lp, n, cp, i), no()
  next(lp: ptr, n: i64, cp: ptr, i: i64):
    %i2 = add i64 i, 1
    br loop(lp, n, cp, %i2)
  tailck(cp: ptr, n: i64):
    %a = gep i8 cp, n
    %y = load i8, %a
    %z = icmp.eq i8 %y, 0
    %r = zext i64 %z
    ret %r
  no():
    ret 0
}

fn name_of(i64) -> ptr {
  entry(id: i64):
    %i0 = icmp.eq i64 id, 0
    condbr %i0, n0(), c1(id)
  c1(id: i64):
    %i1 = icmp.eq i64 id, 1
    condbr %i1, n1(), c2(id)
  c2(id: i64):
    %i2 = icmp.eq i64 id, 2
    condbr %i2, n2(), n3()
  n0():
    %p = call ptr s_t0()
    ret %p
  n1():
    %p = call ptr s_t1()
    ret %p
  n2():
    %p = call ptr s_t2()
    ret %p
  n3():
    %p = call ptr s_t3()
    ret %p
}

fn cmd_help() -> void {
  entry():
    %p = call ptr s_help()
    call void con_write(%p)
    ret
}

fn cmd_about() -> void {
  entry():
    %p = call ptr s_about()
    call void con_write(%p)
    ret
}

fn cmd_mem() -> void {
  entry():
    %a = call ptr s_mema()
    call void con_write(%a)
    %ram = call i64 ld64(496)
    call void putu(%ram)
    %b = call ptr s_memb()
    call void con_write(%b)
    %fr = call i64 ld64(488)
    call void putu(%fr)
    %c = call ptr s_memc()
    call void con_write(%c)
    %tot = call i64 ld64(480)
    call void putu(%tot)
    call void con_putc(10)
    ret
}

fn cmd_ticks() -> void {
  entry():
    %a = call ptr s_ticksa()
    call void con_write(%a)
    %t = call i64 ld64(0)
    call void putu(%t)
    %b = call ptr s_ticksb()
    call void con_write(%b)
    %s = call i64 ld64(8)
    call void putu(%s)
    call void con_putc(115)
    call void con_putc(10)
    ret
}

fn cmd_ps() -> void {
  entry():
    %h = call ptr s_pshdr()
    call void con_write(%h)
    br loop(0)
  loop(id: i64):
    %done = icmp.sge i64 id, 4
    condbr %done, fin(), body(id)
  body(id: i64):
    %nm = call ptr name_of(id)
    call void con_write(%nm)
    call void con_putc(32)
    %io = mul i64 id, 48
    %b = add i64 512, %io
    %b16 = add i64 %b, 16
    %w = call i64 ld64(%b16)
    call void putu(%w)
    call void con_putc(10)
    %i2 = add i64 id, 1
    br loop(%i2)
  fin():
    ret
}

fn cmd_alloc() -> void {
  entry():
    %f = call i64 pmm_alloc()
    %none = icmp.eq i64 %f, -1
    condbr %none, nof(), got(%f)
  nof():
    %m = call ptr s_allocnone()
    call void con_write(%m)
    ret
  got(f: i64):
    call void st64(504, f)
    %p = bitcast ptr f
    store i64 %p, 0x4b304b304b304b30
    %v = load i64, %p
    %a = call ptr s_alloca()
    call void con_write(%a)
    call void putu(f)
    %ok = icmp.eq i64 %v, 0x4b304b304b304b30
    condbr %ok, okm(), badm()
  okm():
    %m = call ptr s_allocb()
    call void con_write(%m)
    ret
  badm():
    %m = call ptr s_allocbad()
    call void con_write(%m)
    ret
}

fn cmd_free() -> void {
  entry():
    %f = call i64 ld64(504)
    %none = icmp.eq i64 %f, -1
    condbr %none, nof(), go(%f)
  nof():
    %m = call ptr s_freenone()
    call void con_write(%m)
    ret
  go(f: i64):
    call void pmm_free(f)
    call void st64(504, -1)
    %m = call ptr s_freeda()
    call void con_write(%m)
    call void putu(f)
    call void con_putc(10)
    ret
}

fn cmd_clear() -> void {
  entry():
    call void clear_text()
    ret
}

fn cmd_echo(ptr) -> void {
  entry(rest: ptr):
    call void con_write(rest)
    call void con_putc(10)
    ret
}

fn exec_line() -> void {
  entry():
    %e1 = iconst i64 1
    %w = call i64 ld64(528)
    %w2 = add i64 %w, 1
    call void st64(528, %w2)
    %line = call ptr ksf(304)
    %len = call i64 ld64(464)
    %e = gep i8 %line, %len
    store i8 %e, 0
    br find(%line, %len, 0)
  find(line: ptr, len: i64, i: i64):
    %done = icmp.sge i64 i, len
    condbr %done, whole(line, len), body(line, len, i)
  body(line: ptr, len: i64, i: i64):
    %a = gep i8 line, i
    %b = load i8, %a
    %sp = icmp.eq i8 %b, 32
    condbr %sp, split(line, len, i), next(line, len, i)
  next(line: ptr, len: i64, i: i64):
    %i2 = add i64 i, 1
    br find(line, len, %i2)
  whole(line: ptr, len: i64):
    %rest = gep i8 line, len
    br disp(line, len, %rest)
  split(line: ptr, len: i64, i: i64):
    %r0 = add i64 i, 1
    %rest = gep i8 line, %r0
    br disp(line, i, %rest)
  disp(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_chelp()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dohelp(), d2(line, wlen, rest)
  dohelp():
    call void cmd_help()
    ret
  d2(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cabout()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doabout(), d3(line, wlen, rest)
  doabout():
    call void cmd_about()
    ret
  d3(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cmem()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, domem(), d4(line, wlen, rest)
  domem():
    call void cmd_mem()
    ret
  d4(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cticks()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doticks(), d5(line, wlen, rest)
  doticks():
    call void cmd_ticks()
    ret
  d5(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cps()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dops(), d6(line, wlen, rest)
  dops():
    call void cmd_ps()
    ret
  d6(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_calloc()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doalloc(), d7(line, wlen, rest)
  doalloc():
    call void cmd_alloc()
    ret
  d7(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cfree()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dofree(), d8(line, wlen, rest)
  dofree():
    call void cmd_free()
    ret
  d8(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cclear()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doclear(), d9(line, wlen, rest)
  doclear():
    call void cmd_clear()
    ret
  d9(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cecho()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doecho(rest), dno(line, wlen)
  doecho(rest: ptr):
    call void cmd_echo(rest)
    ret
  dno(line: ptr, wlen: i64):
    %empty = icmp.eq i64 wlen, 0
    condbr %empty, fin(), unk(line, wlen)
  unk(line: ptr, wlen: i64):
    %m = call ptr s_unknown()
    call void con_write(%m)
    call void putn(line, wlen)
    call void con_putc(10)
    br fin()
  fin():
    ret
}

; ---- entry ------------------------------------------------------------

fn handle_sc(i64) -> void {
  entry(sc: i64):
    %e0 = iconst i64 0
    %e1 = iconst i64 1
    %e304 = iconst i64 304
    %e464 = iconst i64 464
    %e472 = iconst i64 472
    %s1 = icmp.eq i64 sc, 42
    condbr %s1, shon(), c2(sc)
  c2(sc: i64):
    %s2 = icmp.eq i64 sc, 54
    condbr %s2, shon(), c3(sc)
  c3(sc: i64):
    %s3 = icmp.eq i64 sc, 170
    condbr %s3, shoff(), c4(sc)
  c4(sc: i64):
    %s4 = icmp.eq i64 sc, 182
    condbr %s4, shoff(), c5(sc)
  c5(sc: i64):
    %rel = icmp.sge i64 sc, 128
    condbr %rel, fin(), c6(sc)
  c6(sc: i64):
    %ent = icmp.eq i64 sc, 28
    condbr %ent, enter(), c7(sc)
  c7(sc: i64):
    %bk = icmp.eq i64 sc, 14
    condbr %bk, bksp(), c8(sc)
  c8(sc: i64):
    %big = icmp.sge i64 sc, 58
    condbr %big, fin(), type(sc)
  shon():
    call void st64(472, 1)
    br fin()
  shoff():
    call void st64(472, 0)
    br fin()
  enter():
    call void con_putc(10)
    call void exec_line()
    call void st64(464, 0)
    call void prompt()
    br fin()
  bksp():
    %len = call i64 ld64(464)
    %has = icmp.sgt i64 %len, 0
    condbr %has, bkgo(%len), fin()
  bkgo(len: i64):
    %l2 = sub i64 %len, 1
    call void st64(464, %l2)
    call void con_putc(8)
    br fin()
  type(sc: i64):
    %sh = call i64 ld64(472)
    %issh = icmp.ne i64 %sh, 0
    condbr %issh, tshift(sc), tplain(sc)
  tplain(sc: i64):
    %tab = call ptr s_tab1()
    br tgo(sc, %tab)
  tshift(sc: i64):
    %tab = call ptr s_tab2()
    br tgo(sc, %tab)
  tgo(sc: i64, tab: ptr):
    %a = gep i8 tab, sc
    %b = load i8, %a
    %ch = zext i64 %b
    %nz = icmp.ne i64 %ch, 0
    condbr %nz, tstore(sc, %ch), fin()
  tstore(sc: i64, ch: i64):
    %len = call i64 ld64(464)
    %room = icmp.slt i64 %len, 150
    condbr %room, tput(%len, %ch), fin()
  tput(len: i64, ch: i64):
    %off = add i64 304, %len
    %p = call ptr ksf(%off)
    %tb = trunc i8 ch
    store i8 %p, %tb
    %l2 = add i64 %len, 1
    call void st64(464, %l2)
    call void con_putc(%ch)
    br fin()
  fin():
    ret
}

fn shell_poll() -> void {
  entry():
    br loop()
  loop():
    %sc = call i64 kbd_getc()
    %done = icmp.eq i64 %sc, -1
    condbr %done, fin(), body(%sc)
  body(sc: i64):
    call void handle_sc(sc)
    br loop()
  fin():
    ret
}

fn sched_pass() -> void {
  entry():
    call void shell_poll()
    br loop(1)
  loop(id: i64):
    %done = icmp.sge i64 id, 4
    condbr %done, fin(), body(id)
  body(id: i64):
    %due = call i64 task_due(id)
    %is = icmp.ne i64 %due, 0
    condbr %is, run(id), next(id)
  run(id: i64):
    call void task_run(id)
    br next(id)
  next(id: i64):
    %i2 = add i64 id, 1
    br loop(%i2)
  fin():
    ret
}

fn kernel_loop() -> void {
  entry():
    br loop()
  loop():
    call void sched_pass()
    call void k_hlt()
    br loop()
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, mbi: ptr):
    %enl = iconst i64 10
    call void ser_init()
    call void con_init()
    %t = call ptr s_banner1()
    call void con_write_a(%t, 11)
    call void con_putc(10)
    %s2 = call ptr s_banner2()
    call void con_write(%s2)
    call void con_putc(10)
    %ok = icmp.eq i32 argc, 0x2badb002
    condbr %ok, okb(mbi), badb(mbi)
  okb(mbi: ptr):
    %m = call ptr s_bootok()
    call void con_write(%m)
    call void con_putc(10)
    br boot2(mbi)
  badb(mbi: ptr):
    %m = call ptr s_bootbad()
    call void con_write(%m)
    call void con_putc(10)
    br boot2(mbi)
  boot2(mbi: ptr):
    call void pmm_init(mbi)
    %bp = call ptr s_bootpfx()
    call void con_write(%bp)
    %a = call ptr s_mema()
    call void con_write(%a)
    %ram = call i64 ld64(496)
    call void putu(%ram)
    %b = call ptr s_memb()
    call void con_write(%b)
    %fr = call i64 ld64(488)
    call void putu(%fr)
    %c = call ptr s_memc()
    call void con_write(%c)
    %tot = call i64 ld64(480)
    call void putu(%tot)
    call void con_putc(10)
    call void idt_init()
    call void pic_init()
    call void pit_init()
    call void task_setup()
    call void k_sti()
    %i = call ptr s_ints()
    call void con_write(%i)
    call void con_putc(10)
    %r = call ptr s_ready()
    call void con_write(%r)
    call void con_putc(10)
    call void prompt()
    call void kernel_loop()
    ret 0
}
