extern k_out8(i32, i32) -> void
extern k_in8(i32) -> i32
extern k_out16(i32, i32) -> void
extern k_in16(i32) -> i32
extern k_out32(i32, i32) -> void
extern k_in32(i32) -> i32
extern k_lidt(ptr) -> void
extern k_sti() -> void
extern k_cli() -> void
extern k_hlt() -> void
extern k_stub_base() -> i64
extern k_arena_base() -> i64

; ---- arena access ---------------------------------------------

fn ks() -> ptr {
  entry():
    %a = call i64 k_arena_base()
    %p = bitcast ptr %a
    ret %p
}

fn ksf(i64) -> ptr {
  entry(off: i64):
    %b = call ptr ks()
    %p = gep i8 %b, off
    ret %p
}

fn ld64(i64) -> i64 {
  entry(off: i64):
    %p = call ptr ksf(off)
    %v = load i64, %p
    ret %v
}

fn st64(i64, i64) -> void {
  entry(off: i64, v: i64):
    %p = call ptr ksf(off)
    store i64 %p, v
    ret
}

fn zero_range(i64, i64) -> void {
  entry(off: i64, n: i64):
    br loop(0, off, n)
  loop(i: i64, off: i64, n: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(i, off, n)
  body(i: i64, off: i64, n: i64):
    %o = add i64 off, i
    %p = call ptr ksf(%o)
    store i8 %p, 0
    %i2 = add i64 i, 1
    br loop(%i2, off, n)
  fin():
    ret
}

; ---- serial (COM1, polled) -------------------------------------

fn ser_init() -> void {
  entry():
    call void k_out8(0x3f9, 0)
    call void k_out8(0x3fb, 128)
    call void k_out8(0x3f8, 1)
    call void k_out8(0x3f9, 0)
    call void k_out8(0x3fb, 3)
    call void k_out8(0x3fa, 199)
    call void k_out8(0x3fc, 11)
    ret
}

fn ser_putc(i64) -> void {
  entry(c: i64):
    br poll(c)
  poll(c: i64):
    %lsr = call i32 k_in8(0x3fd)
    %v = zext i64 %lsr
    %rdy = and i64 %v, 32
    %ok = icmp.ne i64 %rdy, 0
    condbr %ok, send(c), poll(c)
  send(c: i64):
    %b = trunc i32 c
    call void k_out8(0x3f8, %b)
    ret
}

; ---- VGA text console -------------------------------------------

fn cellptr(i64, i64) -> ptr {
  entry(x: i64, y: i64):
    %row = mul i64 y, 80
    %idx = add i64 %row, x
    %off = mul i64 %idx, 2
    %addr = add i64 753664, %off
    %p = bitcast ptr %addr
    ret %p
}

fn cell_write(i64, i64, i64, i64) -> void {
  entry(x: i64, y: i64, ch: i64, attr: i64):
    %p = call ptr cellptr(x, y)
    %a8 = shl i64 attr, 8
    %v = or i64 %a8, ch
    %v16 = trunc i16 %v
    store i16 %p, %v16
    ret
}

fn cursor_update() -> void {
  entry():
    %x = call i64 ld64(16)
    %y = call i64 ld64(24)
    %row = mul i64 %y, 80
    %pos = add i64 %row, %x
    %lo = and i64 %pos, 255
    %lo32 = trunc i32 %lo
    call void k_out8(0x3d4, 15)
    call void k_out8(0x3d5, %lo32)
    %hi = lshr i64 %pos, 8
    %hi2 = and i64 %hi, 255
    %hi32 = trunc i32 %hi2
    call void k_out8(0x3d4, 14)
    call void k_out8(0x3d5, %hi32)
    ret
}

fn scroll() -> void {
  entry():
    %e0 = iconst i64 0
    %e80 = iconst i64 80
    %e24 = iconst i64 24
    br rows(1)
  rows(y: i64):
    %done = icmp.sge i64 y, 24
    condbr %done, clr(), copy(y)
  copy(y: i64):
    br cells(y, 0)
  cells(y: i64, x: i64):
    %done = icmp.sge i64 x, 80
    condbr %done, next(y), one(y, x)
  one(y: i64, x: i64):
    %y1 = add i64 y, 1
    %src = call ptr cellptr(x, %y1)
    %v = load i16, %src
    %dst = call ptr cellptr(x, y)
    store i16 %dst, %v
    %x2 = add i64 x, 1
    br cells(y, %x2)
  next(y: i64):
    %y2 = add i64 y, 1
    br rows(%y2)
  clr():
    br clrc(0)
  clrc(x: i64):
    %done = icmp.sge i64 x, 80
    condbr %done, fin(), cone(x)
  cone(x: i64):
    call void cell_write(x, 24, 32, 7)
    %x2 = add i64 x, 1
    br clrc(%x2)
  fin():
    ret
}

fn con_putc_a(i64, i64) -> void {
  entry(c: i64, attr: i64):
    %e0 = iconst i64 0
    %e1 = iconst i64 1
    %e16 = iconst i64 16
    %e24 = iconst i64 24
    %isn = icmp.eq i64 c, 10
    condbr %isn, nl(attr), chkcr(c, attr)
  chkcr(c: i64, attr: i64):
    %isc = icmp.eq i64 c, 13
    condbr %isc, cr(attr), chkbs(c, attr)
  cr(attr: i64):
    call void st64(16, 0)
    br tail(attr)
  chkbs(c: i64, attr: i64):
    %isb = icmp.eq i64 c, 8
    condbr %isb, bs(attr), pr(c, attr)
  bs(attr: i64):
    %x = call i64 ld64(16)
    %gt = icmp.sgt i64 %x, 0
    condbr %gt, bsgo(%x, attr), tail(attr)
  bsgo(x: i64, attr: i64):
    %x2 = sub i64 %x, 1
    call void st64(16, %x2)
    %y = call i64 ld64(24)
    call void cell_write(%x2, %y, 32, 7)
    br tail(attr)
  nl(attr: i64):
    call void st64(16, 0)
    %y = call i64 ld64(24)
    %y2 = add i64 %y, 1
    call void st64(24, %y2)
    br maybescroll(attr)
  pr(c: i64, attr: i64):
    %x = call i64 ld64(16)
    %y = call i64 ld64(24)
    call void cell_write(%x, %y, c, attr)
    %x2 = add i64 %x, 1
    %wrap = icmp.sge i64 %x2, 80
    condbr %wrap, wrap(attr), adv(%x2, attr)
  adv(x: i64, attr: i64):
    call void st64(16, x)
    br tail(attr)
  wrap(attr: i64):
    call void st64(16, 0)
    %y = call i64 ld64(24)
    %y2 = add i64 %y, 1
    call void st64(24, %y2)
    br maybescroll(attr)
  maybescroll(attr: i64):
    %y = call i64 ld64(24)
    %over = icmp.sgt i64 %y, 24
    condbr %over, doscroll(attr), tail(attr)
  doscroll(attr: i64):
    call void scroll()
    call void st64(24, 24)
    br tail(attr)
  tail(attr: i64):
    call void cursor_update()
    ret
}

fn con_putc(i64) -> void {
  entry(c: i64):
    call void ser_putc(c)
    %fb = call i64 ld64(77824)
    %on = icmp.eq i64 %fb, 1
    condbr %on, fb(c), vga(c)
  fb(c: i64):
    call void fb_putc(c)
    ret
  vga(c: i64):
    call void con_putc_a(c, 7)
    ret
}

fn con_write(ptr) -> void {
  entry(p: ptr):
    br loop(p, 0)
  loop(p: ptr, i: i64):
    %a = gep i8 p, i
    %b = load i8, %a
    %v = zext i64 %b
    %done = icmp.eq i64 %v, 0
    condbr %done, fin(), body(p, i, %v)
  body(p: ptr, i: i64, v: i64):
    call void con_putc(v)
    %i2 = add i64 i, 1
    br loop(p, %i2)
  fin():
    ret
}

fn con_write_a(ptr, i64) -> void {
  entry(p: ptr, attr: i64):
    br loop(p, 0, attr)
  loop(p: ptr, i: i64, attr: i64):
    %a = gep i8 p, i
    %b = load i8, %a
    %v = zext i64 %b
    %done = icmp.eq i64 %v, 0
    condbr %done, fin(), body(p, i, attr, %v)
  body(p: ptr, i: i64, attr: i64, v: i64):
    call void ser_putc(v)
    call void con_putc_a(v, attr)
    %i2 = add i64 i, 1
    br loop(p, %i2, attr)
  fin():
    ret
}

fn str_at(i64, i64, ptr, i64) -> void {
  entry(x: i64, y: i64, p: ptr, attr: i64):
    br loop(x, y, p, attr, 0)
  loop(x: i64, y: i64, p: ptr, attr: i64, i: i64):
    %a = gep i8 p, i
    %b = load i8, %a
    %v = zext i64 %b
    %done = icmp.eq i64 %v, 0
    condbr %done, fin(), body(x, y, p, attr, i, %v)
  body(x: i64, y: i64, p: ptr, attr: i64, i: i64, v: i64):
    %cx = add i64 x, i
    call void cell_write(%cx, y, v, attr)
    %i2 = add i64 i, 1
    br loop(x, y, p, attr, %i2)
  fin():
    ret
}

; Decimal digits of v, written reversed into buf. Returns count.
fn digits(i64, ptr) -> i64 {
  entry(v: i64, buf: ptr):
    br fill(v, 0, buf)
  fill(v: i64, n: i64, buf: ptr):
    %d = urem i64 v, 10
    %ch = add i64 %d, 48
    %a = gep i8 buf, n
    %t = trunc i8 %ch
    store i8 %a, %t
    %q = udiv i64 v, 10
    %n2 = add i64 n, 1
    %more = icmp.ne i64 %q, 0
    condbr %more, fill(%q, %n2, buf), fin(%n2)
  fin(n: i64):
    ret n
}

fn putu(i64) -> void {
  entry(v: i64):
    %buf = call ptr ksf(40960)
    %n = call i64 digits(v, %buf)
    br emit(%n, 0, %buf)
  emit(n: i64, i: i64, buf: ptr):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(n, i, buf)
  body(n: i64, i: i64, buf: ptr):
    %nm1 = sub i64 n, 1
    %j = sub i64 %nm1, i
    %a = gep i8 buf, %j
    %b = load i8, %a
    %v = zext i64 %b
    call void con_putc(%v)
    %i2 = add i64 i, 1
    br emit(n, %i2, buf)
  fin():
    ret
}

fn num_at(i64, i64, i64, i64) -> void {
  entry(x: i64, y: i64, v: i64, attr: i64):
    %buf = call ptr ksf(40960)
    %n = call i64 digits(v, %buf)
    br emit(x, y, %n, 0, %buf, attr)
  emit(x: i64, y: i64, n: i64, i: i64, buf: ptr, attr: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(x, y, n, i, buf, attr)
  body(x: i64, y: i64, n: i64, i: i64, buf: ptr, attr: i64):
    %nm1 = sub i64 n, 1
    %j = sub i64 %nm1, i
    %a = gep i8 buf, %j
    %b = load i8, %a
    %v = zext i64 %b
    %cx = add i64 x, i
    call void cell_write(%cx, y, %v, attr)
    %i2 = add i64 i, 1
    br emit(x, y, n, %i2, buf, attr)
  fin():
    ret
}

fn fill_rows(i64, i64, i64) -> void {
  entry(y0: i64, y1: i64, attr: i64):
    %e1 = iconst i64 1
    br rows(y0, y1, attr)
  rows(y: i64, y1: i64, attr: i64):
    %done = icmp.sgt i64 y, y1
    condbr %done, fin(), cols(y, y1, attr, 0)
  cols(y: i64, y1: i64, attr: i64, x: i64):
    %done = icmp.sge i64 x, 80
    condbr %done, next(y, y1, attr), one(y, y1, attr, x)
  one(y: i64, y1: i64, attr: i64, x: i64):
    call void cell_write(x, y, 32, attr)
    %x2 = add i64 x, 1
    br cols(y, y1, attr, %x2)
  next(y: i64, y1: i64, attr: i64):
    %y2 = add i64 y, 1
    br rows(%y2, y1, attr)
  fin():
    ret
}

fn bar_paint() -> void {
  entry():
    call void fill_rows(0, 0, 31)
    %t = call ptr s_bark0()
    call void str_at(1, 0, %t, 31)
    %u = call ptr s_barup()
    call void str_at(5, 0, %u, 31)
    %sec = call i64 ld64(8)
    call void num_at(12, 0, %sec, 31)
    %s = call ptr s_barunit()
    call void str_at(19, 0, %s, 31)
    %tk = call ptr s_bartick()
    call void str_at(22, 0, %tk, 31)
    %tv = call i64 ld64(0)
    call void num_at(28, 0, %tv, 31)
    %f = call ptr s_barfree()
    call void str_at(38, 0, %f, 31)
    %fv = call i64 ld64(488)
    call void num_at(50, 0, %fv, 31)
    ret
}

fn con_init() -> void {
  entry():
    call void fill_rows(0, 24, 7)
    call void st64(16, 0)
    call void st64(24, 1)
    call void bar_paint()
    call void cursor_update()
    ret
}

fn clear_text() -> void {
  entry():
    call void fill_rows(1, 24, 7)
    call void st64(16, 0)
    call void st64(24, 1)
    call void cursor_update()
    ret
}

; ---- physical memory ---------------------------------------------

fn rd32(i64) -> i64 {
  entry(a: i64):
    %p = bitcast ptr a
    %v = load i32, %p
    %r = zext i64 %v
    ret %r
}

fn rd64(i64) -> i64 {
  entry(a: i64):
    %p = bitcast ptr a
    %v = load i64, %p
    ret %v
}

fn bm_ptr(i64) -> ptr {
  entry(f: i64):
    %w = lshr i64 f, 6
    %b = call ptr ksf(4096)
    %p = gep i64 %b, %w
    ret %p
}

fn bm_test(i64) -> i64 {
  entry(f: i64):
    %p = call ptr bm_ptr(f)
    %w = load i64, %p
    %bit = and i64 f, 63
    %m = shl i64 1, %bit
    %t = and i64 %w, %m
    %r = icmp.ne i64 %t, 0
    %rv = zext i64 %r
    ret %rv
}

fn bm_set(i64) -> void {
  entry(f: i64):
    %p = call ptr bm_ptr(f)
    %w = load i64, %p
    %bit = and i64 f, 63
    %m = shl i64 1, %bit
    %w2 = or i64 %w, %m
    store i64 %p, %w2
    ret
}

fn bm_clear(i64) -> void {
  entry(f: i64):
    %p = call ptr bm_ptr(f)
    %w = load i64, %p
    %bit = and i64 f, 63
    %m = shl i64 1, %bit
    %nm = xor i64 %m, -1
    %w2 = and i64 %w, %nm
    store i64 %p, %w2
    ret
}

fn set_range(i64, i64) -> void {
  entry(f0: i64, f1: i64):
    br loop(f0, f1)
  loop(f: i64, f1: i64):
    %done = icmp.sge i64 f, f1
    condbr %done, fin(), body(f, f1)
  body(f: i64, f1: i64):
    call void bm_set(f)
    %f2 = add i64 f, 1
    br loop(%f2, f1)
  fin():
    ret
}

fn clear_range(i64, i64) -> void {
  entry(f0: i64, f1: i64):
    %tot = call i64 ld64(480)
    %c1 = icmp.sle i64 f1, %tot
    %e1 = select i64 %c1, f1, %tot
    %c0 = icmp.sle i64 f0, %e1
    %s0 = select i64 %c0, f0, %e1
    br loop(%s0, %e1)
  loop(f: i64, f1: i64):
    %done = icmp.sge i64 f, f1
    condbr %done, fin(), body(f, f1)
  body(f: i64, f1: i64):
    call void bm_clear(f)
    %f2 = add i64 f, 1
    br loop(%f2, f1)
  fin():
    ret
}

fn count_free() -> i64 {
  entry():
    %tot = call i64 ld64(480)
    br loop(0, %tot, 0)
  loop(f: i64, tot: i64, acc: i64):
    %done = icmp.sge i64 f, tot
    condbr %done, fin(acc), body(f, tot, acc)
  body(f: i64, tot: i64, acc: i64):
    %u = call i64 bm_test(f)
    %free = xor i64 %u, 1
    %acc2 = add i64 acc, %free
    %f2 = add i64 f, 1
    br loop(%f2, tot, %acc2)
  fin(acc: i64):
    ret acc
}

fn pmm_fillw(i64) -> void {
  entry(words: i64):
    br loop(0, words)
  loop(w: i64, words: i64):
    %done = icmp.sge i64 w, words
    condbr %done, fin(), body(w, words)
  body(w: i64, words: i64):
    %off = mul i64 w, 8
    %o2 = add i64 4096, %off
    %p = call ptr ksf(%o2)
    store i64 %p, -1
    %w2 = add i64 w, 1
    br loop(%w2, words)
  fin():
    ret
}

fn pmm_walk(i64, i64) -> void {
  entry(addr: i64, end: i64):
    br loop(addr, end)
  loop(addr: i64, end: i64):
    %done = icmp.sge i64 addr, end
    condbr %done, fin(), body(addr, end)
  body(addr: i64, end: i64):
    %a4 = add i64 addr, 4
    %base = call i64 rd64(%a4)
    %a12 = add i64 addr, 12
    %len = call i64 rd64(%a12)
    %a20 = add i64 addr, 20
    %ty = call i64 rd32(%a20)
    %size = call i64 rd32(addr)
    %ist = icmp.eq i64 %ty, 1
    condbr %ist, usable(addr, end, %base, %len, %size), skip(addr, end, %size)
  usable(addr: i64, end: i64, base: i64, len: i64, size: i64):
    %bend = add i64 base, len
    %f0raw = add i64 base, 4095
    %f0 = lshr i64 %f0raw, 12
    %f1 = lshr i64 %bend, 12
    call void clear_range(%f0, %f1)
    br skip(addr, end, size)
  skip(addr: i64, end: i64, size: i64):
    %step = add i64 size, 4
    %next = add i64 addr, %step
    br loop(%next, end)
  fin():
    ret
}

fn pmm_init(ptr) -> void {
  entry(mbi: ptr):
    %ma = bitcast i64 mbi
    %f4 = add i64 %ma, 4
    %lower = call i64 rd32(%f4)
    %f8 = add i64 %ma, 8
    %upper = call i64 rd32(%f8)
    %ramkb = add i64 %lower, %upper
    call void st64(496, %ramkb)
    %ab1 = add i64 1024, %upper
    %bytes = mul i64 %ab1, 1024
    %fr = lshr i64 %bytes, 12
    %over = icmp.sgt i64 %fr, 131072
    %frames = select i64 %over, 131072, %fr
    call void st64(480, %frames)
    call void zero_range(4096, 16384)
    %wraw = add i64 %frames, 63
    %words = lshr i64 %wraw, 6
    call void pmm_fillw(%words)
    %flags = call i64 rd32(%ma)
    %has = and i64 %flags, 64
    %ok = icmp.ne i64 %has, 0
    condbr %ok, walk(%ma), reserve()
  walk(ma: i64):
    %f44 = add i64 ma, 44
    %mlen = call i64 rd32(%f44)
    %f48 = add i64 ma, 48
    %maddr = call i64 rd32(%f48)
    %mend = add i64 %maddr, %mlen
    call void pmm_walk(%maddr, %mend)
    br reserve()
  reserve():
    call void set_range(0, 1536)
    call void st64(504, -1)
    %free = call i64 count_free()
    call void st64(488, %free)
    ret
}

fn pmm_alloc() -> i64 {
  entry():
    %e1 = iconst i64 1
    %tot = call i64 ld64(480)
    br loop(1536, %tot)
  loop(f: i64, tot: i64):
    %done = icmp.sge i64 f, tot
    condbr %done, none(), body(f, tot)
  body(f: i64, tot: i64):
    %u = call i64 bm_test(f)
    %isfree = icmp.eq i64 %u, 0
    condbr %isfree, take(f), next(f, tot)
  next(f: i64, tot: i64):
    %f2 = add i64 f, 1
    br loop(%f2, tot)
  take(f: i64):
    call void bm_set(f)
    %fr = call i64 ld64(488)
    %fr2 = sub i64 %fr, 1
    call void st64(488, %fr2)
    %addr = shl i64 f, 12
    ret %addr
  none():
    ret -1
}

fn pmm_free(i64) -> void {
  entry(addr: i64):
    %f = lshr i64 addr, 12
    %u = call i64 bm_test(%f)
    %was = icmp.eq i64 %u, 1
    condbr %was, go(%f), fin()
  go(f: i64):
    call void bm_clear(f)
    %fr = call i64 ld64(488)
    %fr2 = add i64 %fr, 1
    call void st64(488, %fr2)
    br fin()
  fin():
    ret
}

; ---- interrupts ---------------------------------------------------

fn idt_init() -> void {
  entry():
    %e2 = iconst i64 2
    %base = call i64 k_stub_base()
    %idt = call ptr ksf(32768)
    br loop(0, %base, %idt)
  loop(v: i64, base: i64, idt: ptr):
    %done = icmp.sge i64 v, 256
    condbr %done, fin(%base, idt), body(v, base, idt)
  body(v: i64, base: i64, idt: ptr):
    %lt = icmp.slt i64 v, 48
    %sel = select i64 %lt, v, 48
    %soff = mul i64 %sel, 16
    %stub = add i64 base, %soff
    %eoff = mul i64 v, 16
    %e = gep i8 idt, %eoff
    %lo = and i64 %stub, 65535
    %lo16 = trunc i16 %lo
    store i16 %e, %lo16
    %e2 = gep i8 idt, %eoff
    %e2b = gep i8 %e2, 2
    store i16 %e2b, 8
    %e4 = gep i8 idt, %eoff
    %e4b = gep i8 %e4, 4
    store i8 %e4b, 0
    %e5 = gep i8 idt, %eoff
    %e5b = gep i8 %e5, 5
    store i8 %e5b, 142
    %mid = lshr i64 %stub, 16
    %midv = and i64 %mid, 65535
    %mid16 = trunc i16 %midv
    %e6 = gep i8 idt, %eoff
    %e6b = gep i8 %e6, 6
    store i16 %e6b, %mid16
    %hi = lshr i64 %stub, 32
    %hi32 = trunc i32 %hi
    %e8 = gep i8 idt, %eoff
    %e8b = gep i8 %e8, 8
    store i32 %e8b, %hi32
    %e12 = gep i8 idt, %eoff
    %e12b = gep i8 %e12, 12
    store i32 %e12b, 0
    %v2 = add i64 v, 1
    br loop(%v2, base, idt)
  fin(base: i64, idt: ptr):
    %idtr = call ptr ksf(36864)
    store i16 %idtr, 4095
    %b2 = gep i8 %idtr, 2
    %ia = bitcast i64 idt
    store i64 %b2, %ia
    call void k_lidt(%idtr)
    ret
}

fn pic_init() -> void {
  entry():
    call void k_out8(0x20, 0x11)
    call void k_out8(0xa0, 0x11)
    call void k_out8(0x21, 0x20)
    call void k_out8(0xa1, 0x28)
    call void k_out8(0x21, 0x04)
    call void k_out8(0xa1, 0x02)
    call void k_out8(0x21, 0x01)
    call void k_out8(0xa1, 0x01)
    call void k_out8(0x21, 0xfc)
    call void k_out8(0xa1, 0xff)
    ret
}

fn pit_init() -> void {
  entry():
    call void k_out8(0x43, 0x36)
    call void k_out8(0x40, 0x9c)
    call void k_out8(0x40, 0x2e)
    ret
}

fn eoi(i64) -> void {
  entry(vec: i64):
    call void k_out8(0x20, 0x20)
    %hi = icmp.sge i64 vec, 40
    condbr %hi, slave(), fin()
  slave():
    call void k_out8(0xa0, 0x20)
    br fin()
  fin():
    ret
}

fn k_dispatch(i64) -> void {
  entry(vec: i64):
    %e1 = iconst i64 1
    %e48 = iconst i64 48
    %exc = icmp.slt i64 vec, 32
    condbr %exc, panic(vec), chk(vec)
  chk(vec: i64):
    %ist = icmp.eq i64 vec, 32
    condbr %ist, tick(), chk2(vec)
  chk2(vec: i64):
    %isk = icmp.eq i64 vec, 33
    condbr %isk, kbd(), other(vec)
  other(vec: i64):
    %isirq = icmp.slt i64 vec, 48
    condbr %isirq, irqother(vec), fin()
  irqother(vec: i64):
    call void eoi(vec)
    br fin()
  fin():
    ret
  tick():
    %t = call i64 ld64(0)
    %t2 = add i64 %t, 1
    call void st64(0, %t2)
    %r = srem i64 %t2, 100
    %sec = icmp.eq i64 %r, 0
    condbr %sec, secup(), teoi()
  secup():
    %s = call i64 ld64(8)
    %s2 = add i64 %s, 1
    call void st64(8, %s2)
    br teoi()
  teoi():
    call void eoi(32)
    ret
  kbd():
    %sc = call i32 k_in8(0x60)
    %v = zext i64 %sc
    %head = call i64 ld64(32)
    %h1 = add i64 %head, 1
    %next = and i64 %h1, 255
    %tail = call i64 ld64(40)
    %full = icmp.eq i64 %next, %tail
    condbr %full, keoi(), kstore(%v, %head, %next)
  kstore(v: i64, head: i64, next: i64):
    %off = add i64 48, head
    %p = call ptr ksf(%off)
    %b = trunc i8 v
    store i8 %p, %b
    call void st64(32, next)
    br keoi()
  keoi():
    call void eoi(33)
    ret
  panic(vec: i64):
    call void k_cli()
    %m = call ptr s_exc()
    call void con_write(%m)
    call void putu(vec)
    %h = call ptr s_halt()
    call void con_write(%h)
    call void con_putc(10)
    br ploop()
  ploop():
    call void k_hlt()
    br ploop()
}

; ---- tasks and the scheduler ----------------------------------------

fn task_init(i64, i64) -> void {
  entry(id: i64, period: i64):
    %io = mul i64 id, 48
    %b = add i64 512, %io
    call void st64(%b, period)
    %t = call i64 ld64(0)
    %nx = add i64 %t, period
    %b8 = add i64 %b, 8
    call void st64(%b8, %nx)
    %b16 = add i64 %b, 16
    call void st64(%b16, 0)
    %b24 = add i64 %b, 24
    call void st64(%b24, 0)
    ret
}

fn task_setup() -> void {
  entry():
    call void task_init(0, 0)
    call void task_init(1, 100)
    call void task_init(2, 7)
    call void task_init(3, 10)
    ret
}

fn clock_step() -> void {
  entry():
    call void bar_paint()
    ret
}

fn beat_step() -> void {
  entry():
    ret
}

fn spin_step() -> void {
  entry():
    %idx = call i64 ld64(600)
    %tab = call ptr s_spin()
    %p = gep i8 %tab, %idx
    %b = load i8, %p
    %ch = zext i64 %b
    call void cell_write(79, 0, %ch, 31)
    %i2 = add i64 %idx, 1
    %nx = and i64 %i2, 3
    call void st64(600, %nx)
    ret
}

fn task_due(i64) -> i64 {
  entry(id: i64):
    %io = mul i64 id, 48
    %b = add i64 512, %io
    %b8 = add i64 %b, 8
    %nx = call i64 ld64(%b8)
    %t = call i64 ld64(0)
    %due = icmp.sge i64 %t, %nx
    %r = zext i64 %due
    ret %r
}

fn task_run(i64) -> void {
  entry(id: i64):
    %io = mul i64 id, 48
    %b = add i64 512, %io
    %is1 = icmp.eq i64 id, 1
    condbr %is1, run1(%b), chk2(id, %b)
  chk2(id: i64, b: i64):
    %is2 = icmp.eq i64 id, 2
    condbr %is2, run2(%b), chk3(id, %b)
  chk3(id: i64, b: i64):
    %is3 = icmp.eq i64 id, 3
    condbr %is3, run3(%b), resched(%b)
  run1(b: i64):
    call void clock_step()
    br resched(b)
  run2(b: i64):
    call void beat_step()
    br resched(b)
  run3(b: i64):
    call void spin_step()
    br resched(b)
  resched(b: i64):
    %b16 = add i64 b, 16
    %w = call i64 ld64(%b16)
    %w2 = add i64 %w, 1
    call void st64(%b16, %w2)
    %b8 = add i64 b, 8
    %nx = call i64 ld64(%b8)
    %per = call i64 ld64(b)
    %cand = add i64 %nx, %per
    %t = call i64 ld64(0)
    %late = icmp.sle i64 %cand, %t
    %fix = add i64 %t, %per
    %fin = select i64 %late, %fix, %cand
    call void st64(%b8, %fin)
    ret
}

; ---- the shell ------------------------------------------------------

fn kbd_getc() -> i64 {
  entry():
    %head = call i64 ld64(32)
    %tail = call i64 ld64(40)
    %empty = icmp.eq i64 %head, %tail
    condbr %empty, none(), got(%tail)
  none():
    ret -1
  got(tail: i64):
    %off = add i64 48, tail
    %p = call ptr ksf(%off)
    %b = load i8, %p
    %v = zext i64 %b
    %t2 = add i64 tail, 1
    %nt = and i64 %t2, 255
    call void st64(40, %nt)
    ret %v
}

fn prompt() -> void {
  entry():
    %p = call ptr s_prompt()
    call void con_write(%p)
    ret
}

fn putn(ptr, i64) -> void {
  entry(p: ptr, n: i64):
    br loop(p, n, 0)
  loop(p: ptr, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(p, n, i)
  body(p: ptr, n: i64, i: i64):
    %a = gep i8 p, i
    %b = load i8, %a
    %v = zext i64 %b
    call void con_putc(%v)
    %i2 = add i64 i, 1
    br loop(p, n, %i2)
  fin():
    ret
}

fn match(ptr, i64, ptr) -> i64 {
  entry(lp: ptr, n: i64, cp: ptr):
    %e0 = iconst i64 0
    br loop(lp, n, cp, 0)
  loop(lp: ptr, n: i64, cp: ptr, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, tailck(cp, n), body(lp, n, cp, i)
  body(lp: ptr, n: i64, cp: ptr, i: i64):
    %a = gep i8 lp, i
    %x = load i8, %a
    %b2 = gep i8 cp, i
    %y = load i8, %b2
    %eq = icmp.eq i8 %x, %y
    condbr %eq, next(lp, n, cp, i), no()
  next(lp: ptr, n: i64, cp: ptr, i: i64):
    %i2 = add i64 i, 1
    br loop(lp, n, cp, %i2)
  tailck(cp: ptr, n: i64):
    %a = gep i8 cp, n
    %y = load i8, %a
    %z = icmp.eq i8 %y, 0
    %r = zext i64 %z
    ret %r
  no():
    ret 0
}

fn name_of(i64) -> ptr {
  entry(id: i64):
    %i0 = icmp.eq i64 id, 0
    condbr %i0, n0(), c1(id)
  c1(id: i64):
    %i1 = icmp.eq i64 id, 1
    condbr %i1, n1(), c2(id)
  c2(id: i64):
    %i2 = icmp.eq i64 id, 2
    condbr %i2, n2(), n3()
  n0():
    %p = call ptr s_t0()
    ret %p
  n1():
    %p = call ptr s_t1()
    ret %p
  n2():
    %p = call ptr s_t2()
    ret %p
  n3():
    %p = call ptr s_t3()
    ret %p
}

fn cmd_help() -> void {
  entry():
    %p = call ptr s_help()
    call void con_write(%p)
    ret
}

fn cmd_about() -> void {
  entry():
    %p = call ptr s_about()
    call void con_write(%p)
    ret
}

fn cmd_mem() -> void {
  entry():
    %a = call ptr s_mema()
    call void con_write(%a)
    %ram = call i64 ld64(496)
    call void putu(%ram)
    %b = call ptr s_memb()
    call void con_write(%b)
    %fr = call i64 ld64(488)
    call void putu(%fr)
    %c = call ptr s_memc()
    call void con_write(%c)
    %tot = call i64 ld64(480)
    call void putu(%tot)
    call void con_putc(10)
    ret
}

fn cmd_ticks() -> void {
  entry():
    %a = call ptr s_ticksa()
    call void con_write(%a)
    %t = call i64 ld64(0)
    call void putu(%t)
    %b = call ptr s_ticksb()
    call void con_write(%b)
    %s = call i64 ld64(8)
    call void putu(%s)
    call void con_putc(115)
    call void con_putc(10)
    ret
}

fn cmd_ps() -> void {
  entry():
    %h = call ptr s_pshdr()
    call void con_write(%h)
    br loop(0)
  loop(id: i64):
    %done = icmp.sge i64 id, 4
    condbr %done, fin(), body(id)
  body(id: i64):
    %nm = call ptr name_of(id)
    call void con_write(%nm)
    call void con_putc(32)
    %io = mul i64 id, 48
    %b = add i64 512, %io
    %b16 = add i64 %b, 16
    %w = call i64 ld64(%b16)
    call void putu(%w)
    call void con_putc(10)
    %i2 = add i64 id, 1
    br loop(%i2)
  fin():
    ret
}

fn cmd_alloc() -> void {
  entry():
    %f = call i64 pmm_alloc()
    %none = icmp.eq i64 %f, -1
    condbr %none, nof(), got(%f)
  nof():
    %m = call ptr s_allocnone()
    call void con_write(%m)
    ret
  got(f: i64):
    call void st64(504, f)
    %p = bitcast ptr f
    store i64 %p, 0x4b304b304b304b30
    %v = load i64, %p
    %a = call ptr s_alloca()
    call void con_write(%a)
    call void putu(f)
    %ok = icmp.eq i64 %v, 0x4b304b304b304b30
    condbr %ok, okm(), badm()
  okm():
    %m = call ptr s_allocb()
    call void con_write(%m)
    ret
  badm():
    %m = call ptr s_allocbad()
    call void con_write(%m)
    ret
}

fn cmd_free() -> void {
  entry():
    %f = call i64 ld64(504)
    %none = icmp.eq i64 %f, -1
    condbr %none, nof(), go(%f)
  nof():
    %m = call ptr s_freenone()
    call void con_write(%m)
    ret
  go(f: i64):
    call void pmm_free(f)
    call void st64(504, -1)
    %m = call ptr s_freeda()
    call void con_write(%m)
    call void putu(f)
    call void con_putc(10)
    ret
}

fn cmd_clear() -> void {
  entry():
    call void clear_text()
    ret
}

fn cmd_echo(ptr) -> void {
  entry(rest: ptr):
    call void con_write(rest)
    call void con_putc(10)
    ret
}

; K0 template part 3: the heap, Multiboot modules, and the
; Krell bytecode runner. Functions are written callee-first so
; the module also parses with the v1 release toolchain.

; ---- absolute memory access ------------------------------------

fn mload(i64) -> i64 {
  entry(a: i64):
    %p = bitcast ptr a
    %v = load i64, %p
    ret %v
}

fn mstore(i64, i64) -> void {
  entry(a: i64, v: i64):
    %p = bitcast ptr a
    store i64 %p, v
    ret
}

fn mload8(i64) -> i64 {
  entry(a: i64):
    %p = bitcast ptr a
    %b = load i8, %p
    %v = zext i64 %b
    ret %v
}

fn mstore8(i64, i64) -> void {
  entry(a: i64, v: i64):
    %p = bitcast ptr a
    %b = trunc i8 v
    store i8 %p, %b
    ret
}

fn mload32(i64) -> i64 {
  entry(a: i64):
    %p = bitcast ptr a
    %w = load i32, %p
    %v = zext i64 %w
    ret %v
}

fn mstore32(i64, i32) -> void {
  entry(a: i64, v: i32):
    %p = bitcast ptr a
    store i32 %p, v
    ret
}

; ---- the heap ---------------------------------------------------
; kmalloc/kfree over the PMM. heap_init takes 256 frames (1 MiB)
; from the PMM; the bitmap scan hands out consecutive frames and
; heap_init verifies the run is contiguous. A block header is 16
; bytes: +0 size in bytes (header included; bit 0 set = in use,
; sizes are multiples of 16 so the bit is spare), +8 next free
; block address (free blocks only). Payloads are 16-aligned.
; First fit with splitting; kfree coalesces against the list.
; State (arena): 0xB000 free list head (address, 0 = none)
;   0xB008 region base   0xB010 region end
;   0xB018 live allocations   0xB020 free bytes (block sizes)

fn heap_init() -> void {
  entry():
    %e1 = iconst i64 1
    %e16 = iconst i64 16
    %d56 = iconst i64 45056
    %d88 = iconst i64 45088
    br get(0, 0, -1)
  get(i: i64, base: i64, prev: i64):
    %done = icmp.sge i64 i, 256
    condbr %done, build(base), body(i, base, prev)
  body(i: i64, base: i64, prev: i64):
    %a = call i64 pmm_alloc()
    %bad = icmp.eq i64 %a, -1
    condbr %bad, fail(), chk(i, base, prev, %a)
  chk(i: i64, base: i64, prev: i64, a: i64):
    %first = icmp.eq i64 i, 0
    condbr %first, setb(i, a), cont(i, base, prev, a)
  setb(i: i64, a: i64):
    br next(i, a, a)
  cont(i: i64, base: i64, prev: i64, a: i64):
    %want = add i64 prev, 4096
    %ok = icmp.eq i64 a, %want
    condbr %ok, next(i, base, a), fail()
  next(i: i64, base: i64, prev: i64):
    %i2 = add i64 i, 1
    br get(%i2, base, prev)
  build(base: i64):
    %end = add i64 base, 1048576
    call void st64(45064, base)
    %eh = add i64 base, 16
    call void st64(45072, %end)
    call void st64(45056, base)
    call void st64(45080, 0)
    call void st64(45088, 1048576)
    call void mstore(base, 1048576)
    %nb = add i64 base, 8
    call void mstore(%nb, 0)
    ret
  fail():
    call void st64(45056, 0)
    call void st64(45088, 0)
    ret
}

fn kmalloc(i64) -> i64 {
  entry(n: i64):
    %e1 = iconst i64 1
    %d8 = iconst i64 8
    %small = icmp.slt i64 n, 16
    %want = select i64 %small, 16, n
    %w15 = add i64 %want, 15
    %wmask = and i64 %w15, -16
    %need = add i64 %wmask, 16
    %head = call i64 ld64(45056)
    %none = icmp.eq i64 %head, 0
    condbr %none, oom(), walk(0, %head, %need)
  walk(prev: i64, blk: i64, need: i64):
    %no = icmp.eq i64 blk, 0
    condbr %no, oom(), chk(prev, blk, need)
  chk(prev: i64, blk: i64, need: i64):
    %sz = call i64 mload(blk)
    %fits = icmp.sge i64 %sz, need
    condbr %fits, take(prev, blk, need, %sz), adv(prev, blk, need)
  adv(prev: i64, blk: i64, need: i64):
    %nb = add i64 blk, 8
    %nx = call i64 mload(%nb)
    br walk(blk, %nx, need)
  take(prev: i64, blk: i64, need: i64, sz: i64):
    %rem = sub i64 sz, need
    %split = icmp.sge i64 %rem, 32
    condbr %split, dosplit(prev, blk, need, %rem), whole(prev, blk, sz)
  dosplit(prev: i64, blk: i64, need: i64, rem: i64):
    %nb = add i64 blk, 8
    %oldnx = call i64 mload(%nb)
    %rb = add i64 blk, need
    call void mstore(%rb, %rem)
    %rn = add i64 %rb, 8
    call void mstore(%rn, %oldnx)
    br link(prev, blk, need, %rb)
  whole(prev: i64, blk: i64, sz: i64):
    %nb = add i64 blk, 8
    %oldnx = call i64 mload(%nb)
    br link(prev, blk, sz, %oldnx)
  link(prev: i64, blk: i64, usedsz: i64, newnext: i64):
    %noprev = icmp.eq i64 prev, 0
    condbr %noprev, sethead(newnext), setprev(prev, newnext)
  sethead(newnext: i64):
    call void st64(45056, newnext)
    br mark(blk, usedsz)
  setprev(prev: i64, newnext: i64):
    %pn = add i64 prev, 8
    call void mstore(%pn, newnext)
    br mark(blk, usedsz)
  mark(blk: i64, usedsz: i64):
    %mu = or i64 usedsz, 1
    call void mstore(blk, %mu)
    %lv = call i64 ld64(45080)
    %lv2 = add i64 %lv, 1
    call void st64(45080, %lv2)
    %fb = call i64 ld64(45088)
    %fb2 = sub i64 %fb, usedsz
    call void st64(45088, %fb2)
    %pay = add i64 blk, 16
    ret %pay
  oom():
    ret 0
}

fn kfree(i64) -> void {
  entry(p: i64):
    %e1 = iconst i64 1
    %no = icmp.eq i64 p, 0
    condbr %no, fin(), go(p)
  go(p: i64):
    %blk = sub i64 p, 16
    %mu = call i64 mload(%blk)
    %used = and i64 %mu, 1
    %was = icmp.eq i64 %used, 1
    condbr %was, rel(%blk, %mu), fin()
  rel(blk: i64, mu: i64):
    %sz = and i64 mu, -2
    call void mstore(blk, %sz)
    %head = call i64 ld64(45056)
    %nb = add i64 blk, 8
    call void mstore(%nb, %head)
    call void st64(45056, blk)
    %lv = call i64 ld64(45080)
    %lv2 = sub i64 %lv, 1
    call void st64(45080, %lv2)
    %fb = call i64 ld64(45088)
    %fb2 = add i64 %fb, %sz
    call void st64(45088, %fb2)
    call void heap_coal()
    br fin()
  fin():
    ret
}

; one coalescing sweep: merge every free block with a free block
; that starts exactly where it ends; repeat until stable
fn heap_coal() -> void {
  entry():
    br outer()
  outer():
    %ch = call i64 heap_coal_pass()
    %again = icmp.ne i64 %ch, 0
    condbr %again, outer(), fin()
  fin():
    ret
}

fn heap_coal_pass() -> i64 {
  entry():
    %e1 = iconst i64 1
    %d8 = iconst i64 8
    %head = call i64 ld64(45056)
    br scan(0, %head)
  scan(prev: i64, x: i64):
    %no = icmp.eq i64 x, 0
    condbr %no, done(), inner(prev, x, x)
  inner(prev: i64, x: i64, y: i64):
    %yb = add i64 y, 8
    %yn = call i64 mload(%yb)
    %no = icmp.eq i64 %yn, 0
    condbr %no, adv(prev, x), chk(prev, x, y, %yn)
  chk(prev: i64, x: i64, y: i64, yn: i64):
    %xsz = call i64 mload(x)
    %xend = add i64 x, %xsz
    %hit = icmp.eq i64 %xend, yn
    condbr %hit, absorb(prev, x, y, yn), inner(prev, x, yn)
  absorb(prev: i64, x: i64, y: i64, yn: i64):
    %xsz = call i64 mload(x)
    %ysz = call i64 mload(yn)
    %tot = add i64 %xsz, %ysz
    call void mstore(x, %tot)
    %ynb = add i64 yn, 8
    %ynn = call i64 mload(%ynb)
    %xb = add i64 x, 8
    %cur = call i64 mload(%xb)
    %isy = icmp.eq i64 %cur, yn
    condbr %isy, fixx(x, %ynn), fixy(y, %ynn)
  fixx(x: i64, ynn: i64):
    %xb = add i64 x, 8
    call void mstore(%xb, ynn)
    ret 1
  fixy(y: i64, ynn: i64):
    %yb = add i64 y, 8
    call void mstore(%yb, ynn)
    ret 1
  adv(prev: i64, x: i64):
    %xb = add i64 x, 8
    %xn = call i64 mload(%xb)
    br scan(x, %xn)
  done():
    ret 0
}

fn heap_largest() -> i64 {
  entry():
    %head = call i64 ld64(45056)
    br walk(%head, 0)
  walk(blk: i64, best: i64):
    %no = icmp.eq i64 blk, 0
    condbr %no, done(best), body(blk, best)
  body(blk: i64, best: i64):
    %sz = call i64 mload(blk)
    %big = icmp.sgt i64 %sz, best
    %nb2 = select i64 %big, %sz, best
    %nb = add i64 blk, 8
    %nx = call i64 mload(%nb)
    br walk(%nx, %nb2)
  done(best: i64):
    ret best
}

; ---- heap shell commands -----------------------------------------

fn cmd_heap() -> void {
  entry():
    %a = call ptr s_heapa()
    call void con_write(%a)
    %base = call i64 ld64(45064)
    call void putu(%base)
    %b = call ptr s_heapb()
    call void con_write(%b)
    %fb = call i64 ld64(45088)
    call void putu(%fb)
    %c = call ptr s_heapc()
    call void con_write(%c)
    %lv = call i64 ld64(45080)
    call void putu(%lv)
    %d = call ptr s_heapd()
    call void con_write(%d)
    %lg = call i64 heap_largest()
    call void putu(%lg)
    call void con_putc(10)
    ret
}

fn hfill(i64, i64, i64) -> void {
  entry(p: i64, n: i64, pat: i64):
    br loop(p, n, pat, 0)
  loop(p: i64, n: i64, pat: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(p, n, pat, i)
  body(p: i64, n: i64, pat: i64, i: i64):
    %a = add i64 p, i
    call void mstore8(%a, pat)
    %i2 = add i64 i, 1
    br loop(p, n, pat, %i2)
  fin():
    ret
}

fn hcheck(i64, i64, i64) -> i64 {
  entry(p: i64, n: i64, pat: i64):
    %d1 = iconst i64 1
    br loop(p, n, pat, 0)
  loop(p: i64, n: i64, pat: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, ok(), body(p, n, pat, i)
  body(p: i64, n: i64, pat: i64, i: i64):
    %a = add i64 p, i
    %v = call i64 mload8(%a)
    %eq = icmp.eq i64 %v, pat
    condbr %eq, next(p, n, pat, i), bad()
  next(p: i64, n: i64, pat: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(p, n, pat, %i2)
  ok():
    ret 1
  bad():
    ret 0
}

fn cmd_htest() -> void {
  entry():
    %e1 = iconst i64 1
    %d10 = iconst i64 10
    %a = call i64 kmalloc(100)
    %b = call i64 kmalloc(5000)
    %c = call i64 kmalloc(64)
    call void hfill(%a, 100, 161)
    call void hfill(%b, 5000, 162)
    call void hfill(%c, 64, 163)
    %k1 = call i64 hcheck(%a, 100, 161)
    %k2 = call i64 hcheck(%b, 5000, 162)
    %k3 = call i64 hcheck(%c, 64, 163)
    %s1 = add i64 %k1, %k2
    %sum = add i64 %s1, %k3
    %okp = icmp.eq i64 %sum, 3
    condbr %okp, p1(%a, %b, %c), f1(%a, %b, %c)
  p1(a: i64, b: i64, c: i64):
    %m = call ptr s_htp1()
    call void con_write(%m)
    call void con_putc(10)
    br s2(a, b, c)
  f1(a: i64, b: i64, c: i64):
    %m = call ptr s_htf()
    call void con_write(%m)
    call void con_putc(10)
    br s2(a, b, c)
  s2(a: i64, b: i64, c: i64):
    call void kfree(b)
    %d = call i64 kmalloc(4000)
    call void hfill(%d, 4000, 164)
    %k4 = call i64 hcheck(%d, 4000, 164)
    %k5 = call i64 hcheck(a, 100, 161)
    %s3 = add i64 %k4, %k5
    %ok2 = icmp.eq i64 %s3, 2
    condbr %ok2, p2(a, c, %d), f2(a, c, %d)
  p2(a: i64, c: i64, d: i64):
    %m = call ptr s_htp2()
    call void con_write(%m)
    call void con_putc(10)
    br s3(a, c, d)
  f2(a: i64, c: i64, d: i64):
    %m = call ptr s_htf()
    call void con_write(%m)
    call void con_putc(10)
    br s3(a, c, d)
  s3(a: i64, c: i64, d: i64):
    call void kfree(a)
    call void kfree(c)
    call void kfree(d)
    %big = call i64 kmalloc(900000)
    %got = icmp.ne i64 %big, 0
    condbr %got, p3(%big), f3()
  p3(big: i64):
    call void hfill(%big, 900000, 165)
    %k6 = call i64 hcheck(%big, 900000, 165)
    call void kfree(%big)
    %ok3 = icmp.eq i64 %k6, 1
    condbr %ok3, p4(), f3()
  p4():
    %lv = call i64 ld64(45080)
    %fb = call i64 ld64(45088)
    %okl = icmp.eq i64 %lv, 0
    %okf = icmp.eq i64 %fb, 1048576
    %oklz = zext i64 %okl
    %okfz = zext i64 %okf
    %both = and i64 %oklz, %okfz
    %isok = icmp.ne i64 %both, 0
    condbr %isok, pass(), f3()
  pass():
    %m = call ptr s_htp3()
    call void con_write(%m)
    call void con_putc(10)
    ret
  f3():
    %m = call ptr s_htf()
    call void con_write(%m)
    call void con_putc(10)
    ret
}

; ---- Multiboot modules (the ramdisk) -----------------------------
; State (arena): 0xB100 module count; the table at 0xB108 holds
; 8 records of 32 bytes: +0 start address, +8 size, +16 address
; of the loader-supplied name string. Module frames are marked
; used in the PMM so the heap and the frame allocator never
; hand them out.

fn mods_init(ptr) -> void {
  entry(mbi: ptr):
    %e1 = iconst i64 1
    %e45376 = iconst i64 45376
    %mb = bitcast i64 mbi
    %fl = call i64 mload32(%mb)
    %has = and i64 %fl, 8
    %no = icmp.eq i64 %has, 0
    condbr %no, none(), go(%mb)
  none():
    call void st64(45376, 0)
    ret
  go(mb: i64):
    %ca = add i64 mb, 20
    %cnt = call i64 mload32(%ca)
    %aa = add i64 mb, 24
    %addr = call i64 mload32(%aa)
    %big = icmp.sgt i64 %cnt, 8
    %cap = select i64 %big, 8, %cnt
    call void st64(45376, %cap)
    br loop(0, %cap, %addr)
  loop(i: i64, cnt: i64, addr: i64):
    %done = icmp.sge i64 i, cnt
    condbr %done, fin(), body(i, cnt, addr)
  body(i: i64, cnt: i64, addr: i64):
    %rec = mul i64 i, 16
    %rp = add i64 addr, %rec
    %start = call i64 mload32(%rp)
    %ep = add i64 %rp, 4
    %end = call i64 mload32(%ep)
    %sp = add i64 %rp, 8
    %str = call i64 mload32(%sp)
    %toff = mul i64 i, 32
    %tp = add i64 45384, %toff
    call void mstore(%tp, %start)
    %size = sub i64 %end, %start
    %tp8 = add i64 %tp, 8
    call void mstore(%tp8, %size)
    %tp16 = add i64 %tp, 16
    call void mstore(%tp16, %str)
    %f0 = lshr i64 %start, 12
    %em1 = sub i64 %end, 1
    %f1a = lshr i64 %em1, 12
    %f1 = add i64 %f1a, 1
    call void set_range(%f0, %f1)
    %i2 = add i64 i, 1
    br loop(%i2, cnt, addr)
  fin():
    %nf = call i64 count_free()
    call void st64(488, %nf)
    ret
}

fn cmd_mods() -> void {
  entry():
    %a = call ptr s_modsa()
    call void con_write(%a)
    %n = call i64 ld64(45376)
    call void putu(%n)
    call void con_putc(10)
    br loop(0, %n)
  loop(i: i64, n: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(i, n)
  body(i: i64, n: i64):
    call void putu(i)
    call void con_putc(32)
    %toff = mul i64 i, 32
    %tp = add i64 45384, %toff
    %sp = add i64 %tp, 16
    %str = call i64 mload(%sp)
    %np = bitcast ptr %str
    call void con_write(%np)
    call void con_putc(32)
    %szp = add i64 %tp, 8
    %sz = call i64 mload(%szp)
    call void putu(%sz)
    %b = call ptr s_modsb()
    call void con_write(%b)
    %sta = call i64 mload(%tp)
    call void putu(%sta)
    call void con_putc(10)
    %i2 = add i64 i, 1
    br loop(%i2, n)
  fin():
    ret
}

; ---- the module runner -------------------------------------------
; K0 runs Krell modules: the canonical KREL binary format,
; decoded and interpreted here, in Krell. A module instance gets
; two heap regions: A (decoded tables, call frames, values) and
; B (the module byte space, 256 KiB: data blobs, then a bump
; heap). Pointers inside a module are offsets into B. Supported:
; the scalar instruction set (integer, float, memory, control,
; calls). Vector and atomic instructions fault at load. One
; deviation: module fma is evaluated as fmul then fadd (the
; kernel links without libm, so no fused fma is available).
; Host services, matched by extern name:
;   kprint(ptr)  print a NUL-terminated string from B
;   kputn(i64)   print a decimal integer
;   kputc(i64)   print one character
;   kticks()     the kernel tick counter
;   kalloc(i64)  bump-allocate in B (reclaimed whole at exit)
;   kfree(i64)   no operation (see kalloc)
; Runner state (arena, decimal offsets used in the code):
;   45824 A base   45832 B base   45840 steps   45848 status
;   (0 run, 1 done, 2 fault)   45856 exit/fault code
;   45864 frame top (offset in A)   45872 values bump (offset in A)
;   45880 B bump offset   45888 module base (host address)
;   45896 decode cursor   45904 decode end
;   45912 name offset   45920 name length
;   45928 type kind   45936 type bits   45944 current record
;   cursors at 45952: +0 func +8 block +16 instr +24 pool
;     +32 value types +40 blob +48 extern +56 data
;   46016 current func   46024 current func value-types offset
;   46032 current max value id   46040 pass flag
;   46080 argument scratch (16 i64)
; A header (offsets in A): 0 nfuncs 8 nblocks 16 ninstrs
;   24 pool size 32 nexterns 40 ndata 48 blob bytes 56 value slots
;   64 main index 72 B data end 80 frames offset 88 values offset
;   104 blocks offset 112 instrs offset 120 pool offset
;   128 value-types offset 136 externs offset 144 data offset
;   152 A size
; Records: func 64 B (+0 name off, +8 name len, +16 ret kind,
;   +24 ret bits, +32 first block, +40 block count, +48 values,
;   +56 value-types offset); block 48 B (+0 func, +8 arg count,
;   +16 arg pool index, +24 first instr, +32 instr count);
;   instr 144 B (+0 op, +8 result, +16 type kind, +24 type bits,
;   +32 a, +40 b, +48 c, +56 imm, +64 pred, +72 block, +80 block2,
;   +88 callee, +96 callee extern, +104 arg count, +112 args pool
;   index, +120 arg2 count, +128 args2 pool index, +136 GEP elem
;   bytes); extern 32 B (+0 name off, +8 name len, +16 host id,
;   +24 params); data 16 B (+0 B offset, +8 length);
;   value type 16 B (+0 kind, +8 bits); frame 56 B (+0 func,
;   +8 block, +16 pc, +24 values base, +32 return slot,
;   +40 return block, +48 return pc)

fn rd8() -> i64 {
  entry():
    %p = call i64 ld64(45896)
    %v = call i64 mload8(%p)
    %p2 = add i64 %p, 1
    call void st64(45896, %p2)
    ret %v
}

fn ruleb() -> i64 {
  entry():
    br loop(0, 0)
  loop(v: i64, sh: i64):
    %x = call i64 rd8()
    %lo = and i64 %x, 127
    %part = shl i64 %lo, %sh
    %v2 = or i64 v, %part
    %cont = and i64 %x, 128
    %more = icmp.ne i64 %cont, 0
    %sh2 = add i64 %sh, 7
    condbr %more, loop(%v2, %sh2), fin(%v2)
  fin(v: i64):
    ret v
}

fn rsleb() -> i64 {
  entry():
    br loop(0, 0, 0)
  loop(v: i64, sh: i64, last: i64):
    %x = call i64 rd8()
    %lo = and i64 %x, 127
    %part = shl i64 %lo, %sh
    %v2 = or i64 v, %part
    %cont = and i64 %x, 128
    %more = icmp.ne i64 %cont, 0
    %sh2 = add i64 %sh, 7
    condbr %more, loop(%v2, %sh2, %x), fin(%v2, %sh2, %x)
  fin(v: i64, sh: i64, last: i64):
    %sign = and i64 last, 64
    %is = icmp.ne i64 %sign, 0
    condbr %is, neg(v, %sh), pos(v)
  neg(v: i64, sh: i64):
    %top = shl i64 -1, %sh
    %r = or i64 v, %top
    ret %r
  pos(v: i64):
    ret v
}

fn rval() -> i64 {
  entry():
    %v = call i64 ruleb()
    %r = sub i64 %v, 1
    ret %r
}

; reads a type; kind lands at 45928, bits at 45936
fn rdtype() -> void {
  entry():
    %e45936 = iconst i64 45936
    %e0 = iconst i64 0
    %k = call i64 rd8()
    call void st64(45928, %k)
    %is1 = icmp.eq i64 %k, 1
    condbr %is1, bits(), chkf(%k)
  bits():
    %b = call i64 rd8()
    call void st64(45936, %b)
    ret
  chkf(k: i64):
    %is2 = icmp.eq i64 k, 2
    condbr %is2, bits(), chkv(k)
  chkv(k: i64):
    %is4 = icmp.eq i64 k, 4
    condbr %is4, vec(), done()
  vec():
    %e1 = call i64 rd8()
    %e2 = call i64 rd8()
    %e3 = call i64 rd8()
    call void st64(45936, 0)
    ret
  done():
    call void st64(45936, 0)
    ret
}

; byte size of the type in the type globals
fn rdtsz() -> i64 {
  entry():
    %e8 = iconst i64 8
    %k = call i64 ld64(45928)
    %b = call i64 ld64(45936)
    %is3 = icmp.eq i64 %k, 3
    condbr %is3, eight(), num(%k, %b)
  eight():
    ret 8
  num(k: i64, b: i64):
    %is0 = icmp.eq i64 k, 0
    condbr %is0, zero(), sz(b)
  zero():
    ret 0
  sz(b: i64):
    %q = sdiv i64 b, 8
    %lt = icmp.slt i64 %q, 1
    %r = select i64 %lt, 1, %q
    ret %r
}

; reads a name; module-relative offset at 45912, length at 45920
fn rdname() -> void {
  entry():
    %n = call i64 ruleb()
    %p = call i64 ld64(45896)
    %base = call i64 ld64(45888)
    %off = sub i64 %p, %base
    call void st64(45912, %off)
    call void st64(45920, %n)
    %p2 = add i64 %p, %n
    call void st64(45896, %p2)
    ret
}

; compare the module name at (off, len) with a kernel string
fn name_eq(i64, i64, ptr) -> i64 {
  entry(off: i64, len: i64, kp: ptr):
    %mb = call i64 ld64(45888)
    br loop(off, len, kp, %mb, 0)
  loop(off: i64, len: i64, kp: ptr, mb: i64, i: i64):
    %done = icmp.sge i64 i, len
    condbr %done, tail(kp, len), body(off, len, kp, mb, i)
  tail(kp: ptr, len: i64):
    %p = gep i8 kp, len
    %b = load i8, %p
    %z = icmp.eq i8 %b, 0
    %r = zext i64 %z
    ret %r
  body(off: i64, len: i64, kp: ptr, mb: i64, i: i64):
    %a = add i64 mb, off
    %a2 = add i64 %a, i
    %x = call i64 mload8(%a2)
    %p = gep i8 kp, i
    %y8 = load i8, %p
    %y = zext i64 %y8
    %eq = icmp.eq i64 %x, %y
    condbr %eq, next(off, len, kp, mb, i), no()
  next(off: i64, len: i64, kp: ptr, mb: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(off, len, kp, mb, %i2)
  no():
    ret 0
}

; resolve an extern name to a host service id (0 = unknown)
fn host_id(i64, i64) -> i64 {
  entry(off: i64, len: i64):
    %k = call ptr s_hk1()
    %e = call i64 name_eq(off, len, %k)
    %y = icmp.ne i64 %e, 0
    condbr %y, r1(), n2(off, len)
  r1():
    ret 1
  n2(off: i64, len: i64):
    %k = call ptr s_hk2()
    %e = call i64 name_eq(off, len, %k)
    %y = icmp.ne i64 %e, 0
    condbr %y, r2(), n3(off, len)
  r2():
    ret 2
  n3(off: i64, len: i64):
    %k = call ptr s_hk3()
    %e = call i64 name_eq(off, len, %k)
    %y = icmp.ne i64 %e, 0
    condbr %y, r3(), n4(off, len)
  r3():
    ret 3
  n4(off: i64, len: i64):
    %k = call ptr s_hk4()
    %e = call i64 name_eq(off, len, %k)
    %y = icmp.ne i64 %e, 0
    condbr %y, r4(), n5(off, len)
  r4():
    ret 4
  n5(off: i64, len: i64):
    %k = call ptr s_hk5()
    %e = call i64 name_eq(off, len, %k)
    %y = icmp.ne i64 %e, 0
    condbr %y, r5(), n6(off, len)
  r5():
    ret 5
  n6(off: i64, len: i64):
    %k = call ptr s_hk6()
    %e = call i64 name_eq(off, len, %k)
    %y = icmp.ne i64 %e, 0
    condbr %y, r6(), r0()
  r6():
    ret 6
  r0():
    ret 0
}

; record the type in the type globals for value id v of the
; current function (pass 2 only)
fn set_vtype(i64) -> void {
  entry(v: i64):
    %lt = icmp.slt i64 v, 0
    condbr %lt, fin(), go(v)
  go(v: i64):
    %A = call i64 ld64(45824)
    %voa = add i64 %A, 128
    %vo = call i64 mload(%voa)
    %vto = call i64 ld64(46024)
    %idx = add i64 %vto, v
    %sh = shl i64 %idx, 4
    %base = add i64 %A, %vo
    %dst = add i64 %base, %sh
    %k = call i64 ld64(45928)
    call void mstore(%dst, %k)
    %d8 = add i64 %dst, 8
    %b = call i64 ld64(45936)
    call void mstore(%d8, %b)
    br fin()
  fin():
    ret
}

fn track_val(i64) -> void {
  entry(v: i64):
    %cur = call i64 ld64(46032)
    %gt = icmp.sgt i64 v, %cur
    condbr %gt, set(v), fin()
  set(v: i64):
    call void st64(46032, v)
    br fin()
  fin():
    ret
}

; ---- instruction decode -------------------------------------------
; Parsed fields land in the scratch record at arena 46160, using
; the record layout. Argument lists land in the scratch at 46080.
; Returns 0, or 3 for an unsupported op.

fn insc(i64, i64) -> void {
  entry(off: i64, v: i64):
    %a = add i64 46160, off
    call void mstore(%a, v)
    ret
}

fn ing(i64) -> i64 {
  entry(off: i64):
    %a = add i64 46160, off
    %v = call i64 mload(%a)
    ret %v
}

; copy n argument values from the scratch to the pool (pass 2),
; recording the pool index at the given scratch offset; the pool
; index the list starts at was saved at 46240 by rd_args
fn pool_args(i64, i64) -> void {
  entry(n: i64, recoff: i64):
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, go(n, recoff), fin()
  go(n: i64, recoff: i64):
    %cp = call i64 ld64(46240)
    call void insc(recoff, %cp)
    br loop(n, %cp, 0)
  loop(n: i64, cp: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(n, cp, i)
  body(n: i64, cp: i64, i: i64):
    %sh = shl i64 i, 3
    %sa = add i64 46080, %sh
    %v = call i64 mload(%sa)
    %A = call i64 ld64(45824)
    %poa = add i64 %A, 120
    %po = call i64 mload(%poa)
    %dst = add i64 %A, %po
    %ix = add i64 cp, i
    %ix8 = shl i64 %ix, 3
    %dst2 = add i64 %dst, %ix8
    call void mstore(%dst2, %v)
    %i2 = add i64 i, 1
    br loop(n, cp, %i2)
  fin():
    ret
}

; copy the scratch record into the instruction table (pass 2)
fn store_ins() -> void {
  entry():
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, go(), fin()
  go():
    %A = call i64 ld64(45824)
    %ioa = add i64 %A, 112
    %io = call i64 mload(%ioa)
    %ci = call i64 ld64(45968)
    %sh = shl i64 %ci, 7
    %sh2 = shl i64 %ci, 4
    %sh3 = add i64 %sh, %sh2
    %dst = add i64 %A, %io
    %dst2 = add i64 %dst, %sh3
    br loop(%dst2, 0)
  loop(dst: i64, i: i64):
    %done = icmp.sge i64 i, 18
    condbr %done, fin(), body(dst, i)
  body(dst: i64, i: i64):
    %sh = shl i64 i, 3
    %sa = add i64 46160, %sh
    %v = call i64 mload(%sa)
    %da = add i64 dst, %sh
    call void mstore(%da, %v)
    %i2 = add i64 i, 1
    br loop(dst, %i2)
  fin():
    ret
}

; count or store n argument values read from the stream
fn rd_args(i64, i64) -> void {
  entry(n: i64, recoff: i64):
    %cp = call i64 ld64(45976)
    call void st64(46240, %cp)
    br loop(n, recoff, 0)
  loop(n: i64, recoff: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(n, recoff), body(n, recoff, i)
  body(n: i64, recoff: i64, i: i64):
    %v = call i64 rval()
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, st(n, recoff, i, %v), cnt(n, recoff, i, %v)
  st(n: i64, recoff: i64, i: i64, v: i64):
    %sh = shl i64 i, 3
    %sa = add i64 46080, %sh
    call void mstore(%sa, v)
    br next(n, recoff, i, v)
  cnt(n: i64, recoff: i64, i: i64, v: i64):
    br next(n, recoff, i, v)
  next(n: i64, recoff: i64, i: i64, v: i64):
    call void track_val(v)
    %cp = call i64 ld64(45976)
    %cp2 = add i64 %cp, 1
    call void st64(45976, %cp2)
    %i2 = add i64 i, 1
    br loop(n, recoff, %i2)
  fin(n: i64, recoff: i64):
    call void pool_args(n, recoff)
    ret
}

fn rd_instr() -> i64 {
  entry():
    %d1 = iconst i64 1
    %d8 = iconst i64 8
    %d3 = iconst i64 3
    br zero(0)
  zero(i: i64):
    %done = icmp.sge i64 i, 18
    condbr %done, head(), zb(i)
  zb(i: i64):
    %sh = shl i64 i, 3
    %a = add i64 46160, %sh
    call void mstore(%a, 0)
    %i2 = add i64 i, 1
    br zero(%i2)
  head():
    %e56 = iconst i64 56
    %e72 = iconst i64 72
    %e104 = iconst i64 104
    %e112 = iconst i64 112
    %e32 = iconst i64 32
    %e40 = iconst i64 40
    %e48 = iconst i64 48
    %e64 = iconst i64 64
    %e80 = iconst i64 80
    %e88 = iconst i64 88
    %e96 = iconst i64 96
    %e120 = iconst i64 120
    %e128 = iconst i64 128
    %e136 = iconst i64 136
    %op = call i64 rd8()
    call void insc(0, %op)
    %res = call i64 rval()
    call void insc(8, %res)
    call void track_val(%res)
    call void rdtype()
    %k = call i64 ld64(45928)
    call void insc(16, %k)
    %b = call i64 ld64(45936)
    call void insc(24, %b)
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, svt(%res), disp(%op)
  svt(res: i64):
    call void set_vtype(res)
    br disp2()
  disp2():
    %op = call i64 ing(0)
    br disp(%op)
  disp(op: i64):
    %c1 = icmp.eq i64 op, 1
    condbr %c1, k_imm_s(), c2(op)
  k_imm_s():
    %v = call i64 rsleb()
    call void insc(56, %v)
    br fin()
  c2(op: i64):
    %c = icmp.eq i64 op, 2
    condbr %c, k_imm_u(), c3(op)
  k_imm_u():
    %v = call i64 ruleb()
    call void insc(56, %v)
    br fin()
  c3(op: i64):
    %c = icmp.eq i64 op, 68
    condbr %c, k_br(), c4(op)
  k_br():
    %t = call i64 ruleb()
    call void insc(72, %t)
    %n = call i64 ruleb()
    call void insc(104, %n)
    call void rd_args(%n, 112)
    br fin()
  c4(op: i64):
    %c = icmp.eq i64 op, 69
    condbr %c, k_cbr(), c5(op)
  k_cbr():
    %a = call i64 rval()
    call void insc(32, %a)
    call void track_val(%a)
    %t = call i64 ruleb()
    call void insc(72, %t)
    %n = call i64 ruleb()
    call void insc(104, %n)
    call void rd_args(%n, 112)
    %t2 = call i64 ruleb()
    call void insc(80, %t2)
    %n2 = call i64 ruleb()
    call void insc(120, %n2)
    call void rd_args(%n2, 128)
    br fin()
  c5(op: i64):
    %lo = icmp.sge i64 op, 71
    %hi = icmp.sle i64 op, 72
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, k_call(), c6(op)
  k_call():
    %ce = call i64 ruleb()
    call void insc(88, %ce)
    %cx = call i64 rd8()
    call void insc(96, %cx)
    %n = call i64 ruleb()
    call void insc(104, %n)
    call void rd_args(%n, 112)
    br fin()
  c6(op: i64):
    %c = icmp.eq i64 op, 70
    condbr %c, k_ret(), c7(op)
  k_ret():
    %a = call i64 rval()
    call void insc(32, %a)
    call void track_val(%a)
    br fin()
  c7(op: i64):
    %a1 = icmp.eq i64 op, 19
    %a2 = icmp.eq i64 op, 34
    %z1 = zext i64 %a1
    %z2 = zext i64 %a2
    %x = or i64 %z1, %z2
    %is = icmp.ne i64 %x, 0
    condbr %is, k_cmp(), c8(op)
  k_cmp():
    %pr = call i64 rd8()
    call void insc(64, %pr)
    %a = call i64 rval()
    call void insc(32, %a)
    call void track_val(%a)
    %b = call i64 rval()
    call void insc(40, %b)
    call void track_val(%b)
    br fin()
  c8(op: i64):
    %c = icmp.eq i64 op, 42
    condbr %c, k_alloca(), c9(op)
  k_alloca():
    %v = call i64 ruleb()
    call void insc(56, %v)
    %w = call i64 ruleb()
    call void insc(48, %w)
    br fin()
  c9(op: i64):
    %c = icmp.eq i64 op, 48
    condbr %c, k_dataptr(), c10(op)
  k_dataptr():
    %v = call i64 ruleb()
    call void insc(56, %v)
    br fin()
  c10(op: i64):
    %c = icmp.eq i64 op, 45
    condbr %c, k_gep(), c11(op)
  k_gep():
    %a = call i64 rval()
    call void insc(32, %a)
    call void track_val(%a)
    %b = call i64 rval()
    call void insc(40, %b)
    call void track_val(%b)
    call void rdtype()
    %sz = call i64 rdtsz()
    call void insc(136, %sz)
    br fin()
  c11(op: i64):
    %lo = icmp.sge i64 op, 49
    %hi = icmp.sle i64 op, 64
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, k_vec(op), c12(op)
  k_vec(op: i64):
    %a = call i64 rval()
    %is63 = icmp.eq i64 op, 63
    condbr %is63, vx(), v3()
  vx():
    %w = call i64 ruleb()
    ret 3
  v3():
    %b = call i64 rval()
    %w = call i64 rval()
    ret 3
  c12(op: i64):
    %lo = icmp.sge i64 op, 65
    %hi = icmp.sle i64 op, 67
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, k_atom(op), k_gen()
  k_atom(op: i64):
    %aux = call i64 rd8()
    %a = call i64 rval()
    %is65 = icmp.eq i64 op, 65
    condbr %is65, a1(), a2()
  a1():
    ret 3
  a2():
    %b = call i64 rval()
    ret 3
  k_gen():
    %a = call i64 rval()
    call void insc(32, %a)
    call void track_val(%a)
    %b = call i64 rval()
    call void insc(40, %b)
    call void track_val(%b)
    %w = call i64 rval()
    call void insc(48, %w)
    call void track_val(%w)
    br fin()
  fin():
    call void store_ins()
    %ci = call i64 ld64(45968)
    %ci2 = add i64 %ci, 1
    call void st64(45968, %ci2)
    ret 0
}

; ---- section walks --------------------------------------------------

fn walk_exts() -> void {
  entry():
    %e1 = iconst i64 1
    %e46000 = iconst i64 46000
    %n = call i64 ruleb()
    br loop(%n, 0)
  loop(n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(n, i)
  body(n: i64, i: i64):
    call void rdname()
    %off = call i64 ld64(45912)
    %len = call i64 ld64(45920)
    %np = call i64 ruleb()
    br ploop(n, i, %off, %len, %np, 0)
  ploop(n: i64, i: i64, off: i64, len: i64, np: i64, j: i64):
    %done = icmp.sge i64 j, np
    condbr %done, ret(n, i, off, len, np), pbody(n, i, off, len, np, j)
  pbody(n: i64, i: i64, off: i64, len: i64, np: i64, j: i64):
    call void rdtype()
    %j2 = add i64 j, 1
    br ploop(n, i, off, len, np, %j2)
  ret(n: i64, i: i64, off: i64, len: i64, np: i64):
    call void rdtype()
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, fill(n, i, off, len, np), next(n, i)
  fill(n: i64, i: i64, off: i64, len: i64, np: i64):
    %A = call i64 ld64(45824)
    %xoa = add i64 %A, 136
    %xo = call i64 mload(%xoa)
    %ce = call i64 ld64(46000)
    %sh = shl i64 %ce, 5
    %rec = add i64 %A, %xo
    %rec2 = add i64 %rec, %sh
    call void mstore(%rec2, off)
    %r8 = add i64 %rec2, 8
    call void mstore(%r8, len)
    %hid = call i64 host_id(off, len)
    %r16 = add i64 %rec2, 16
    call void mstore(%r16, %hid)
    %r24 = add i64 %rec2, 24
    call void mstore(%r24, np)
    br next(n, i)
  next(n: i64, i: i64):
    %ce = call i64 ld64(46000)
    %ce2 = add i64 %ce, 1
    call void st64(46000, %ce2)
    %i2 = add i64 i, 1
    br loop(n, %i2)
  fin():
    ret
}

fn copy_bytes(i64, i64, i64) -> void {
  entry(dst: i64, src: i64, n: i64):
    br loop(dst, src, n, 0)
  loop(dst: i64, src: i64, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(dst, src, n, i)
  body(dst: i64, src: i64, n: i64, i: i64):
    %sa = add i64 src, i
    %v = call i64 mload8(%sa)
    %da = add i64 dst, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br loop(dst, src, n, %i2)
  fin():
    ret
}

fn walk_data() -> void {
  entry():
    %e46008 = iconst i64 46008
    %e45896 = iconst i64 45896
    %e45992 = iconst i64 45992
    %e1 = iconst i64 1
    %n = call i64 ruleb()
    br loop(%n, 0)
  loop(n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(n, i)
  body(n: i64, i: i64):
    call void rdname()
    %al = call i64 ruleb()
    %len = call i64 ruleb()
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, fill(n, i, %len), skip(n, i, %len)
  fill(n: i64, i: i64, len: i64):
    %cur = call i64 ld64(45896)
    %B = call i64 ld64(45832)
    %cb = call i64 ld64(45992)
    %dst = add i64 %B, %cb
    call void copy_bytes(%dst, %cur, len)
    %A = call i64 ld64(45824)
    %doa = add i64 %A, 144
    %do = call i64 mload(%doa)
    %cd = call i64 ld64(46008)
    %sh = shl i64 %cd, 4
    %rec = add i64 %A, %do
    %rec2 = add i64 %rec, %sh
    call void mstore(%rec2, %cb)
    %r8 = add i64 %rec2, 8
    call void mstore(%r8, len)
    br skip(n, i, len)
  skip(n: i64, i: i64, len: i64):
    %cd = call i64 ld64(46008)
    %cd2 = add i64 %cd, 1
    call void st64(46008, %cd2)
    %cur = call i64 ld64(45896)
    %cur2 = add i64 %cur, len
    call void st64(45896, %cur2)
    %cb = call i64 ld64(45992)
    %a15 = add i64 len, 15
    %al16 = and i64 %a15, -16
    %cb2 = add i64 %cb, %al16
    call void st64(45992, %cb2)
    %i2 = add i64 i, 1
    br loop(n, %i2)
  fin():
    ret
}

fn walk_funcs() -> i64 {
  entry():
    %e45824 = iconst i64 45824
    %e45952 = iconst i64 45952
    %e45960 = iconst i64 45960
    %e45968 = iconst i64 45968
    %e45976 = iconst i64 45976
    %e45984 = iconst i64 45984
    %e1 = iconst i64 1
    %e46248 = iconst i64 46248
    %e46256 = iconst i64 46256
    %e16 = iconst i64 16
    %e8 = iconst i64 8
    %e24 = iconst i64 24
    %e32 = iconst i64 32
    %n = call i64 ruleb()
    br loop(%n, 0)
  loop(n: i64, f: i64):
    %done = icmp.sge i64 f, n
    condbr %done, ok(), body(n, f)
  body(n: i64, f: i64):
    call void rdname()
    %off = call i64 ld64(45912)
    %len = call i64 ld64(45920)
    call void st64(46208, %off)
    call void st64(46216, %len)
    %fl = call i64 rd8()
    call void rdtype()
    %rk = call i64 ld64(45928)
    %rb = call i64 ld64(45936)
    call void st64(46224, %rk)
    call void st64(46232, %rb)
    call void st64(46016, f)
    call void st64(46032, -1)
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, ffill(n, f), blocks(n, f)
  ffill(n: i64, f: i64):
    %A = call i64 ld64(45824)
    %cf = call i64 ld64(45952)
    %sh = shl i64 %cf, 6
    %rec = add i64 %A, 4096
    %rec2 = add i64 %rec, %sh
    call void st64(46256, %rec2)
    %off = call i64 ld64(46208)
    call void mstore(%rec2, %off)
    %len = call i64 ld64(46216)
    %r8 = add i64 %rec2, 8
    call void mstore(%r8, %len)
    %rk = call i64 ld64(46224)
    %r16 = add i64 %rec2, 16
    call void mstore(%r16, %rk)
    %rb = call i64 ld64(46232)
    %r24 = add i64 %rec2, 24
    call void mstore(%r24, %rb)
    %cb = call i64 ld64(45960)
    %r32 = add i64 %rec2, 32
    call void mstore(%r32, %cb)
    %vt = call i64 ld64(45984)
    call void st64(46024, %vt)
    %r56 = add i64 %rec2, 56
    call void mstore(%r56, %vt)
    %mn = call ptr s_hmain()
    %off2 = call i64 ld64(46208)
    %len2 = call i64 ld64(46216)
    %e = call i64 name_eq(%off2, %len2, %mn)
    %is = icmp.ne i64 %e, 0
    condbr %is, setmain(n, f), blocks(n, f)
  setmain(n: i64, f: i64):
    %A = call i64 ld64(45824)
    %ma = add i64 %A, 64
    call void mstore(%ma, f)
    br blocks(n, f)
  blocks(n: i64, f: i64):
    %nb = call i64 ruleb()
    br bloop(n, f, %nb, 0)
  bloop(n: i64, f: i64, nb: i64, b: i64):
    %done = icmp.sge i64 b, nb
    condbr %done, fdone(n, f, nb), bbody(n, f, nb, b)
  bbody(n: i64, f: i64, nb: i64, b: i64):
    %na = call i64 ruleb()
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, bfill(n, f, nb, b, %na), args(n, f, nb, b, %na, 0)
  bfill(n: i64, f: i64, nb: i64, b: i64, na: i64):
    %A = call i64 ld64(45824)
    %boa = add i64 %A, 104
    %bo = call i64 mload(%boa)
    %cb = call i64 ld64(45960)
    %sh = shl i64 %cb, 5
    %sh2 = shl i64 %cb, 4
    %sh3 = add i64 %sh, %sh2
    %rec = add i64 %A, %bo
    %rec2 = add i64 %rec, %sh3
    call void st64(46248, %rec2)
    call void mstore(%rec2, f)
    %r8 = add i64 %rec2, 8
    call void mstore(%r8, na)
    %cp = call i64 ld64(45976)
    %r16 = add i64 %rec2, 16
    call void mstore(%r16, %cp)
    %ci = call i64 ld64(45968)
    %r24 = add i64 %rec2, 24
    call void mstore(%r24, %ci)
    br args(n, f, nb, b, na, 0)
  args(n: i64, f: i64, nb: i64, b: i64, na: i64, k: i64):
    %done = icmp.sge i64 k, na
    condbr %done, instrs(n, f, nb, b), abody(n, f, nb, b, na, k)
  abody(n: i64, f: i64, nb: i64, b: i64, na: i64, k: i64):
    %vid = call i64 ruleb()
    call void rdtype()
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, ast(n, f, nb, b, na, k, %vid), anext(n, f, nb, b, na, k, %vid)
  ast(n: i64, f: i64, nb: i64, b: i64, na: i64, k: i64, vid: i64):
    %A = call i64 ld64(45824)
    %poa = add i64 %A, 120
    %po = call i64 mload(%poa)
    %cp = call i64 ld64(45976)
    %sh = shl i64 %cp, 3
    %dst = add i64 %A, %po
    %dst2 = add i64 %dst, %sh
    call void mstore(%dst2, vid)
    call void set_vtype(vid)
    br anext(n, f, nb, b, na, k, vid)
  anext(n: i64, f: i64, nb: i64, b: i64, na: i64, k: i64, vid: i64):
    call void track_val(vid)
    %cp = call i64 ld64(45976)
    %cp2 = add i64 %cp, 1
    call void st64(45976, %cp2)
    %k2 = add i64 k, 1
    br args(n, f, nb, b, na, %k2)
  instrs(n: i64, f: i64, nb: i64, b: i64):
    %ni = call i64 ruleb()
    br iloop(n, f, nb, b, %ni, 0)
  iloop(n: i64, f: i64, nb: i64, b: i64, ni: i64, j: i64):
    %done = icmp.sge i64 j, ni
    condbr %done, bdone(n, f, nb, b, ni), ibody(n, f, nb, b, ni, j)
  ibody(n: i64, f: i64, nb: i64, b: i64, ni: i64, j: i64):
    %fl = call i64 rd_instr()
    %bad = icmp.ne i64 %fl, 0
    condbr %bad, ffail(%fl), inext(n, f, nb, b, ni, j)
  inext(n: i64, f: i64, nb: i64, b: i64, ni: i64, j: i64):
    %j2 = add i64 j, 1
    br iloop(n, f, nb, b, ni, %j2)
  bdone(n: i64, f: i64, nb: i64, b: i64, ni: i64):
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, bstore(n, f, nb, b, ni), bnext(n, f, nb, b)
  bstore(n: i64, f: i64, nb: i64, b: i64, ni: i64):
    %rec = call i64 ld64(46248)
    %r32 = add i64 %rec, 32
    call void mstore(%r32, ni)
    br bnext(n, f, nb, b)
  bnext(n: i64, f: i64, nb: i64, b: i64):
    %cb = call i64 ld64(45960)
    %cb2 = add i64 %cb, 1
    call void st64(45960, %cb2)
    %b2 = add i64 b, 1
    br bloop(n, f, nb, %b2)
  fdone(n: i64, f: i64, nb: i64):
    %mv = call i64 ld64(46032)
    %nv = add i64 %mv, 1
    %vt = call i64 ld64(45984)
    %vt2 = add i64 %vt, %nv
    call void st64(45984, %vt2)
    %pass = call i64 ld64(46040)
    %p2 = icmp.eq i64 %pass, 2
    condbr %p2, fstore(n, f, nb, %nv), fnext(n, f)
  fstore(n: i64, f: i64, nb: i64, nv: i64):
    %rec = call i64 ld64(46256)
    %r40 = add i64 %rec, 40
    call void mstore(%r40, nb)
    %r48 = add i64 %rec, 48
    call void mstore(%r48, nv)
    br fnext(n, f)
  fnext(n: i64, f: i64):
    %cf = call i64 ld64(45952)
    %cf2 = add i64 %cf, 1
    call void st64(45952, %cf2)
    %f2 = add i64 f, 1
    br loop(n, %f2)
  ffail(fl: i64):
    ret fl
  ok():
    ret 0
}

fn walk_mod() -> i64 {
  entry():
    %e1 = iconst i64 1
    %e2 = iconst i64 2
    %e0 = iconst i64 0
    %b0 = call i64 rd8()
    %e0 = icmp.eq i64 %b0, 75
    condbr %e0, m1(), bad1()
  bad1():
    ret 1
  m1():
    %b1 = call i64 rd8()
    %e1 = icmp.eq i64 %b1, 82
    condbr %e1, m2(), bad1()
  m2():
    %b2 = call i64 rd8()
    %e2 = icmp.eq i64 %b2, 69
    condbr %e2, m3(), bad1()
  m3():
    %b3 = call i64 rd8()
    %e3 = icmp.eq i64 %b3, 76
    condbr %e3, ver(), bad1()
  ver():
    %lo = call i64 rd8()
    %hi = call i64 rd8()
    %h8 = shl i64 %hi, 8
    %v = or i64 %lo, %h8
    %ok = icmp.eq i64 %v, 1
    condbr %ok, secs(), bad2()
  bad2():
    ret 2
  secs():
    %cur = call i64 ld64(45896)
    %end = call i64 ld64(45904)
    %more = icmp.slt i64 %cur, %end
    condbr %more, sec(), ok()
  sec():
    %id = call i64 rd8()
    %len = call i64 ruleb()
    %cur = call i64 ld64(45896)
    %send = add i64 %cur, %len
    call void st64(46264, %send)
    %i2 = icmp.eq i64 %id, 2
    condbr %i2, sx(), s3(%id)
  sx():
    call void walk_exts()
    br jump()
  s3(id: i64):
    %i3 = icmp.eq i64 id, 3
    condbr %i3, sd(), s4(id)
  sd():
    call void walk_data()
    br jump()
  s4(id: i64):
    %i4 = icmp.eq i64 id, 4
    condbr %i4, sf(), jump()
  sf():
    %fl = call i64 walk_funcs()
    %bad = icmp.ne i64 %fl, 0
    condbr %bad, ff(%fl), jump()
  ff(fl: i64):
    ret fl
  jump():
    %send = call i64 ld64(46264)
    call void st64(45896, %send)
    br secs()
  ok():
    ret 0
}

; compute the A layout from the pass-1 cursors and write the
; A header; the A size lands at 46312
fn run_layout() -> void {
  entry():
    %A = call i64 ld64(45824)
    %nf = call i64 ld64(45952)
    call void mstore(%A, %nf)
    %nb = call i64 ld64(45960)
    %a8 = add i64 %A, 8
    call void mstore(%a8, %nb)
    %ni = call i64 ld64(45968)
    %a16 = add i64 %A, 16
    call void mstore(%a16, %ni)
    %pn = call i64 ld64(45976)
    %a24 = add i64 %A, 24
    call void mstore(%a24, %pn)
    %ne = call i64 ld64(46000)
    %a32 = add i64 %A, 32
    call void mstore(%a32, %ne)
    %nd = call i64 ld64(46008)
    %a40 = add i64 %A, 40
    call void mstore(%a40, %nd)
    %bb = call i64 ld64(45992)
    %a48 = add i64 %A, 48
    call void mstore(%a48, %bb)
    %tv = call i64 ld64(45984)
    %a56 = add i64 %A, 56
    call void mstore(%a56, %tv)
    %a64 = add i64 %A, 64
    call void mstore(%a64, -1)
    %a72 = add i64 %A, 72
    call void mstore(%a72, %bb)
    %sh = shl i64 %nf, 6
    %bo = add i64 4096, %sh
    %a104 = add i64 %A, 104
    call void mstore(%a104, %bo)
    %sh2 = shl i64 %nb, 5
    %sh3 = shl i64 %nb, 4
    %io = add i64 %bo, %sh2
    %io2 = add i64 %io, %sh3
    %a112 = add i64 %A, 112
    call void mstore(%a112, %io2)
    %sh4 = shl i64 %ni, 7
    %sh5 = shl i64 %ni, 4
    %po = add i64 %io2, %sh4
    %po2 = add i64 %po, %sh5
    %a120 = add i64 %A, 120
    call void mstore(%a120, %po2)
    %sh6 = shl i64 %pn, 3
    %vo = add i64 %po2, %sh6
    %a128 = add i64 %A, 128
    call void mstore(%a128, %vo)
    %sh7 = shl i64 %tv, 4
    %xo = add i64 %vo, %sh7
    %a136 = add i64 %A, 136
    call void mstore(%a136, %xo)
    %sh8 = shl i64 %ne, 5
    %do = add i64 %xo, %sh8
    %a144 = add i64 %A, 144
    call void mstore(%a144, %do)
    %sh9 = shl i64 %nd, 4
    %te = add i64 %do, %sh9
    %te2 = add i64 %te, 4095
    %fo = and i64 %te2, -4096
    %a80 = add i64 %A, 80
    call void mstore(%a80, %fo)
    %vo2 = add i64 %fo, 32768
    %a88 = add i64 %A, 88
    call void mstore(%a88, %vo2)
    %asz = add i64 %vo2, 65536
    %a152 = add i64 %A, 152
    call void mstore(%a152, %asz)
    call void st64(46312, %asz)
    ret
}

fn zero_cursors() -> void {
  entry():
    br loop(0)
  loop(i: i64):
    %done = icmp.sge i64 i, 8
    condbr %done, fin(), body(i)
  body(i: i64):
    %sh = shl i64 i, 3
    %a = add i64 45952, %sh
    call void st64(%a, 0)
    %i2 = add i64 i, 1
    br loop(%i2)
  fin():
    ret
}

fn mzero(i64, i64) -> void {
  entry(a: i64, n: i64):
    br loop(a, n, 0)
  loop(a: i64, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(a, n, i)
  body(a: i64, n: i64, i: i64):
    %d = add i64 a, i
    call void mstore8(%d, 0)
    %i2 = add i64 i, 1
    br loop(a, n, %i2)
  fin():
    ret
}

; load and run module idx; status lands at 45848, code at 45856
fn run_module(i64) -> void {
  entry(idx: i64):
    %e2 = iconst i64 2
    %e45848 = iconst i64 45848
    %e45856 = iconst i64 45856
    %toff = mul i64 idx, 32
    %tp = add i64 45384, %toff
    %addr = call i64 mload(%tp)
    %szp = add i64 %tp, 8
    %size = call i64 mload(%szp)
    call void st64(45888, %addr)
    %end = add i64 %addr, %size
    call void st64(45904, %end)
    call void zero_cursors()
    call void st64(46040, 1)
    call void st64(45896, %addr)
    %fl = call i64 walk_mod()
    %bad = icmp.ne i64 %fl, 0
    condbr %bad, fault(%fl), sized()
  sized():
    call void run_layout_pre()
    %asz = call i64 ld64(46312)
    %A = call i64 kmalloc(%asz)
    %B = call i64 kmalloc(262144)
    call void st64(45824, %A)
    call void st64(45832, %B)
    %no = icmp.eq i64 %A, 0
    %no2 = icmp.eq i64 %B, 0
    %nz = zext i64 %no
    %nz2 = zext i64 %no2
    %either = or i64 %nz, %nz2
    %oom = icmp.ne i64 %either, 0
    condbr %oom, fault(95), lay(%A, %B)
  lay(A: i64, B: i64):
    call void run_layout()
    %tv = call i64 ld64(45984)
    %sh = shl i64 %tv, 4
    %voa = add i64 A, 128
    %vo = call i64 mload(%voa)
    %vaddr = add i64 A, %vo
    call void mzero(%vaddr, %sh)
    call void zero_cursors()
    call void st64(46040, 2)
    %addr = call i64 ld64(45888)
    call void st64(45896, %addr)
    %fl = call i64 walk_mod()
    %bad = icmp.ne i64 %fl, 0
    condbr %bad, fault2(%fl, A, B), extchk(A, B)
  extchk(A: i64, B: i64):
    %ne = call i64 mload(A)
    %ne2 = call i64 ld64(46000)
    br xloop(A, B, %ne2, 0)
  xloop(A: i64, B: i64, ne: i64, i: i64):
    %done = icmp.sge i64 i, ne
    condbr %done, mainchk(A, B), xbody(A, B, ne, i)
  xbody(A: i64, B: i64, ne: i64, i: i64):
    %xoa = add i64 A, 136
    %xo = call i64 mload(%xoa)
    %sh = shl i64 i, 5
    %rec = add i64 A, %xo
    %rec2 = add i64 %rec, %sh
    %h16 = add i64 %rec2, 16
    %hid = call i64 mload(%h16)
    %no = icmp.eq i64 %hid, 0
    condbr %no, fault2(93, A, B), xnext(A, B, ne, i)
  xnext(A: i64, B: i64, ne: i64, i: i64):
    %i2 = add i64 i, 1
    br xloop(A, B, ne, %i2)
  mainchk(A: i64, B: i64):
    %mna = add i64 A, 64
    %mn = call i64 mload(%mna)
    %no = icmp.slt i64 %mn, 0
    condbr %no, fault2(4, A, B), go(A, B)
  go(A: i64, B: i64):
    call void mod_exec()
    %A2 = call i64 ld64(45824)
    %B2 = call i64 ld64(45832)
    call void kfree(%A2)
    call void kfree(%B2)
    ret
  fault(fl: i64):
    call void st64(45848, 2)
    call void st64(45856, fl)
    ret
  fault2(fl: i64, A: i64, B: i64):
    call void kfree(A)
    call void kfree(B)
    call void st64(45848, 2)
    call void st64(45856, fl)
    ret
}

; A-size-only pass over the pass-1 cursors (no A exists yet)
fn run_layout_pre() -> void {
  entry():
    %nf = call i64 ld64(45952)
    %nb = call i64 ld64(45960)
    %ni = call i64 ld64(45968)
    %pn = call i64 ld64(45976)
    %ne = call i64 ld64(46000)
    %nd = call i64 ld64(46008)
    %tv = call i64 ld64(45984)
    %sh = shl i64 %nf, 6
    %bo = add i64 4096, %sh
    %sh2 = shl i64 %nb, 5
    %sh3 = shl i64 %nb, 4
    %io = add i64 %bo, %sh2
    %io2 = add i64 %io, %sh3
    %sh4 = shl i64 %ni, 7
    %sh5 = shl i64 %ni, 4
    %po = add i64 %io2, %sh4
    %po2 = add i64 %po, %sh5
    %sh6 = shl i64 %pn, 3
    %vo = add i64 %po2, %sh6
    %sh7 = shl i64 %tv, 4
    %xo = add i64 %vo, %sh7
    %sh8 = shl i64 %ne, 5
    %do = add i64 %xo, %sh8
    %sh9 = shl i64 %nd, 4
    %te = add i64 %do, %sh9
    %te2 = add i64 %te, 4095
    %fo = and i64 %te2, -4096
    %vo2 = add i64 %fo, 32768
    %asz = add i64 %vo2, 65536
    call void st64(46312, %asz)
    ret
}

; ---- execution ------------------------------------------------------

fn fra() -> i64 {
  entry():
    %A = call i64 ld64(45824)
    %t = call i64 ld64(45864)
    %r = add i64 %A, %t
    ret %r
}

fn fld(i64) -> i64 {
  entry(off: i64):
    %f = call i64 fra()
    %a = add i64 %f, off
    %v = call i64 mload(%a)
    ret %v
}

fn fst(i64, i64) -> void {
  entry(off: i64, v: i64):
    %f = call i64 fra()
    %a = add i64 %f, off
    call void mstore(%a, v)
    ret
}

fn ira(i64) -> i64 {
  entry(off: i64):
    %r = call i64 ld64(45944)
    %a = add i64 %r, off
    %v = call i64 mload(%a)
    ret %v
}

fn vg(i64) -> i64 {
  entry(vid: i64):
    %A = call i64 ld64(45824)
    %vb = call i64 fld(24)
    %base = add i64 %A, %vb
    %sh = shl i64 vid, 3
    %a = add i64 %base, %sh
    %v = call i64 mload(%a)
    ret %v
}

fn vs(i64, i64) -> void {
  entry(vid: i64, v: i64):
    %A = call i64 ld64(45824)
    %vb = call i64 fld(24)
    %base = add i64 %A, %vb
    %sh = shl i64 vid, 3
    %a = add i64 %base, %sh
    call void mstore(%a, v)
    ret
}

; type of a value of the current function: kind at 46328, bits at 46336
fn vtyp(i64) -> void {
  entry(vid: i64):
    %A = call i64 ld64(45824)
    %fn = call i64 fld(0)
    %sh = shl i64 %fn, 6
    %rec = add i64 %A, 4096
    %rec2 = add i64 %rec, %sh
    %o56 = add i64 %rec2, 56
    %vto = call i64 mload(%o56)
    %idx = add i64 %vto, vid
    %voa = add i64 %A, 128
    %vo = call i64 mload(%voa)
    %sh2 = shl i64 %idx, 4
    %base = add i64 %A, %vo
    %a = add i64 %base, %sh2
    %k = call i64 mload(%a)
    call void st64(46328, %k)
    %a8 = add i64 %a, 8
    %b = call i64 mload(%a8)
    call void st64(46336, %b)
    ret
}

fn maskw(i64, i64) -> i64 {
  entry(v: i64, bits: i64):
    %full = icmp.sge i64 bits, 64
    condbr %full, id(v), go(v, bits)
  id(v: i64):
    ret v
  go(v: i64, bits: i64):
    %one = iconst i64 1
    %m = shl i64 %one, bits
    %m2 = sub i64 %m, 1
    %r = and i64 v, %m2
    ret %r
}

fn sxtw(i64, i64) -> i64 {
  entry(v: i64, bits: i64):
    %full = icmp.sge i64 bits, 64
    condbr %full, id(v), go(v, bits)
  id(v: i64):
    ret v
  go(v: i64, bits: i64):
    %sh = sub i64 64, bits
    %a = shl i64 v, %sh
    %r = ashr i64 %a, %sh
    ret %r
}

fn set_res(i64) -> void {
  entry(v: i64):
    %res = call i64 ira(8)
    %neg = icmp.slt i64 %res, 0
    condbr %neg, fin(), go(%res, v)
  go(res: i64, v: i64):
    %k = call i64 ira(16)
    %is3 = icmp.eq i64 %k, 3
    condbr %is3, raw(res, v), mask(res, v)
  raw(res: i64, v: i64):
    call void vs(res, v)
    br fin()
  mask(res: i64, v: i64):
    %b = call i64 ira(24)
    %m = call i64 maskw(v, %b)
    call void vs(res, %m)
    br fin()
  fin():
    ret
}

fn adv_pc() -> void {
  entry():
    %pc = call i64 fld(16)
    %pc2 = add i64 %pc, 1
    call void fst(16, %pc2)
    ret
}

fn fault(i64) -> void {
  entry(code: i64):
    call void st64(45848, 2)
    call void st64(45856, code)
    ret
}

fn poolv(i64) -> i64 {
  entry(ix: i64):
    %A = call i64 ld64(45824)
    %poa = add i64 %A, 120
    %po = call i64 mload(%poa)
    %sh = shl i64 ix, 3
    %a = add i64 %A, %po
    %a2 = add i64 %a, %sh
    %v = call i64 mload(%a2)
    ret %v
}

fn blkrec(i64) -> i64 {
  entry(b: i64):
    %A = call i64 ld64(45824)
    %boa = add i64 %A, 104
    %bo = call i64 mload(%boa)
    %s1 = shl i64 b, 5
    %s2 = shl i64 b, 4
    %off = add i64 %s1, %s2
    %r = add i64 %A, %bo
    %r2 = add i64 %r, %off
    ret %r2
}

fn funrec(i64) -> i64 {
  entry(f: i64):
    %A = call i64 ld64(45824)
    %sh = shl i64 f, 6
    %r = add i64 %A, 4096
    %r2 = add i64 %r, %sh
    ret %r2
}

; ---- integer ops ------------------------------------------------------

fn popc_w(i64, i64) -> i64 {
  entry(v: i64, bits: i64):
    %x = call i64 maskw(v, bits)
    br loop(%x, 0)
  loop(x: i64, acc: i64):
    %no = icmp.eq i64 x, 0
    condbr %no, fin(acc), body(x, acc)
  body(x: i64, acc: i64):
    %b = and i64 x, 1
    %a2 = add i64 acc, %b
    %x2 = lshr i64 x, 1
    br loop(%x2, %a2)
  fin(acc: i64):
    ret acc
}

fn clz_w(i64, i64) -> i64 {
  entry(v: i64, bits: i64):
    %x = call i64 maskw(v, bits)
    br loop(%x, bits, 0)
  loop(x: i64, bits: i64, acc: i64):
    %sh = sub i64 bits, 1
    %top = shl i64 1, %sh
    %hit = and i64 x, %top
    %is = icmp.ne i64 %hit, 0
    condbr %is, fin(acc), next(x, bits, acc)
  next(x: i64, bits: i64, acc: i64):
    %a2 = add i64 acc, 1
    %over = icmp.sge i64 %a2, bits
    condbr %over, fin(%a2), more(x, bits, %a2)
  more(x: i64, bits: i64, acc: i64):
    %x2 = shl i64 x, 1
    br loop(%x2, bits, acc)
  fin(acc: i64):
    ret acc
}

fn ctz_w(i64, i64) -> i64 {
  entry(v: i64, bits: i64):
    %x = call i64 maskw(v, bits)
    br loop(%x, bits, 0)
  loop(x: i64, bits: i64, acc: i64):
    %b = and i64 x, 1
    %is = icmp.ne i64 %b, 0
    condbr %is, fin(acc), next(x, bits, acc)
  next(x: i64, bits: i64, acc: i64):
    %a2 = add i64 acc, 1
    %over = icmp.sge i64 %a2, bits
    condbr %over, fin(%a2), more(x, bits, %a2)
  more(x: i64, bits: i64, acc: i64):
    %x2 = lshr i64 x, 1
    br loop(%x2, bits, acc)
  fin(acc: i64):
    ret acc
}

fn bswap_w(i64, i64) -> i64 {
  entry(v: i64, bits: i64):
    %nb = sdiv i64 bits, 8
    br loop(v, %nb, 0, 0)
  loop(v: i64, nb: i64, i: i64, acc: i64):
    %done = icmp.sge i64 i, nb
    condbr %done, fin(acc), body(v, nb, i, acc)
  body(v: i64, nb: i64, i: i64, acc: i64):
    %sh = shl i64 i, 3
    %part = lshr i64 v, %sh
    %byte = and i64 %part, 255
    %last = sub i64 nb, 1
    %ri = sub i64 %last, i
    %rsh = shl i64 %ri, 3
    %put = shl i64 %byte, %rsh
    %a2 = or i64 acc, %put
    %i2 = add i64 i, 1
    br loop(v, nb, %i2, %a2)
  fin(acc: i64):
    ret acc
}

fn x_icmp() -> void {
  entry():
    %a_id = call i64 ira(32)
    call void vtyp(%a_id)
    %bits = call i64 ld64(46336)
    %av = call i64 vg(%a_id)
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %pred = call i64 ira(64)
    br disp(%pred, %av, %bv, %bits)
  disp(pred: i64, av: i64, bv: i64, bits: i64):
    %p0 = icmp.eq i64 pred, 0
    condbr %p0, c_eq(av, bv), n1(pred, av, bv, bits)
  c_eq(av: i64, bv: i64):
    %r = icmp.eq i64 av, bv
    br out(%r)
  n1(pred: i64, av: i64, bv: i64, bits: i64):
    %p1 = icmp.eq i64 pred, 1
    condbr %p1, c_ne(av, bv), n2(pred, av, bv, bits)
  c_ne(av: i64, bv: i64):
    %r = icmp.ne i64 av, bv
    br out(%r)
  n2(pred: i64, av: i64, bv: i64, bits: i64):
    %hi = icmp.sge i64 pred, 6
    condbr %hi, sgn(pred, av, bv, bits), uns(pred, av, bv, bits)
  uns(pred: i64, av: i64, bv: i64, bits: i64):
    %x = call i64 maskw(av, bits)
    %y = call i64 maskw(bv, bits)
    %p2 = icmp.eq i64 pred, 2
    condbr %p2, u_lt(%x, %y), u2(pred, %x, %y)
  u_lt(x: i64, y: i64):
    %r = icmp.ult i64 x, y
    br out(%r)
  u2(pred: i64, x: i64, y: i64):
    %p3 = icmp.eq i64 pred, 3
    condbr %p3, u_le(x, y), u3(pred, x, y)
  u_le(x: i64, y: i64):
    %r = icmp.ule i64 x, y
    br out(%r)
  u3(pred: i64, x: i64, y: i64):
    %p4 = icmp.eq i64 pred, 4
    condbr %p4, u_gt(x, y), u_ge(x, y)
  u_gt(x: i64, y: i64):
    %r = icmp.ugt i64 x, y
    br out(%r)
  u_ge(x: i64, y: i64):
    %r = icmp.uge i64 x, y
    br out(%r)
  sgn(pred: i64, av: i64, bv: i64, bits: i64):
    %x = call i64 sxtw(av, bits)
    %y = call i64 sxtw(bv, bits)
    %p6 = icmp.eq i64 pred, 6
    condbr %p6, s_lt(%x, %y), s2(pred, %x, %y)
  s_lt(x: i64, y: i64):
    %r = icmp.slt i64 x, y
    br out(%r)
  s2(pred: i64, x: i64, y: i64):
    %p7 = icmp.eq i64 pred, 7
    condbr %p7, s_le(x, y), s3(pred, x, y)
  s_le(x: i64, y: i64):
    %r = icmp.sle i64 x, y
    br out(%r)
  s3(pred: i64, x: i64, y: i64):
    %p8 = icmp.eq i64 pred, 8
    condbr %p8, s_gt(x, y), s_ge(x, y)
  s_gt(x: i64, y: i64):
    %r = icmp.sgt i64 x, y
    br out(%r)
  s_ge(x: i64, y: i64):
    %r = icmp.sge i64 x, y
    br out(%r)
  out(r: i1):
    %z = zext i64 r
    call void set_res(%z)
    call void adv_pc()
    ret
}

fn x_alu() -> void {
  entry():
    %op = call i64 ira(0)
    %a_id = call i64 ira(32)
    %av = call i64 vg(%a_id)
    call void vtyp(%a_id)
    %bits = call i64 ld64(46336)
    %is19 = icmp.eq i64 %op, 19
    condbr %is19, ic(), un(%op, %av, %bits)
  ic():
    call void x_icmp()
    ret
  un(op: i64, av: i64, bits: i64):
    %is11 = icmp.eq i64 op, 11
    condbr %is11, c_neg(av), u2(op, av, bits)
  c_neg(av: i64):
    %r = neg i64 av
    br out(%r)
  u2(op: i64, av: i64, bits: i64):
    %is15 = icmp.eq i64 op, 15
    condbr %is15, c_not(av), u3(op, av, bits)
  c_not(av: i64):
    %r = not i64 av
    br out(%r)
  u3(op: i64, av: i64, bits: i64):
    %lo = icmp.sge i64 op, 20
    %hi = icmp.sle i64 op, 23
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, bitops(op, av, bits), bin(op, av, bits)
  bitops(op: i64, av: i64, bits: i64):
    %is20 = icmp.eq i64 op, 20
    condbr %is20, c_pop(av, bits), b2(op, av, bits)
  c_pop(av: i64, bits: i64):
    %r = call i64 popc_w(av, bits)
    br out(%r)
  b2(op: i64, av: i64, bits: i64):
    %is21 = icmp.eq i64 op, 21
    condbr %is21, c_clz(av, bits), b3(op, av, bits)
  c_clz(av: i64, bits: i64):
    %r = call i64 clz_w(av, bits)
    br out(%r)
  b3(op: i64, av: i64, bits: i64):
    %is22 = icmp.eq i64 op, 22
    condbr %is22, c_ctz(av, bits), c_bs(av, bits)
  c_ctz(av: i64, bits: i64):
    %r = call i64 ctz_w(av, bits)
    br out(%r)
  c_bs(av: i64, bits: i64):
    %r = call i64 bswap_w(av, bits)
    br out(%r)
  bin(op: i64, av: i64, bits: i64):
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %is4 = icmp.eq i64 op, 4
    condbr %is4, c_add(av, bv), d2(op, av, bv, bits)
  c_add(av: i64, bv: i64):
    %r = add i64 av, bv
    br out(%r)
  d2(op: i64, av: i64, bv: i64, bits: i64):
    %is5 = icmp.eq i64 op, 5
    condbr %is5, c_sub(av, bv), d3(op, av, bv, bits)
  c_sub(av: i64, bv: i64):
    %r = sub i64 av, bv
    br out(%r)
  d3(op: i64, av: i64, bv: i64, bits: i64):
    %is6 = icmp.eq i64 op, 6
    condbr %is6, c_mul(av, bv), d4(op, av, bv, bits)
  c_mul(av: i64, bv: i64):
    %r = mul i64 av, bv
    br out(%r)
  d4(op: i64, av: i64, bv: i64, bits: i64):
    %is12 = icmp.eq i64 op, 12
    condbr %is12, c_and(av, bv), d5(op, av, bv, bits)
  c_and(av: i64, bv: i64):
    %r = and i64 av, bv
    br out(%r)
  d5(op: i64, av: i64, bv: i64, bits: i64):
    %is13 = icmp.eq i64 op, 13
    condbr %is13, c_or(av, bv), d6(op, av, bv, bits)
  c_or(av: i64, bv: i64):
    %r = or i64 av, bv
    br out(%r)
  d6(op: i64, av: i64, bv: i64, bits: i64):
    %is14 = icmp.eq i64 op, 14
    condbr %is14, c_xor(av, bv), d7(op, av, bv, bits)
  c_xor(av: i64, bv: i64):
    %r = xor i64 av, bv
    br out(%r)
  d7(op: i64, av: i64, bv: i64, bits: i64):
    %is7 = icmp.eq i64 op, 7
    condbr %is7, c_udiv(av, bv, bits), d8(op, av, bv, bits)
  c_udiv(av: i64, bv: i64, bits: i64):
    %x = call i64 maskw(av, bits)
    %y = call i64 maskw(bv, bits)
    %z = icmp.eq i64 %y, 0
    condbr %z, out0(), du(%x, %y)
  du(x: i64, y: i64):
    %r = udiv i64 x, y
    br out(%r)
  out0():
    br out(0)
  d8(op: i64, av: i64, bv: i64, bits: i64):
    %is9 = icmp.eq i64 op, 9
    condbr %is9, c_urem(av, bv, bits), d9(op, av, bv, bits)
  c_urem(av: i64, bv: i64, bits: i64):
    %x = call i64 maskw(av, bits)
    %y = call i64 maskw(bv, bits)
    %z = icmp.eq i64 %y, 0
    condbr %z, out0(), ru(%x, %y)
  ru(x: i64, y: i64):
    %r = urem i64 x, y
    br out(%r)
  d9(op: i64, av: i64, bv: i64, bits: i64):
    %is8 = icmp.eq i64 op, 8
    condbr %is8, c_sdiv(av, bv, bits), d10(op, av, bv, bits)
  c_sdiv(av: i64, bv: i64, bits: i64):
    %x = call i64 sxtw(av, bits)
    %y = call i64 sxtw(bv, bits)
    %z = icmp.eq i64 %y, 0
    condbr %z, out0(), ds(%x, %y)
  ds(x: i64, y: i64):
    %r = sdiv i64 x, y
    br out(%r)
  d10(op: i64, av: i64, bv: i64, bits: i64):
    %is10 = icmp.eq i64 op, 10
    condbr %is10, c_srem(av, bv, bits), d11(op, av, bv, bits)
  c_srem(av: i64, bv: i64, bits: i64):
    %x = call i64 sxtw(av, bits)
    %y = call i64 sxtw(bv, bits)
    %z = icmp.eq i64 %y, 0
    condbr %z, out0(), rs(%x, %y)
  rs(x: i64, y: i64):
    %r = srem i64 x, y
    br out(%r)
  d11(op: i64, av: i64, bv: i64, bits: i64):
    %sh = urem i64 av, bits
    %is16 = icmp.eq i64 op, 16
    condbr %is16, c_shl(av, bits), d12(op, av, bv, bits)
  c_shl(av: i64, bits: i64):
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %sh = urem i64 %bv, bits
    %r = shl i64 av, %sh
    br out(%r)
  d12(op: i64, av: i64, bv: i64, bits: i64):
    %is17 = icmp.eq i64 op, 17
    condbr %is17, c_lshr(av, bits), c_ashr(av, bits)
  c_lshr(av: i64, bits: i64):
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %sh = urem i64 %bv, bits
    %x = call i64 maskw(av, bits)
    %r = lshr i64 %x, %sh
    br out(%r)
  c_ashr(av: i64, bits: i64):
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %sh = urem i64 %bv, bits
    %x = call i64 sxtw(av, bits)
    %r = ashr i64 %x, %sh
    br out(%r)
  out(r: i64):
    call void set_res(r)
    call void adv_pc()
    ret
}

; ---- conversions and float -------------------------------------------

fn x_cvt() -> void {
  entry():
    %op = call i64 ira(0)
    %a_id = call i64 ira(32)
    %av = call i64 vg(%a_id)
    call void vtyp(%a_id)
    %sb = call i64 ld64(46336)
    %is24 = icmp.eq i64 %op, 24
    condbr %is24, c_tr(av), n2(%op, %av, %sb)
  c_tr(av: i64):
    %rb = call i64 ira(24)
    %r = call i64 maskw(av, %rb)
    br out(%r)
  n2(op: i64, av: i64, sb: i64):
    %is25 = icmp.eq i64 op, 25
    condbr %is25, c_zx(av, sb), n3(op, av, sb)
  c_zx(av: i64, sb: i64):
    %r = call i64 maskw(av, sb)
    br out(%r)
  n3(op: i64, av: i64, sb: i64):
    %is26 = icmp.eq i64 op, 26
    condbr %is26, c_sx(av, sb), out(av)
  c_sx(av: i64, sb: i64):
    %r = call i64 sxtw(av, sb)
    br out(%r)
  out(r: i64):
    call void set_res(r)
    call void adv_pc()
    ret
}

fn to_f64(i64, i64) -> f64 {
  entry(bits_pat: i64, bits: i64):
    %is32 = icmp.eq i64 bits, 32
    condbr %is32, f32(bits_pat), f64(bits_pat)
  f32(p: i64):
    %t = trunc i32 p
    %f = bitcast f32 %t
    %d = fext f64 %f
    ret %d
  f64(p: i64):
    %d = bitcast f64 p
    ret %d
}

fn from_f64(f64, i64) -> i64 {
  entry(d: f64, bits: i64):
    %is32 = icmp.eq i64 bits, 32
    condbr %is32, f32(d), f64(d)
  f32(d: f64):
    %f = ftrunc f32 d
    %t = bitcast i32 %f
    %z = zext i64 %t
    ret %z
  f64(d: f64):
    %p = bitcast i64 d
    ret %p
}

fn x_fp() -> void {
  entry():
    %op = call i64 ira(0)
    %rb = call i64 ira(24)
    %a_id = call i64 ira(32)
    %av = call i64 vg(%a_id)
    %fa = call f64 to_f64(%av, %rb)
    %is31 = icmp.eq i64 %op, 31
    condbr %is31, c_neg(%fa, %rb), n2(%op, %fa, %rb)
  c_neg(fa: f64, rb: i64):
    %r = fneg f64 %fa
    br out(%r, rb)
  n2(op: i64, fa: f64, rb: i64):
    %is32 = icmp.eq i64 op, 32
    condbr %is32, c_abs(fa, rb), bin(op, fa, rb)
  c_abs(fa: f64, rb: i64):
    %r = fabs f64 %fa
    br out(%r, rb)
  bin(op: i64, fa: f64, rb: i64):
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %fb = call f64 to_f64(%bv, rb)
    %is27 = icmp.eq i64 op, 27
    condbr %is27, c_add(fa, fb, rb), d2(op, fa, fb, rb)
  c_add(fa: f64, fb: f64, rb: i64):
    %r = fadd f64 %fa, %fb
    br out(%r, rb)
  d2(op: i64, fa: f64, fb: f64, rb: i64):
    %is28 = icmp.eq i64 op, 28
    condbr %is28, c_sub(fa, fb, rb), d3(op, fa, fb, rb)
  c_sub(fa: f64, fb: f64, rb: i64):
    %r = fsub f64 %fa, %fb
    br out(%r, rb)
  d3(op: i64, fa: f64, fb: f64, rb: i64):
    %is29 = icmp.eq i64 op, 29
    condbr %is29, c_mul(fa, fb, rb), d4(op, fa, fb, rb)
  c_mul(fa: f64, fb: f64, rb: i64):
    %r = fmul f64 %fa, %fb
    br out(%r, rb)
  d4(op: i64, fa: f64, fb: f64, rb: i64):
    %is30 = icmp.eq i64 op, 30
    condbr %is30, c_div(fa, fb, rb), c_fma(op, fa, fb, rb)
  c_div(fa: f64, fb: f64, rb: i64):
    %r = fdiv f64 %fa, %fb
    br out(%r, rb)
  c_fma(op: i64, fa: f64, fb: f64, rb: i64):
    %c_id = call i64 ira(48)
    %cv = call i64 vg(%c_id)
    %fc = call f64 to_f64(%cv, rb)
    %p = fmul f64 %fa, %fb
    %r = fadd f64 %p, %fc
    br out(%r, rb)
  out(r: f64, rb: i64):
    %p = call i64 from_f64(r, rb)
    call void set_res(%p)
    call void adv_pc()
    ret
}

fn x_fcmp1(i64, f64, f64) -> i64 {
  entry(pred: i64, x: f64, y: f64):
    %p0 = icmp.eq i64 pred, 0
    condbr %p0, c0(x, y), n1(pred, x, y)
  c0(x: f64, y: f64):
    %r = fcmp.oeq f64 x, y
    br out(%r)
  n1(pred: i64, x: f64, y: f64):
    %p1 = icmp.eq i64 pred, 1
    condbr %p1, c1(x, y), n2(pred, x, y)
  c1(x: f64, y: f64):
    %r = fcmp.one f64 x, y
    br out(%r)
  n2(pred: i64, x: f64, y: f64):
    %p2 = icmp.eq i64 pred, 2
    condbr %p2, c2(x, y), n3(pred, x, y)
  c2(x: f64, y: f64):
    %r = fcmp.olt f64 x, y
    br out(%r)
  n3(pred: i64, x: f64, y: f64):
    %p3 = icmp.eq i64 pred, 3
    condbr %p3, c3(x, y), n4(pred, x, y)
  c3(x: f64, y: f64):
    %r = fcmp.ole f64 x, y
    br out(%r)
  n4(pred: i64, x: f64, y: f64):
    %p4 = icmp.eq i64 pred, 4
    condbr %p4, c4(x, y), n5(pred, x, y)
  c4(x: f64, y: f64):
    %r = fcmp.ogt f64 x, y
    br out(%r)
  n5(pred: i64, x: f64, y: f64):
    %p5 = icmp.eq i64 pred, 5
    condbr %p5, c5(x, y), n6(pred, x, y)
  c5(x: f64, y: f64):
    %r = fcmp.oge f64 x, y
    br out(%r)
  n6(pred: i64, x: f64, y: f64):
    %p6 = icmp.eq i64 pred, 6
    condbr %p6, c6(x, y), n7(pred, x, y)
  c6(x: f64, y: f64):
    %r = fcmp.ueq f64 x, y
    br out(%r)
  n7(pred: i64, x: f64, y: f64):
    %p7 = icmp.eq i64 pred, 7
    condbr %p7, c7(x, y), n8(pred, x, y)
  c7(x: f64, y: f64):
    %r = fcmp.une f64 x, y
    br out(%r)
  n8(pred: i64, x: f64, y: f64):
    %p8 = icmp.eq i64 pred, 8
    condbr %p8, c8(x, y), n9(pred, x, y)
  c8(x: f64, y: f64):
    %r = fcmp.ult f64 x, y
    br out(%r)
  n9(pred: i64, x: f64, y: f64):
    %p9 = icmp.eq i64 pred, 9
    condbr %p9, c9(x, y), n10(pred, x, y)
  c9(x: f64, y: f64):
    %r = fcmp.ule f64 x, y
    br out(%r)
  n10(pred: i64, x: f64, y: f64):
    %p10 = icmp.eq i64 pred, 10
    condbr %p10, c10(x, y), n11(pred, x, y)
  c10(x: f64, y: f64):
    %r = fcmp.ugt f64 x, y
    br out(%r)
  n11(pred: i64, x: f64, y: f64):
    %p11 = icmp.eq i64 pred, 11
    condbr %p11, c11(x, y), n12(pred, x, y)
  c11(x: f64, y: f64):
    %r = fcmp.uge f64 x, y
    br out(%r)
  n12(pred: i64, x: f64, y: f64):
    %p12 = icmp.eq i64 pred, 12
    condbr %p12, c12(x, y), c13(x, y)
  c12(x: f64, y: f64):
    %r = fcmp.ord f64 x, y
    br out(%r)
  c13(x: f64, y: f64):
    %r = fcmp.uno f64 x, y
    br out(%r)
  out(r: i1):
    %z = zext i64 r
    ret %z
}

fn x_fcmp() -> void {
  entry():
    %a_id = call i64 ira(32)
    call void vtyp(%a_id)
    %bits = call i64 ld64(46336)
    %av = call i64 vg(%a_id)
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %fa = call f64 to_f64(%av, %bits)
    %fb = call f64 to_f64(%bv, %bits)
    %pred = call i64 ira(64)
    %r = call i64 x_fcmp1(%pred, %fa, %fb)
    call void set_res(%r)
    call void adv_pc()
    ret
}

fn x_fconv() -> void {
  entry():
    %op = call i64 ira(0)
    %a_id = call i64 ira(32)
    call void vtyp(%a_id)
    %sb = call i64 ld64(46336)
    %av = call i64 vg(%a_id)
    %fa = call f64 to_f64(%av, %sb)
    %rb = call i64 ira(24)
    %p = call i64 from_f64(%fa, %rb)
    call void set_res(%p)
    call void adv_pc()
    ret
}

fn x_f2i() -> void {
  entry():
    %e64 = iconst i64 64
    %e1 = iconst i64 1
    %op = call i64 ira(0)
    %rb = call i64 ira(24)
    %a_id = call i64 ira(32)
    call void vtyp(%a_id)
    %sb = call i64 ld64(46336)
    %av = call i64 vg(%a_id)
    %fa = call f64 to_f64(%av, %sb)
    %nan = fcmp.uno f64 %fa, %fa
    condbr %nan, zero(), conv(%op, %fa, %rb)
  zero():
    call void set_res(0)
    call void adv_pc()
    ret
  conv(op: i64, fa: f64, rb: i64):
    %is37 = icmp.eq i64 op, 37
    condbr %is37, si(fa, rb), ui(fa, rb)
  si(fa: f64, rb: i64):
    %v = fptosi i64 %fa
    br clamp_s(%v, rb)
  ui(fa: f64, rb: i64):
    %v = fptoui i64 %fa
    br clamp_u(%v, rb)
  clamp_s(v: i64, rb: i64):
    %full = icmp.sge i64 rb, 64
    condbr %full, out(v), narrow_s(v, rb)
  narrow_s(v: i64, rb: i64):
    %sh = sub i64 rb, 1
    %mx = shl i64 1, %sh
    %mx2 = sub i64 %mx, 1
    %mn = neg i64 %mx
    %hi = icmp.sgt i64 v, %mx2
    condbr %hi, out(%mx2), lo(v, %mn)
  lo(v: i64, mn: i64):
    %lw = icmp.slt i64 v, mn
    condbr %lw, out(mn), out(v)
  clamp_u(v: i64, rb: i64):
    %full = icmp.sge i64 rb, 64
    condbr %full, out(v), narrow_u(v, rb)
  narrow_u(v: i64, rb: i64):
    %mx = shl i64 1, rb
    %mx2 = sub i64 %mx, 1
    %hi = icmp.ugt i64 v, %mx2
    condbr %hi, out(%mx2), out(v)
  out(v: i64):
    call void set_res(v)
    call void adv_pc()
    ret
}

fn x_i2f() -> void {
  entry():
    %op = call i64 ira(0)
    %rb = call i64 ira(24)
    %a_id = call i64 ira(32)
    call void vtyp(%a_id)
    %sb = call i64 ld64(46336)
    %av = call i64 vg(%a_id)
    %is39 = icmp.eq i64 %op, 39
    condbr %is39, si(%av, %sb, %rb), ui(%av, %sb, %rb)
  si(av: i64, sb: i64, rb: i64):
    %x = call i64 sxtw(av, sb)
    %f = sitofp f64 %x
    br out(%f, rb)
  ui(av: i64, sb: i64, rb: i64):
    %x = call i64 maskw(av, sb)
    %f = uitofp f64 %x
    br out(%f, rb)
  out(f: f64, rb: i64):
    %p = call i64 from_f64(f, rb)
    call void set_res(%p)
    call void adv_pc()
    ret
}

fn x_select() -> void {
  entry():
    %a_id = call i64 ira(32)
    %cv = call i64 vg(%a_id)
    %c = and i64 %cv, 1
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %c_id = call i64 ira(48)
    %cv2 = call i64 vg(%c_id)
    %is = icmp.ne i64 %c, 0
    condbr %is, t(%bv), f(%cv2)
  t(v: i64):
    call void set_res(v)
    call void adv_pc()
    ret
  f(v: i64):
    call void set_res(v)
    call void adv_pc()
    ret
}

; ---- memory ops --------------------------------------------------------

fn baddr(i64, i64) -> i64 {
  entry(off: i64, size: i64):
    %neg = icmp.slt i64 off, 0
    condbr %neg, bad(), chk(off, size)
  chk(off: i64, size: i64):
    %end = add i64 off, size
    %over = icmp.sgt i64 %end, 262144
    condbr %over, bad(), ok(off)
  ok(off: i64):
    %B = call i64 ld64(45832)
    %r = add i64 %B, off
    ret %r
  bad():
    call void fault(91)
    ret 0
}

fn ty_size(i64, i64) -> i64 {
  entry(k: i64, b: i64):
    %e8 = iconst i64 8
    %is3 = icmp.eq i64 k, 3
    condbr %is3, p(), nb(b)
  p():
    ret 8
  nb(b: i64):
    %s = sdiv i64 b, 8
    %z = icmp.eq i64 %s, 0
    condbr %z, one(), out(%s)
  one():
    ret 1
  out(s: i64):
    ret s
}

fn load_n(i64, i64) -> i64 {
  entry(ha: i64, size: i64):
    %is8 = icmp.eq i64 size, 8
    condbr %is8, l8(ha), s4(ha, size)
  l8(ha: i64):
    %v = call i64 mload(ha)
    ret %v
  s4(ha: i64, size: i64):
    %is4 = icmp.eq i64 size, 4
    condbr %is4, l4(ha), small(ha, size)
  l4(ha: i64):
    %v = call i64 mload32(ha)
    ret %v
  small(ha: i64, size: i64):
    br loop(ha, size, 0, 0)
  loop(ha: i64, size: i64, i: i64, acc: i64):
    %done = icmp.sge i64 i, size
    condbr %done, fin(acc), body(ha, size, i, acc)
  body(ha: i64, size: i64, i: i64, acc: i64):
    %a = add i64 ha, i
    %byte = call i64 mload8(%a)
    %sh = shl i64 i, 3
    %put = shl i64 %byte, %sh
    %a2 = or i64 acc, %put
    %i2 = add i64 i, 1
    br loop(ha, size, %i2, %a2)
  fin(acc: i64):
    ret acc
}

fn store_n(i64, i64, i64) -> void {
  entry(ha: i64, v: i64, size: i64):
    %is8 = icmp.eq i64 size, 8
    condbr %is8, s8(ha, v), s4(ha, v, size)
  s8(ha: i64, v: i64):
    call void mstore(ha, v)
    ret
  s4(ha: i64, v: i64, size: i64):
    %is4 = icmp.eq i64 size, 4
    condbr %is4, w4(ha, v), small(ha, v, size)
  w4(ha: i64, v: i64):
    %t = trunc i32 v
    call void mstore32(ha, %t)
    ret
  small(ha: i64, v: i64, size: i64):
    br loop(ha, v, size, 0)
  loop(ha: i64, v: i64, size: i64, i: i64):
    %done = icmp.sge i64 i, size
    condbr %done, fin(), body(ha, v, size, i)
  body(ha: i64, v: i64, size: i64, i: i64):
    %sh = shl i64 i, 3
    %part = lshr i64 v, %sh
    %byte = and i64 %part, 255
    %a = add i64 ha, i
    call void mstore8(%a, %byte)
    %i2 = add i64 i, 1
    br loop(ha, v, size, %i2)
  fin():
    ret
}

fn x_mem() -> void {
  entry():
    %e16 = iconst i64 16
    %e24 = iconst i64 24
    %e32 = iconst i64 32
    %e40 = iconst i64 40
    %e48 = iconst i64 48
    %e56 = iconst i64 56
    %e1 = iconst i64 1
    %e45848 = iconst i64 45848
    %op = call i64 ira(0)
    %is43 = icmp.eq i64 %op, 43
    condbr %is43, load(), n2(%op)
  load():
    %k = call i64 ira(16)
    %b = call i64 ira(24)
    %sz = call i64 ty_size(%k, %b)
    %a_id = call i64 ira(32)
    %addr = call i64 vg(%a_id)
    %ha = call i64 baddr(%addr, %sz)
    %st = call i64 ld64(45848)
    %bad = icmp.ne i64 %st, 0
    condbr %bad, fin(), lgo(%ha, %sz)
  lgo(ha: i64, sz: i64):
    %v = call i64 load_n(ha, sz)
    call void set_res(%v)
    call void adv_pc()
    br fin()
  n2(op: i64):
    %is44 = icmp.eq i64 op, 44
    condbr %is44, store(), n3(op)
  store():
    %k = call i64 ira(16)
    %b = call i64 ira(24)
    %sz = call i64 ty_size(%k, %b)
    %a_id = call i64 ira(32)
    %addr = call i64 vg(%a_id)
    %ha = call i64 baddr(%addr, %sz)
    %st = call i64 ld64(45848)
    %bad = icmp.ne i64 %st, 0
    condbr %bad, fin(), sgo(%ha, %sz)
  sgo(ha: i64, sz: i64):
    %b_id = call i64 ira(40)
    %v = call i64 vg(%b_id)
    call void store_n(ha, %v, sz)
    call void adv_pc()
    br fin()
  n3(op: i64):
    %is45 = icmp.eq i64 op, 45
    condbr %is45, gep(), n4(op)
  gep():
    %a_id = call i64 ira(32)
    %base = call i64 vg(%a_id)
    %b_id = call i64 ira(40)
    %ix = call i64 vg(%b_id)
    %es = call i64 ira(136)
    %off = mul i64 %ix, %es
    %r = add i64 %base, %off
    call void set_res(%r)
    call void adv_pc()
    br fin()
  n4(op: i64):
    %is42 = icmp.eq i64 op, 42
    condbr %is42, alloc(), n5(op)
  alloc():
    %sz = call i64 ira(56)
    %bump = call i64 ld64(45880)
    %a15 = add i64 %sz, 15
    %al = and i64 %a15, -16
    %min = icmp.eq i64 %al, 0
    condbr %min, a16(%bump), ago(%bump, %al)
  a16(bump: i64):
    br ago(bump, 16)
  ago(bump: i64, al: i64):
    %nb = add i64 bump, al
    %over = icmp.sgt i64 %nb, 262144
    condbr %over, oom(), aok(bump, %nb)
  aok(bump: i64, nb: i64):
    call void st64(45880, nb)
    call void set_res(bump)
    call void adv_pc()
    br fin()
  oom():
    call void fault(91)
    br fin()
  n5(op: i64):
    %is48 = icmp.eq i64 op, 48
    condbr %is48, dp(), n6(op)
  dp():
    %ix = call i64 ira(56)
    %A = call i64 ld64(45824)
    %nd = call i64 mload(%A)
    %nd2a = add i64 %A, 40
    %nd2 = call i64 mload(%nd2a)
    %bad = icmp.sge i64 %ix, %nd2
    condbr %bad, df(), dok(%ix)
  df():
    call void fault(94)
    br fin()
  dok(ix: i64):
    %A = call i64 ld64(45824)
    %doa = add i64 %A, 144
    %do = call i64 mload(%doa)
    %sh = shl i64 %ix, 4
    %rec = add i64 %A, %do
    %rec2 = add i64 %rec, %sh
    %off = call i64 mload(%rec2)
    call void set_res(%off)
    call void adv_pc()
    br fin()
  n6(op: i64):
    %is46 = icmp.eq i64 op, 46
    condbr %is46, cpy(), n7(op)
  cpy():
    %a_id = call i64 ira(32)
    %dst = call i64 vg(%a_id)
    %b_id = call i64 ira(40)
    %src = call i64 vg(%b_id)
    %c_id = call i64 ira(48)
    %n = call i64 vg(%c_id)
    %hd = call i64 baddr(%dst, %n)
    %st = call i64 ld64(45848)
    %bad = icmp.ne i64 %st, 0
    condbr %bad, fin(), cpy2(%dst, %src, %n)
  cpy2(dst: i64, src: i64, n: i64):
    %hs = call i64 baddr(src, n)
    %st = call i64 ld64(45848)
    %bad = icmp.ne i64 %st, 0
    condbr %bad, fin(), cpy3(dst, src, n)
  cpy3(dst: i64, src: i64, n: i64):
    %B = call i64 ld64(45832)
    %hd = add i64 %B, dst
    %hs = add i64 %B, src
    %fwd = icmp.sle i64 dst, src
    condbr %fwd, fwd(%hd, %hs, n), bwd(%hd, %hs, n)
  fwd(hd: i64, hs: i64, n: i64):
    call void copy_bytes(hd, hs, n)
    call void adv_pc()
    br fin()
  bwd(hd: i64, hs: i64, n: i64):
    br bloop(hd, hs, n, n)
  bloop(hd: i64, hs: i64, n: i64, i: i64):
    %done = icmp.sle i64 i, 0
    condbr %done, bdone(), bbody(hd, hs, n, i)
  bbody(hd: i64, hs: i64, n: i64, i: i64):
    %j = sub i64 i, 1
    %sa = add i64 hs, %j
    %v = call i64 mload8(%sa)
    %da = add i64 hd, %j
    call void mstore8(%da, %v)
    br bloop(hd, hs, n, %j)
  bdone():
    call void adv_pc()
    br fin()
  n7(op: i64):
    %a_id = call i64 ira(32)
    %dst = call i64 vg(%a_id)
    %b_id = call i64 ira(40)
    %bv = call i64 vg(%b_id)
    %c_id = call i64 ira(48)
    %n = call i64 vg(%c_id)
    %hd = call i64 baddr(%dst, %n)
    %st = call i64 ld64(45848)
    %bad = icmp.ne i64 %st, 0
    condbr %bad, fin(), set(%hd, %bv, %n)
  set(hd: i64, bv: i64, n: i64):
    %byte = and i64 bv, 255
    br sloop(hd, %byte, n, 0)
  sloop(hd: i64, byte: i64, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, sdone(), sbody(hd, byte, n, i)
  sbody(hd: i64, byte: i64, n: i64, i: i64):
    %a = add i64 hd, i
    call void mstore8(%a, byte)
    %i2 = add i64 i, 1
    br sloop(hd, byte, n, %i2)
  sdone():
    call void adv_pc()
    br fin()
  fin():
    ret
}

; ---- control flow ------------------------------------------------------

fn eval_args(i64, i64) -> void {
  entry(off: i64, n: i64):
    br loop(off, n, 0)
  loop(off: i64, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(off, n, i)
  body(off: i64, n: i64, i: i64):
    %ix = add i64 off, i
    %vid = call i64 poolv(%ix)
    %v = call i64 vg(%vid)
    %sh = shl i64 i, 3
    %sa = add i64 46080, %sh
    call void mstore(%sa, %v)
    %i2 = add i64 i, 1
    br loop(off, n, %i2)
  fin():
    ret
}

fn write_args(i64) -> void {
  entry(blk: i64):
    %rec = call i64 blkrec(blk)
    %poa = add i64 %rec, 16
    %po = call i64 mload(%poa)
    %na = add i64 %rec, 8
    %n = call i64 mload(%na)
    br loop(blk, %po, %n, 0)
  loop(blk: i64, po: i64, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), body(blk, po, n, i)
  body(blk: i64, po: i64, n: i64, i: i64):
    %ix = add i64 po, i
    %vid = call i64 poolv(%ix)
    %sh = shl i64 i, 3
    %sa = add i64 46080, %sh
    %v = call i64 mload(%sa)
    call void vs(%vid, %v)
    %i2 = add i64 i, 1
    br loop(blk, po, n, %i2)
  fin():
    ret
}

fn jump_to(i64, i64, i64) -> void {
  entry(blk: i64, off: i64, n: i64):
    call void eval_args(off, n)
    call void fst(8, blk)
    call void write_args(blk)
    call void fst(16, 0)
    ret
}

fn x_br() -> void {
  entry():
    %blk = call i64 ira(72)
    %off = call i64 ira(112)
    %n = call i64 ira(104)
    call void jump_to(%blk, %off, %n)
    ret
}

fn x_condbr() -> void {
  entry():
    %a_id = call i64 ira(32)
    %cv = call i64 vg(%a_id)
    %c = and i64 %cv, 1
    %is = icmp.ne i64 %c, 0
    condbr %is, t(), f()
  t():
    %blk = call i64 ira(72)
    %off = call i64 ira(112)
    %n = call i64 ira(104)
    call void jump_to(%blk, %off, %n)
    ret
  f():
    %blk = call i64 ira(80)
    %off = call i64 ira(128)
    %n = call i64 ira(120)
    call void jump_to(%blk, %off, %n)
    ret
}

fn x_ret() -> void {
  entry():
    %e1 = iconst i64 1
    %a_id = call i64 ira(32)
    %none = icmp.slt i64 %a_id, 0
    condbr %none, nov(), hv(%a_id)
  nov():
    br pop(0)
  hv(a_id: i64):
    %v = call i64 vg(%a_id)
    br pop(%v)
  pop(v: i64):
    %top = call i64 ld64(45864)
    %A = call i64 ld64(45824)
    %foa = add i64 %A, 80
    %fo = call i64 mload(%foa)
    %bot = icmp.eq i64 %top, %fo
    condbr %bot, done(v), up(v)
  done(v: i64):
    call void st64(45848, 1)
    call void st64(45856, v)
    ret
  up(v: i64):
    %rs = call i64 fld(32)
    %rb = call i64 fld(40)
    %rp = call i64 fld(48)
    %vb = call i64 fld(24)
    call void st64(45872, %vb)
    %nt = sub i64 %top, 56
    %top2 = call i64 ld64(45864)
    %nta = sub i64 %top2, 56
    call void st64(45864, %nta)
    call void fst(8, %rb)
    %rp2 = add i64 %rp, 1
    call void fst(16, %rp2)
    %neg = icmp.slt i64 %rs, 0
    condbr %neg, fin(), wr(%rs, v)
  wr(rs: i64, v: i64):
    call void vs(rs, v)
    br fin()
  fin():
    ret
}

; ---- host calls and function calls -------------------------------------

fn host_call(i64) -> i64 {
  entry(xrec: i64):
    %e0 = iconst i64 0
    %e46080 = iconst i64 46080
    %e262144 = iconst i64 262144
    %h16 = add i64 xrec, 16
    %hid = call i64 mload(%h16)
    %is1 = icmp.eq i64 %hid, 1
    condbr %is1, h_print(), n2(%hid)
  h_print():
    %off = call i64 mload(46080)
    %B = call i64 ld64(45832)
    br ploop(%B, %off)
  ploop(B: i64, off: i64):
    %over = icmp.sge i64 off, 262144
    condbr %over, hfin(), pbody(B, off)
  pbody(B: i64, off: i64):
    %a = add i64 B, off
    %c = call i64 mload8(%a)
    %z = icmp.eq i64 %c, 0
    condbr %z, hfin(), pput(B, off, %c)
  pput(B: i64, off: i64, c: i64):
    call void con_putc(c)
    %o2 = add i64 off, 1
    br ploop(B, %o2)
  hfin():
    ret 0
  n2(hid: i64):
    %is2 = icmp.eq i64 hid, 2
    condbr %is2, h_putn(), n3(hid)
  h_putn():
    %v = call i64 mload(46080)
    call void putu(%v)
    ret 0
  n3(hid: i64):
    %is3 = icmp.eq i64 hid, 3
    condbr %is3, h_putc(), n4(hid)
  h_putc():
    %v = call i64 mload(46080)
    call void con_putc(%v)
    ret 0
  n4(hid: i64):
    %is4 = icmp.eq i64 hid, 4
    condbr %is4, h_ticks(), n5(hid)
  h_ticks():
    %v = call i64 ld64(0)
    ret %v
  n5(hid: i64):
    %is5 = icmp.eq i64 hid, 5
    condbr %is5, h_alloc(), n6(hid)
  h_alloc():
    %n = call i64 mload(46080)
    %bump = call i64 ld64(45880)
    %a15 = add i64 %n, 15
    %al = and i64 %a15, -16
    %min = icmp.eq i64 %al, 0
    condbr %min, ha16(%bump), hago(%bump, %al)
  ha16(bump: i64):
    br hago(bump, 16)
  hago(bump: i64, al: i64):
    %nb = add i64 bump, al
    %over = icmp.sgt i64 %nb, 262144
    condbr %over, hneg(), haok(bump, %nb)
  haok(bump: i64, nb: i64):
    call void st64(45880, nb)
    ret bump
  hneg():
    ret -1
  n6(hid: i64):
    ret 0
}

fn x_call() -> void {
  entry():
    %e45824 = iconst i64 45824
    %e32 = iconst i64 32
    %e48 = iconst i64 48
    %e24 = iconst i64 24
    %e3 = iconst i64 3
    %e65536 = iconst i64 65536
    %e45872 = iconst i64 45872
    %e8 = iconst i64 8
    %e16 = iconst i64 16
    %callee = call i64 ira(88)
    %cex = call i64 ira(96)
    %off = call i64 ira(112)
    %n = call i64 ira(104)
    call void eval_args(%off, %n)
    %isx = icmp.ne i64 %cex, 0
    condbr %isx, ext(%callee), fn(%callee, %n)
  ext(x: i64):
    %A = call i64 ld64(45824)
    %xoa = add i64 %A, 136
    %xo = call i64 mload(%xoa)
    %sh = shl i64 x, 5
    %rec = add i64 %A, %xo
    %rec2 = add i64 %rec, %sh
    %r = call i64 host_call(%rec2)
    call void set_res(%r)
    call void adv_pc()
    ret
  fn(f: i64, n: i64):
    %op = call i64 ira(0)
    %tail = icmp.eq i64 %op, 72
    condbr %tail, tail(f, n), push(f, n)
  push(f: i64, n: i64):
    %rec = call i64 funrec(f)
    %b32 = add i64 %rec, 32
    %blk0 = call i64 mload(%b32)
    %n48 = add i64 %rec, 48
    %nv = call i64 mload(%n48)
    %top = call i64 ld64(45864)
    %nt = add i64 %top, 56
    %A = call i64 ld64(45824)
    %foa = add i64 %A, 80
    %fo = call i64 mload(%foa)
    %fend = add i64 %fo, 32768
    %over = icmp.sge i64 %nt, %fend
    condbr %over, f92(), vchk(f, %blk0, %nv, %nt)
  vchk(f: i64, blk0: i64, nv: i64, nt: i64):
    %bump = call i64 ld64(45872)
    %need = add i64 %bump, %nv
    %need8 = shl i64 %nv, 3
    %needb = add i64 %bump, %need8
    %A = call i64 ld64(45824)
    %voa = add i64 %A, 88
    %vo = call i64 mload(%voa)
    %vend = add i64 %vo, 65536
    %over = icmp.sgt i64 %needb, %vend
    condbr %over, f92(), mkframe(f, blk0, nv, nt, %bump)
  mkframe(f: i64, blk0: i64, nv: i64, nt: i64, vb: i64):
    %res = call i64 ira(8)
    %cb = call i64 fld(8)
    %cp = call i64 fld(16)
    call void st64(45864, nt)
    call void fst(0, f)
    call void fst(8, blk0)
    call void fst(16, 0)
    call void fst(24, vb)
    call void fst(32, %res)
    call void fst(40, %cb)
    call void fst(48, %cp)
    %need8 = shl i64 nv, 3
    %nb = add i64 vb, %need8
    call void st64(45872, %nb)
    call void write_args(blk0)
    ret
  tail(f: i64, n: i64):
    %rec = call i64 funrec(f)
    %b32 = add i64 %rec, 32
    %blk0 = call i64 mload(%b32)
    %n48 = add i64 %rec, 48
    %nv = call i64 mload(%n48)
    %vb = call i64 fld(24)
    %need8 = shl i64 %nv, 3
    %needb = add i64 %vb, %need8
    %A = call i64 ld64(45824)
    %voa = add i64 %A, 88
    %vo = call i64 mload(%voa)
    %vend = add i64 %vo, 65536
    %over = icmp.sgt i64 %needb, %vend
    condbr %over, f92(), tgo(f, blk0, nv, vb, %needb)
  tgo(f: i64, blk0: i64, nv: i64, vb: i64, needb: i64):
    %bump = call i64 ld64(45872)
    %grow = icmp.sgt i64 needb, %bump
    condbr %grow, tset(f, blk0, needb), tmk(f, blk0)
  tset(f: i64, blk0: i64, needb: i64):
    call void st64(45872, needb)
    br tmk(f, blk0)
  tmk(f: i64, blk0: i64):
    call void fst(0, f)
    call void write_args(blk0)
    call void fst(8, blk0)
    call void fst(16, 0)
    ret
  f92():
    call void fault(92)
    ret
}

; ---- step and main loop --------------------------------------------------

fn exec_step() -> void {
  entry():
    %e94 = iconst i64 94
    %blk = call i64 fld(8)
    %rec = call i64 blkrec(%blk)
    %pc = call i64 fld(16)
    %i24 = add i64 %rec, 24
    %istart = call i64 mload(%i24)
    %i32 = add i64 %rec, 32
    %nins = call i64 mload(%i32)
    %over = icmp.sge i64 %pc, %nins
    condbr %over, f94(), go(%istart, %pc)
  f94():
    call void fault(94)
    ret
  go(istart: i64, pc: i64):
    %idx = add i64 %istart, %pc
    %A = call i64 ld64(45824)
    %ioa = add i64 %A, 112
    %io = call i64 mload(%ioa)
    %s1 = shl i64 %idx, 7
    %s2 = shl i64 %idx, 4
    %off = add i64 %s1, %s2
    %addr = add i64 %A, %io
    %addr2 = add i64 %addr, %off
    call void st64(45944, %addr2)
    %op = call i64 mload(%addr2)
    br disp(%op)
  disp(op: i64):
    %is1 = icmp.eq i64 op, 1
    condbr %is1, imm(), d2(op)
  imm():
    %v = call i64 ira(56)
    call void set_res(%v)
    call void adv_pc()
    ret
  d2(op: i64):
    %lo = icmp.sge i64 op, 3
    %hi = icmp.sle i64 op, 23
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, alu(op), d3(op)
  alu(op: i64):
    %is3 = icmp.eq i64 op, 3
    condbr %is3, copy(), alugo(op)
  copy():
    %a_id = call i64 ira(32)
    %v = call i64 vg(%a_id)
    call void set_res(%v)
    call void adv_pc()
    ret
  alugo(op: i64):
    call void x_alu()
    ret
  d3(op: i64):
    %lo = icmp.sge i64 op, 24
    %hi = icmp.sle i64 op, 26
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, cvt(), d4(op)
  cvt():
    call void x_cvt()
    ret
  d4(op: i64):
    %lo = icmp.sge i64 op, 27
    %hi = icmp.sle i64 op, 33
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, fp(), d5(op)
  fp():
    call void x_fp()
    ret
  d5(op: i64):
    %is34 = icmp.eq i64 op, 34
    condbr %is34, fcmp(), d6(op)
  fcmp():
    call void x_fcmp()
    ret
  d6(op: i64):
    %lo = icmp.sge i64 op, 35
    %hi = icmp.sle i64 op, 36
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, fconv(), d7(op)
  fconv():
    call void x_fconv()
    ret
  d7(op: i64):
    %lo = icmp.sge i64 op, 37
    %hi = icmp.sle i64 op, 38
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, f2i(), d8(op)
  f2i():
    call void x_f2i()
    ret
  d8(op: i64):
    %lo = icmp.sge i64 op, 39
    %hi = icmp.sle i64 op, 41
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, i2f(op), d9(op)
  i2f(op: i64):
    %is41 = icmp.eq i64 op, 41
    condbr %is41, copy(), i2fgo()
  i2fgo():
    call void x_i2f()
    ret
  d9(op: i64):
    %lo = icmp.sge i64 op, 42
    %hi = icmp.sle i64 op, 48
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, mem(), d10(op)
  mem():
    call void x_mem()
    ret
  d10(op: i64):
    %is68 = icmp.eq i64 op, 68
    condbr %is68, brh(), d11(op)
  brh():
    call void x_br()
    ret
  d11(op: i64):
    %is69 = icmp.eq i64 op, 69
    condbr %is69, cbr(), d12(op)
  cbr():
    call void x_condbr()
    ret
  d12(op: i64):
    %is70 = icmp.eq i64 op, 70
    condbr %is70, reth(), d13(op)
  reth():
    call void x_ret()
    ret
  d13(op: i64):
    %lo = icmp.sge i64 op, 71
    %hi = icmp.sle i64 op, 72
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, callh(), d14(op)
  callh():
    call void x_call()
    ret
  d14(op: i64):
    %is73 = icmp.eq i64 op, 73
    condbr %is73, sel(), d15(op)
  sel():
    call void x_select()
    ret
  d15(op: i64):
    %is74 = icmp.eq i64 op, 74
    condbr %is74, asm(), bad()
  asm():
    call void adv_pc()
    ret
  bad():
    call void fault(94)
    ret
}

fn mod_exec() -> void {
  entry():
    %A = call i64 ld64(45824)
    %mna = add i64 %A, 64
    %mn = call i64 mload(%mna)
    %rec = call i64 funrec(%mn)
    %b32 = add i64 %rec, 32
    %blk0 = call i64 mload(%b32)
    %n48 = add i64 %rec, 48
    %nv = call i64 mload(%n48)
    %foa = add i64 %A, 80
    %fo = call i64 mload(%foa)
    call void st64(45864, %fo)
    call void fst(0, %mn)
    call void fst(8, %blk0)
    call void fst(16, 0)
    %voa = add i64 %A, 88
    %vo = call i64 mload(%voa)
    call void fst(24, %vo)
    call void fst(32, -1)
    %nv8 = shl i64 %nv, 3
    %nb = add i64 %vo, %nv8
    call void st64(45872, %nb)
    %be = call i64 mload(%A)
    %bea = add i64 %A, 72
    %bend = call i64 mload(%bea)
    call void st64(45880, %bend)
    call void st64(45840, 0)
    call void st64(45848, 0)
    br loop()
  loop():
    %st = call i64 ld64(45848)
    %run = icmp.eq i64 %st, 0
    condbr %run, step(), fin()
  step():
    call void exec_step()
    %s = call i64 ld64(45840)
    %s2 = add i64 %s, 1
    call void st64(45840, %s2)
    %over = icmp.sgt i64 %s2, 100000000
    condbr %over, budget(), loop()
  budget():
    call void st64(45848, 2)
    call void st64(45856, 90)
    br loop()
  fin():
    ret
}

; shell: run <index>
fn cmd_run(ptr) -> void {
  entry(rest: ptr):
    %e1 = iconst i64 1
    %e10 = iconst i64 10
    %e45856 = iconst i64 45856
    %p = bitcast i64 rest
    br skipsp(%p)
  skipsp(p: i64):
    %c = call i64 mload8(p)
    %sp = icmp.eq i64 %c, 32
    condbr %sp, next(p), parse(p, 0, 0)
  next(p: i64):
    %p2 = add i64 p, 1
    br skipsp(%p2)
  parse(p: i64, acc: i64, any: i64):
    %c = call i64 mload8(p)
    %lo = icmp.sge i64 %c, 48
    %hi = icmp.sle i64 %c, 57
    %lz = zext i64 %lo
    %hz = zext i64 %hi
    %both = and i64 %lz, %hz
    %is = icmp.ne i64 %both, 0
    condbr %is, dig(p, acc, any), have(acc, any)
  dig(p: i64, acc: i64, any: i64):
    %c = call i64 mload8(p)
    %d = sub i64 %c, 48
    %a10 = mul i64 acc, 10
    %a2 = add i64 %a10, %d
    %p2 = add i64 p, 1
    br parse(%p2, %a2, 1)
  have(acc: i64, any: i64):
    %no = icmp.eq i64 any, 0
    condbr %no, use(), chk(acc)
  use():
    %s = call ptr s_runuse()
    call void con_write(%s)
    ret
  chk(idx: i64):
    %cnt = call i64 ld64(45376)
    %bad = icmp.sge i64 idx, %cnt
    %neg = icmp.slt i64 idx, 0
    %nz = zext i64 %bad
    %nz2 = zext i64 %neg
    %either = or i64 %nz, %nz2
    %is = icmp.ne i64 %either, 0
    condbr %is, nomod(), go(idx)
  nomod():
    %s = call ptr s_runno()
    call void con_write(%s)
    ret
  go(idx: i64):
    %pre = call ptr s_runpre()
    call void con_write(%pre)
    %toff = mul i64 idx, 32
    %tp = add i64 45384, %toff
    %np = add i64 %tp, 16
    %name = call i64 mload(%np)
    %np2 = bitcast ptr %name
    call void con_write(%np2)
    call void con_putc(10)
    call void run_module(idx)
    %st = call i64 ld64(45848)
    %ok = icmp.eq i64 %st, 1
    condbr %ok, ex(), fl()
  ex():
    %s = call ptr s_runexit()
    call void con_write(%s)
    %code = call i64 ld64(45856)
    call void putu(%code)
    call void con_putc(10)
    ret
  fl():
    %s = call ptr s_runfault()
    call void con_write(%s)
    %code = call i64 ld64(45856)
    call void putu(%code)
    call void con_putc(10)
    ret
}

; K0 template part 4: storage. An ATA PIO driver (primary bus,
; 28-bit LBA) and the k0fs filesystem, all in Krell above the
; port I/O services. Disk layout (512-byte sectors):
;   LBA 0       superblock: magic "K0FS", then i64 fields
;               total_sectors +8, dir_start +16, dir_sectors +24,
;               data_start +32, bump +40, file_count +48
;   LBA 1..64   directory: entries of 64 bytes (name 48 bytes
;               NUL-padded, start LBA i64 at +48, length i64
;               at +56; an entry is used iff start != 0)
;   LBA 65..    file data, bump-allocated (an overwrite allocates
;               a new run; the old run is not reclaimed)
; State (arena): 49152 present flag, 49160 total sectors,
;   49168 bump LBA, 49176 file count. Sector buffer at 49664.

fn ata_wait() -> i64 {
  entry():
    %e1 = iconst i64 1
    br loop(0)
  loop(n: i64):
    %st32 = call i32 k_in8(503)
    %st = zext i64 %st32
    %bsy = and i64 %st, 128
    %clr = icmp.eq i64 %bsy, 0
    condbr %clr, chk(%st), spin(n)
  chk(st: i64):
    %err = and i64 %st, 1
    %bad = icmp.ne i64 %err, 0
    condbr %bad, fail(), ok()
  ok():
    ret 0
  fail():
    ret -1
  spin(n: i64):
    %n2 = add i64 n, 1
    %over = icmp.sgt i64 %n2, 4000000
    condbr %over, fail(), loop(%n2)
}

fn ata_drq() -> i64 {
  entry():
    br loop(0)
  loop(n: i64):
    %st32 = call i32 k_in8(503)
    %st = zext i64 %st32
    %err = and i64 %st, 1
    %bad = icmp.ne i64 %err, 0
    condbr %bad, fail(), chk(%st, n)
  chk(st: i64, n: i64):
    %w = and i64 %st, 136
    %rdy = icmp.eq i64 %w, 8
    condbr %rdy, ok(), spin(n)
  ok():
    ret 0
  fail():
    ret -1
  spin(n: i64):
    %n2 = add i64 n, 1
    %over = icmp.sgt i64 %n2, 4000000
    condbr %over, fail(), loop(%n2)
}

fn ata_setup(i64, i32) -> void {
  entry(lba: i64, cmd: i32):
    %h = lshr i64 lba, 24
    %h2 = and i64 %h, 15
    %h3 = or i64 %h2, 224
    %h32 = trunc i32 %h3
    call void k_out8(502, %h32)
    %one = iconst i32 1
    call void k_out8(498, %one)
    %b0 = and i64 lba, 255
    %b0_32 = trunc i32 %b0
    call void k_out8(499, %b0_32)
    %b1 = lshr i64 lba, 8
    %b1b = and i64 %b1, 255
    %b1_32 = trunc i32 %b1b
    call void k_out8(500, %b1_32)
    %b2 = lshr i64 lba, 16
    %b2b = and i64 %b2, 255
    %b2_32 = trunc i32 %b2b
    call void k_out8(501, %b2_32)
    call void k_out8(503, cmd)
    ret
}

fn ata_read1(i64, i64) -> i64 {
  entry(lba: i64, buf: i64):
    %cmd = iconst i32 32
    call void ata_setup(lba, %cmd)
    %w = call i64 ata_drq()
    %bad = icmp.ne i64 %w, 0
    condbr %bad, fail(), rd(buf, 0)
  rd(buf: i64, i: i64):
    %done = icmp.sge i64 i, 256
    condbr %done, ok(), body(buf, i)
  body(buf: i64, i: i64):
    %w32 = call i32 k_in16(496)
    %w = zext i64 %w32
    %lo = and i64 %w, 255
    %a = add i64 buf, i
    %a2 = add i64 %a, i
    call void mstore8(%a2, %lo)
    %hi = lshr i64 %w, 8
    %a3 = add i64 %a2, 1
    call void mstore8(%a3, %hi)
    %i2 = add i64 i, 1
    br rd(buf, %i2)
  ok():
    ret 0
  fail():
    ret -1
}

fn ata_write1(i64, i64) -> i64 {
  entry(lba: i64, buf: i64):
    %cmd = iconst i32 48
    call void ata_setup(lba, %cmd)
    %w = call i64 ata_drq()
    %bad = icmp.ne i64 %w, 0
    condbr %bad, fail(), wr(buf, 0)
  wr(buf: i64, i: i64):
    %done = icmp.sge i64 i, 256
    condbr %done, flush(), body(buf, i)
  body(buf: i64, i: i64):
    %a = add i64 buf, i
    %a2 = add i64 %a, i
    %lo = call i64 mload8(%a2)
    %a3 = add i64 %a2, 1
    %hi = call i64 mload8(%a3)
    %hi8 = shl i64 %hi, 8
    %w = or i64 %lo, %hi8
    %w32 = trunc i32 %w
    call void k_out16(496, %w32)
    %i2 = add i64 i, 1
    br wr(buf, %i2)
  flush():
    %fc = iconst i32 234
    call void k_out8(503, %fc)
    %r = call i64 ata_wait()
    ret %r
  ok():
    ret 0
  fail():
    ret -1
}

fn ata_read(i64, i64, i64) -> i64 {
  entry(lba: i64, n: i64, buf: i64):
    br loop(lba, n, buf, 0)
  loop(lba: i64, n: i64, buf: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, ok(), body(lba, n, buf, i)
  body(lba: i64, n: i64, buf: i64, i: i64):
    %l = add i64 lba, i
    %off = shl i64 i, 9
    %b = add i64 buf, %off
    %r = call i64 ata_read1(%l, %b)
    %bad = icmp.ne i64 %r, 0
    condbr %bad, fail(), next(lba, n, buf, i)
  next(lba: i64, n: i64, buf: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(lba, n, buf, %i2)
  ok():
    ret 0
  fail():
    ret -1
}

fn ata_write(i64, i64, i64) -> i64 {
  entry(lba: i64, n: i64, buf: i64):
    br loop(lba, n, buf, 0)
  loop(lba: i64, n: i64, buf: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, ok(), body(lba, n, buf, i)
  body(lba: i64, n: i64, buf: i64, i: i64):
    %l = add i64 lba, i
    %off = shl i64 i, 9
    %b = add i64 buf, %off
    %r = call i64 ata_write1(%l, %b)
    %bad = icmp.ne i64 %r, 0
    condbr %bad, fail(), next(lba, n, buf, i)
  next(lba: i64, n: i64, buf: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(lba, n, buf, %i2)
  ok():
    ret 0
  fail():
    ret -1
}

fn fs_buf() -> i64 {
  entry():
    %p = call ptr ksf(49664)
    %a = bitcast i64 %p
    ret %a
}

fn fs_init() -> void {
  entry():
    call void st64(49152, 0)
    %st32 = call i32 k_in8(503)
    %st = zext i64 %st32
    %none = icmp.eq i64 %st, 255
    condbr %none, fin(), rd()
  rd():
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(0, %buf)
    %bad = icmp.ne i64 %r, 0
    condbr %bad, fin(), magic(%buf)
  magic(buf: i64):
    %m = call i64 mload32(buf)
    %ok = icmp.eq i64 %m, 1397108811
    condbr %ok, fill(buf), fin()
  fill(buf: i64):
    %a8 = add i64 buf, 8
    %tot = call i64 mload(%a8)
    call void st64(49160, %tot)
    %a40 = add i64 buf, 40
    %bump = call i64 mload(%a40)
    call void st64(49168, %bump)
    %a48 = add i64 buf, 48
    %cnt = call i64 mload(%a48)
    call void st64(49176, %cnt)
    call void st64(49152, 1)
    br fin()
  fin():
    ret
}

fn fs_sync_super() -> void {
  entry():
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(0, %buf)
    %bad = icmp.ne i64 %r, 0
    condbr %bad, fin(), patch(%buf)
  patch(buf: i64):
    %bump = call i64 ld64(49168)
    %a40 = add i64 buf, 40
    call void mstore(%a40, %bump)
    %cnt = call i64 ld64(49176)
    %a48 = add i64 buf, 48
    call void mstore(%a48, %cnt)
    %w = call i64 ata_write1(0, %buf)
    br fin()
  fin():
    ret
}

; name match: token at host address tp with length tl vs the
; NUL-padded 48-byte entry name at host address ep
fn name_match(i64, i64, i64) -> i64 {
  entry(tp: i64, tl: i64, ep: i64):
    %e1 = iconst i64 1
    br loop(tp, tl, ep, 0)
  loop(tp: i64, tl: i64, ep: i64, i: i64):
    %done = icmp.sge i64 i, tl
    condbr %done, tail(ep, tl), body(tp, tl, ep, i)
  body(tp: i64, tl: i64, ep: i64, i: i64):
    %a = add i64 tp, i
    %c1 = call i64 mload8(%a)
    %b = add i64 ep, i
    %c2 = call i64 mload8(%b)
    %eq = icmp.eq i64 %c1, %c2
    condbr %eq, next(tp, tl, ep, i), no()
  next(tp: i64, tl: i64, ep: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(tp, tl, ep, %i2)
  tail(ep: i64, tl: i64):
    %b = add i64 ep, tl
    %c = call i64 mload8(%b)
    %z = icmp.eq i64 %c, 0
    condbr %z, yes(), no()
  yes():
    ret 1
  no():
    ret 0
}

; find a file by name; returns the directory sector LBA in
; 49200 and the slot in 49208, or -1 in 49200 when absent
fn fs_find(i64, i64) -> void {
  entry(tp: i64, tl: i64):
    %e49200 = iconst i64 49200
    br sec(tp, tl, 1)
  sec(tp: i64, tl: i64, lba: i64):
    %over = icmp.sgt i64 lba, 64
    condbr %over, absent(), rd(tp, tl, lba)
  rd(tp: i64, tl: i64, lba: i64):
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(lba, %buf)
    %bad = icmp.ne i64 %r, 0
    condbr %bad, absent(), scan(tp, tl, lba, %buf, 0)
  scan(tp: i64, tl: i64, lba: i64, buf: i64, slot: i64):
    %done = icmp.sge i64 slot, 8
    condbr %done, nextsec(tp, tl, lba), escan(tp, tl, lba, buf, slot)
  escan(tp: i64, tl: i64, lba: i64, buf: i64, slot: i64):
    %off = shl i64 slot, 6
    %ep = add i64 buf, %off
    %sa = add i64 %ep, 48
    %start = call i64 mload(%sa)
    %used = icmp.ne i64 %start, 0
    condbr %used, match(tp, tl, lba, buf, slot, %ep), nextslot(tp, tl, lba, buf, slot)
  match(tp: i64, tl: i64, lba: i64, buf: i64, slot: i64, ep: i64):
    %m = call i64 name_match(tp, tl, ep)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, found(lba, slot), nextslot(tp, tl, lba, buf, slot)
  nextslot(tp: i64, tl: i64, lba: i64, buf: i64, slot: i64):
    %s2 = add i64 slot, 1
    br scan(tp, tl, lba, buf, %s2)
  nextsec(tp: i64, tl: i64, lba: i64):
    %l2 = add i64 lba, 1
    br sec(tp, tl, %l2)
  found(lba: i64, slot: i64):
    call void st64(49200, lba)
    call void st64(49208, slot)
    ret
  absent():
    call void st64(49200, -1)
    ret
}

; find the first free directory slot (same result convention)
fn fs_freeslot() -> void {
  entry():
    %e49200 = iconst i64 49200
    br sec(1)
  sec(lba: i64):
    %over = icmp.sgt i64 lba, 64
    condbr %over, absent(), rd(lba)
  rd(lba: i64):
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(lba, %buf)
    %bad = icmp.ne i64 %r, 0
    condbr %bad, absent(), scan(lba, %buf, 0)
  scan(lba: i64, buf: i64, slot: i64):
    %done = icmp.sge i64 slot, 8
    condbr %done, nextsec(lba), escan(lba, buf, slot)
  escan(lba: i64, buf: i64, slot: i64):
    %off = shl i64 slot, 6
    %ep = add i64 buf, %off
    %sa = add i64 %ep, 48
    %start = call i64 mload(%sa)
    %free = icmp.eq i64 %start, 0
    condbr %free, found(lba, slot), nextslot(lba, buf, slot)
  nextslot(lba: i64, buf: i64, slot: i64):
    %s2 = add i64 slot, 1
    br scan(lba, buf, %s2)
  nextsec(lba: i64):
    %l2 = add i64 lba, 1
    br sec(%l2)
  found(lba: i64, slot: i64):
    call void st64(49200, lba)
    call void st64(49208, slot)
    ret
  absent():
    call void st64(49200, -1)
    ret
}

fn print_name(i64) -> void {
  entry(ep: i64):
    br loop(ep, 0)
  loop(ep: i64, i: i64):
    %over = icmp.sge i64 i, 48
    condbr %over, fin(), body(ep, i)
  body(ep: i64, i: i64):
    %a = add i64 ep, i
    %c = call i64 mload8(%a)
    %z = icmp.eq i64 %c, 0
    condbr %z, fin(), put(ep, i, %c)
  put(ep: i64, i: i64, c: i64):
    call void con_putc(c)
    %i2 = add i64 i, 1
    br loop(ep, %i2)
  fin():
    ret
}

fn cmd_dir() -> void {
  entry():
    %p = call i64 ld64(49152)
    %no = icmp.eq i64 %p, 0
    condbr %no, nodisk(), sec(1)
  nodisk():
    %s = call ptr s_nodisk()
    call void con_write(%s)
    ret
  sec(lba: i64):
    %over = icmp.sgt i64 lba, 64
    condbr %over, fin(), rd(lba)
  rd(lba: i64):
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(lba, %buf)
    %bad = icmp.ne i64 %r, 0
    condbr %bad, nextsec(lba), scan(lba, %buf, 0)
  scan(lba: i64, buf: i64, slot: i64):
    %done = icmp.sge i64 slot, 8
    condbr %done, nextsec(lba), escan(lba, buf, slot)
  escan(lba: i64, buf: i64, slot: i64):
    %off = shl i64 slot, 6
    %ep = add i64 buf, %off
    %sa = add i64 %ep, 48
    %start = call i64 mload(%sa)
    %used = icmp.ne i64 %start, 0
    condbr %used, show(lba, buf, slot, %ep), nextslot(lba, buf, slot)
  show(lba: i64, buf: i64, slot: i64, ep: i64):
    call void print_name(ep)
    call void con_putc(32)
    %la = add i64 ep, 56
    %len = call i64 mload(%la)
    call void putu(%len)
    %s = call ptr s_fsbytes()
    call void con_write(%s)
    br nextslot(lba, buf, slot)
  nextslot(lba: i64, buf: i64, slot: i64):
    %s2 = add i64 slot, 1
    br scan(lba, buf, %s2)
  nextsec(lba: i64):
    %l2 = add i64 lba, 1
    br sec(%l2)
  fin():
    ret
}

; split the rest pointer: first token (name) in 49216 (address)
; and 49224 (length); remainder address in 49232. The rest
; pointer arrives as a ptr; addresses here are host addresses.
fn split_name(ptr) -> void {
  entry(rest: ptr):
    %e32 = iconst i64 32
    %e1 = iconst i64 1
    %p = bitcast i64 rest
    call void st64(49216, %p)
    br scan(%p, %p)
  scan(p: i64, start: i64):
    %c = call i64 mload8(p)
    %end = icmp.eq i64 %c, 0
    condbr %end, have(p, start), sp(p, start, %c)
  sp(p: i64, start: i64, c: i64):
    %is = icmp.eq i64 c, 32
    condbr %is, have(p, start), next(p, start)
  next(p: i64, start: i64):
    %p2 = add i64 p, 1
    br scan(%p2, start)
  have(p: i64, start: i64):
    %tl = sub i64 p, start
    call void st64(49224, %tl)
    br sksp(p)
  sksp(p: i64):
    %c = call i64 mload8(p)
    %is = icmp.eq i64 %c, 32
    condbr %is, adv(p), done(p)
  adv(p: i64):
    %p2 = add i64 p, 1
    br sksp(%p2)
  done(p: i64):
    call void st64(49232, p)
    ret
}

fn cmd_cat(ptr) -> void {
  entry(rest: ptr):
    %e1 = iconst i64 1
    %e49208 = iconst i64 49208
    %p = call i64 ld64(49152)
    %no = icmp.eq i64 %p, 0
    condbr %no, nodisk(), go(rest)
  nodisk():
    %s = call ptr s_nodisk()
    call void con_write(%s)
    ret
  go(rest: ptr):
    call void split_name(rest)
    %tp = call i64 ld64(49216)
    %tl = call i64 ld64(49224)
    call void fs_find(%tp, %tl)
    %lba = call i64 ld64(49200)
    %miss = icmp.slt i64 %lba, 0
    condbr %miss, nofile(), rdsec(%lba)
  nofile():
    %s = call ptr s_catno()
    call void con_write(%s)
    ret
  rdsec(lba: i64):
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(lba, %buf)
    %slot = call i64 ld64(49208)
    %off = shl i64 %slot, 6
    %ep = add i64 %buf, %off
    %sa = add i64 %ep, 48
    %start = call i64 mload(%sa)
    %la = add i64 %ep, 56
    %len = call i64 mload(%la)
    call void st64(49240, %start)
    call void st64(49248, %len)
    br sec(%start, %len, 0)
  sec(start: i64, len: i64, i: i64):
    %off = shl i64 i, 9
    %done = icmp.sge i64 %off, len
    condbr %done, fin(), rd(start, len, i)
  rd(start: i64, len: i64, i: i64):
    %buf = call i64 fs_buf()
    %l = add i64 start, i
    %r = call i64 ata_read1(%l, %buf)
    %off = shl i64 i, 9
    %rem = sub i64 len, %off
    %lt = icmp.slt i64 %rem, 512
    %take = select i64 %lt, %rem, 512
    br emit(%buf, %take, start, len, i)
  emit(buf: i64, take: i64, start: i64, len: i64, i: i64):
    br ploop(buf, take, start, len, i, 0)
  ploop(buf: i64, take: i64, start: i64, len: i64, i: i64, j: i64):
    %done = icmp.sge i64 j, take
    condbr %done, nextsec(start, len, i), pbody(buf, take, start, len, i, j)
  pbody(buf: i64, take: i64, start: i64, len: i64, i: i64, j: i64):
    %a = add i64 buf, j
    %c = call i64 mload8(%a)
    call void con_putc(%c)
    %j2 = add i64 j, 1
    br ploop(buf, take, start, len, i, %j2)
  nextsec(start: i64, len: i64, i: i64):
    %i2 = add i64 i, 1
    br sec(start, len, %i2)
  fin():
    ret
}

fn cmd_store(ptr) -> void {
  entry(rest: ptr):
    %e1 = iconst i64 1
    %e6 = iconst i64 6
    %e48 = iconst i64 48
    %e56 = iconst i64 56
    %e49208 = iconst i64 49208
    %p = call i64 ld64(49152)
    %no = icmp.eq i64 %p, 0
    condbr %no, nodisk(), go(rest)
  nodisk():
    %s = call ptr s_nodisk()
    call void con_write(%s)
    ret
  go(rest: ptr):
    call void split_name(rest)
    %tp = call i64 ld64(49216)
    %tl = call i64 ld64(49224)
    %bad = icmp.eq i64 %tl, 0
    %long = icmp.sgt i64 %tl, 47
    %bz = zext i64 %bad
    %lz = zext i64 %long
    %either = or i64 %bz, %lz
    %is = icmp.ne i64 %either, 0
    condbr %is, usage(), have(%tp, %tl)
  usage():
    %s = call ptr s_storeuse()
    call void con_write(%s)
    ret
  have(tp: i64, tl: i64):
    %txt = call i64 ld64(49232)
    br tlen(%txt, %txt)
  tlen(p: i64, start: i64):
    %c = call i64 mload8(p)
    %z = icmp.eq i64 %c, 0
    condbr %z, sized(start, p), tnext(p, start)
  tnext(p: i64, start: i64):
    %p2 = add i64 p, 1
    br tlen(%p2, start)
  sized(start: i64, end: i64):
    %len = sub i64 end, start
    call void st64(49256, %len)
    %bump = call i64 ld64(49168)
    %bytes = add i64 %len, 511
    %need = lshr i64 %bytes, 9
    %tot = call i64 ld64(49160)
    %after = add i64 %bump, %need
    %full = icmp.sgt i64 %after, %tot
    condbr %full, full(), write(start, %len, %bump, %need)
  full():
    %s = call ptr s_storefull()
    call void con_write(%s)
    ret
  write(start: i64, len: i64, bump: i64, need: i64):
    br wloop(start, len, bump, need, 0)
  wloop(start: i64, len: i64, bump: i64, need: i64, i: i64):
    %done = icmp.sge i64 i, need
    condbr %done, dirent(start, len, bump, need), wsec(start, len, bump, need, i)
  wsec(start: i64, len: i64, bump: i64, need: i64, i: i64):
    %buf = call i64 fs_buf()
    %off = shl i64 i, 9
    %src = add i64 start, %off
    %rem = sub i64 len, %off
    %lt = icmp.slt i64 %rem, 512
    %take = select i64 %lt, %rem, 512
    call void mzero(%buf, 512)
    call void copy_bytes(%buf, %src, %take)
    %l = add i64 bump, i
    %r = call i64 ata_write1(%l, %buf)
    %i2 = add i64 i, 1
    br wloop(start, len, bump, need, %i2)
  dirent(start: i64, len: i64, bump: i64, need: i64):
    %nb = add i64 bump, need
    call void st64(49168, %nb)
    %tp = call i64 ld64(49216)
    %tl = call i64 ld64(49224)
    call void fs_find(%tp, %tl)
    %lba = call i64 ld64(49200)
    %found = icmp.sge i64 %lba, 0
    condbr %found, upd(%lba, len, bump), new(len, bump)
  upd(lba: i64, len: i64, bump: i64):
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(lba, %buf)
    %slot = call i64 ld64(49208)
    %off = shl i64 %slot, 6
    %ep = add i64 %buf, %off
    %sa = add i64 %ep, 48
    call void mstore(%sa, bump)
    %la = add i64 %ep, 56
    call void mstore(%la, len)
    %w = call i64 ata_write1(lba, %buf)
    call void fs_sync_super()
    br fin()
  new(len: i64, bump: i64):
    call void fs_freeslot()
    %lba = call i64 ld64(49200)
    %miss = icmp.slt i64 %lba, 0
    condbr %miss, full(), nent(%lba, len, bump)
  nent(lba: i64, len: i64, bump: i64):
    %buf = call i64 fs_buf()
    %r = call i64 ata_read1(lba, %buf)
    %slot = call i64 ld64(49208)
    %off = shl i64 %slot, 6
    %ep = add i64 %buf, %off
    call void mzero(%ep, 64)
    %tp = call i64 ld64(49216)
    %tl = call i64 ld64(49224)
    call void copy_bytes(%ep, %tp, %tl)
    %sa = add i64 %ep, 48
    call void mstore(%sa, bump)
    %la = add i64 %ep, 56
    call void mstore(%la, len)
    %w = call i64 ata_write1(lba, %buf)
    %cnt = call i64 ld64(49176)
    %cnt2 = add i64 %cnt, 1
    call void st64(49176, %cnt2)
    call void fs_sync_super()
    br fin()
  fin():
    ret
}

; K0 template part 5: display. A framebuffer text console over
; the Multiboot linear framebuffer (32 bpp), in Krell. When a
; framebuffer is present, con_putc routes here instead of the
; VGA text console; the serial mirror is unaffected either way.
; The glyphs are an 8x16 bitmap font (data blob "font", rendered
; by gen_kernel.py from DejaVu Sans Mono, characters 32..127).
; State (arena): 77824 present flag, 77832 address, 77840 pitch,
; 77848 width, 77856 height, 77864 columns, 77872 rows,
; 77880 cursor x, 77888 cursor y. The VGA status row is not
; mirrored here; this console owns the whole framebuffer.

; PCI configuration space access (mechanism 1) and the Bochs
; VBE register interface. The network driver in part 6 uses
; pci_read32 as well.
fn pci_read32(i64, i64) -> i64 {
  entry(dev: i64, reg: i64):
    %a = lshr i64 dev, 0
    %base = iconst i64 2147483648
    %ds = shl i64 dev, 11
    %r = and i64 reg, 252
    %addr = or i64 %base, %ds
    %addr2 = or i64 %addr, %r
    %a32 = trunc i32 %addr2
    call void k_out32(3320, %a32)
    %v = call i32 k_in32(3324)
    %r64 = zext i64 %v
    ret %r64
}

fn vbe_write(i64, i64) -> void {
  entry(idx: i64, val: i64):
    %i32 = trunc i32 idx
    call void k_out16(462, %i32)
    %v32 = trunc i32 val
    call void k_out16(463, %v32)
    ret
}

; QEMU's Multiboot loader does not act on the header video
; request, so when the Multiboot info carries no framebuffer,
; set the mode through the Bochs VBE interface of the standard
; VGA device instead: find it on PCI bus 0 by class, take the
; linear framebuffer address from BAR0, program 1024x768x32.
fn fb_bochs() -> void {
  entry():
    %e1 = iconst i64 1
    br scan(0)
  scan(dev: i64):
    %over = icmp.sge i64 dev, 32
    condbr %over, fin(), probe(dev)
  probe(dev: i64):
    %id = call i64 pci_read32(dev, 0)
    %ven = and i64 %id, 65535
    %none = icmp.eq i64 %ven, 65535
    condbr %none, next(dev), cls(dev)
  cls(dev: i64):
    %c = call i64 pci_read32(dev, 8)
    %cc = lshr i64 %c, 16
    %cc2 = and i64 %cc, 65535
    %vga = icmp.eq i64 %cc2, 768
    condbr %vga, bar(dev), next(dev)
  bar(dev: i64):
    %b = call i64 pci_read32(dev, 16)
    %addr = and i64 %b, -16
    %no = icmp.eq i64 %addr, 0
    condbr %no, next(dev), set(%addr)
  set(addr: i64):
    call void vbe_write(4, 0)
    call void vbe_write(1, 1024)
    call void vbe_write(2, 768)
    call void vbe_write(3, 32)
    %en = iconst i64 65
    call void vbe_write(4, %en)
    call void st64(77832, addr)
    call void st64(77840, 4096)
    call void st64(77848, 1024)
    call void st64(77856, 768)
    call void st64(77864, 128)
    call void st64(77872, 48)
    call void st64(77880, 0)
    call void st64(77888, 0)
    call void st64(77824, 1)
    call void fb_clear()
    br fin()
  next(dev: i64):
    %d2 = add i64 dev, 1
    br scan(%d2)
  fin():
    ret
}

fn fb_init(ptr) -> void {
  entry(mbi: ptr):
    call void st64(77824, 0)
    %mb = bitcast i64 mbi
    %fl = call i64 mload32(%mb)
    %has = and i64 %fl, 4096
    %no = icmp.eq i64 %has, 0
    condbr %no, bochs(), rd(%mb)
  rd(mb: i64):
    %a88 = add i64 mb, 88
    %addr = call i64 mload(%a88)
    %a96 = add i64 mb, 96
    %pitch = call i64 mload32(%a96)
    %a100 = add i64 mb, 100
    %w = call i64 mload32(%a100)
    %a104 = add i64 mb, 104
    %h = call i64 mload32(%a104)
    %a108 = add i64 mb, 108
    %bpp = call i64 mload8(%a108)
    %a109 = add i64 mb, 109
    %ty = call i64 mload8(%a109)
    %okb = icmp.eq i64 %bpp, 32
    %okt = icmp.eq i64 %ty, 1
    %oka = icmp.ne i64 %addr, 0
    %z1 = zext i64 %okb
    %z2 = zext i64 %okt
    %z3 = zext i64 %oka
    %t1 = and i64 %z1, %z2
    %t2 = and i64 %t1, %z3
    %ok = icmp.ne i64 %t2, 0
    condbr %ok, set(%addr, %pitch, %w, %h), bochs()
  bochs():
    call void fb_bochs()
    ret
  set(addr: i64, pitch: i64, w: i64, h: i64):
    call void st64(77832, addr)
    call void st64(77840, pitch)
    call void st64(77848, w)
    call void st64(77856, h)
    %cols = lshr i64 w, 3
    call void st64(77864, %cols)
    %rows = lshr i64 h, 4
    call void st64(77872, %rows)
    call void st64(77880, 0)
    call void st64(77888, 0)
    call void st64(77824, 1)
    call void fb_clear()
    br fin()
  fin():
    ret
}

fn fb_clear() -> void {
  entry():
    %addr = call i64 ld64(77832)
    %pitch = call i64 ld64(77840)
    %h = call i64 ld64(77856)
    %total = mul i64 %pitch, %h
    br loop(%addr, %total, 0)
  loop(addr: i64, total: i64, i: i64):
    %done = icmp.sge i64 i, total
    condbr %done, fin(), body(addr, total, i)
  body(addr: i64, total: i64, i: i64):
    %a = add i64 addr, i
    %z = iconst i32 0
    call void mstore32(%a, %z)
    %i2 = add i64 i, 4
    br loop(addr, total, %i2)
  fin():
    ret
}

fn fb_scroll() -> void {
  entry():
    %addr = call i64 ld64(77832)
    %pitch = call i64 ld64(77840)
    %h = call i64 ld64(77856)
    %rowb = shl i64 %pitch, 4
    %total = mul i64 %pitch, %h
    %move = sub i64 %total, %rowb
    %src = add i64 %addr, %rowb
    br loop(%addr, %src, %move, 0)
  loop(dst: i64, src: i64, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, clr(dst, n), body(dst, src, n, i)
  body(dst: i64, src: i64, n: i64, i: i64):
    %sa = add i64 src, i
    %v = call i64 mload32(%sa)
    %da = add i64 dst, i
    %v32 = trunc i32 %v
    call void mstore32(%da, %v32)
    %i2 = add i64 i, 4
    br loop(dst, src, n, %i2)
  clr(dst: i64, n: i64):
    %pitch = call i64 ld64(77840)
    %rowb = shl i64 %pitch, 4
    %base = add i64 dst, n
    br cloop(%base, %rowb, 0)
  cloop(base: i64, n: i64, i: i64):
    %done = icmp.sge i64 i, n
    condbr %done, fin(), cbody(base, n, i)
  cbody(base: i64, n: i64, i: i64):
    %a = add i64 base, i
    %z = iconst i32 0
    call void mstore32(%a, %z)
    %i2 = add i64 i, 4
    br cloop(base, n, %i2)
  fin():
    ret
}

fn fb_glyph(i64, i64, i64) -> void {
  entry(c: i64, x: i64, y: i64):
    %fp = call ptr s_font()
    %font = bitcast i64 %fp
    %lo = icmp.slt i64 c, 32
    %hi = icmp.sgt i64 c, 126
    %z1 = zext i64 %lo
    %z2 = zext i64 %hi
    %either = or i64 %z1, %z2
    %bad = icmp.ne i64 %either, 0
    condbr %bad, sub(%font, x, y), go(%font, c, x, y)
  sub(font: i64, x: i64, y: i64):
    br go(font, 63, x, y)
  go(font: i64, c: i64, x: i64, y: i64):
    %gi = sub i64 c, 32
    %g16 = shl i64 %gi, 4
    %gbase = add i64 font, %g16
    %addr = call i64 ld64(77832)
    %pitch = call i64 ld64(77840)
    %py = shl i64 y, 4
    %px = shl i64 x, 3
    br loop(%gbase, %addr, %pitch, %py, %px, 0)
  loop(gb: i64, addr: i64, pitch: i64, py: i64, px: i64, i: i64):
    %done = icmp.sge i64 i, 128
    condbr %done, fin(), body(gb, addr, pitch, py, px, i)
  body(gb: i64, addr: i64, pitch: i64, py: i64, px: i64, i: i64):
    %r = lshr i64 i, 3
    %cx = and i64 i, 7
    %ga = add i64 gb, %r
    %bits = call i64 mload8(%ga)
    %sh = sub i64 7, %cx
    %bit = lshr i64 %bits, %sh
    %on = and i64 %bit, 1
    %yy = add i64 py, %r
    %rowoff = mul i64 %yy, pitch
    %xx = add i64 px, %cx
    %off = shl i64 %xx, 2
    %rb = add i64 addr, %rowoff
    %a = add i64 %rb, %off
    %fg = icmp.ne i64 %on, 0
    condbr %fg, lit(%a, gb, addr, pitch, py, px, i), dark(%a, gb, addr, pitch, py, px, i)
  lit(a: i64, gb: i64, addr: i64, pitch: i64, py: i64, px: i64, i: i64):
    %c = iconst i32 11184810
    call void mstore32(%a, %c)
    br adv(gb, addr, pitch, py, px, i)
  dark(a: i64, gb: i64, addr: i64, pitch: i64, py: i64, px: i64, i: i64):
    %c = iconst i32 0
    call void mstore32(%a, %c)
    br adv(gb, addr, pitch, py, px, i)
  adv(gb: i64, addr: i64, pitch: i64, py: i64, px: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(gb, addr, pitch, py, px, %i2)
  fin():
    ret
}

fn fb_putc(i64) -> void {
  entry(c: i64):
    %e77880 = iconst i64 77880
    %e77888 = iconst i64 77888
    %e0 = iconst i64 0
    %e1 = iconst i64 1
    %isn = icmp.eq i64 c, 10
    condbr %isn, nl(), chk(c)
  chk(c: i64):
    %isc = icmp.eq i64 c, 13
    condbr %isc, cr(), chkb(c)
  cr():
    call void st64(77880, 0)
    ret
  chkb(c: i64):
    %isb = icmp.eq i64 c, 8
    condbr %isb, bs(), pr(c)
  bs():
    %x = call i64 ld64(77880)
    %gt = icmp.sgt i64 %x, 0
    condbr %gt, bsgo(%x), fin()
  bsgo(x: i64):
    %x2 = sub i64 %x, 1
    call void st64(77880, %x2)
    %y = call i64 ld64(77888)
    call void fb_glyph(32, %x2, %y)
    br fin()
  nl():
    call void st64(77880, 0)
    %y = call i64 ld64(77888)
    %y2 = add i64 %y, 1
    call void st64(77888, %y2)
    br maybescroll()
  pr(c: i64):
    %x = call i64 ld64(77880)
    %y = call i64 ld64(77888)
    call void fb_glyph(c, %x, %y)
    %x2 = add i64 %x, 1
    %cols = call i64 ld64(77864)
    %wrap = icmp.sge i64 %x2, %cols
    condbr %wrap, wrap(), adv(%x2)
  adv(x: i64):
    call void st64(77880, x)
    br fin()
  wrap():
    call void st64(77880, 0)
    %y = call i64 ld64(77888)
    %y2 = add i64 %y, 1
    call void st64(77888, %y2)
    br maybescroll()
  maybescroll():
    %y = call i64 ld64(77888)
    %rows = call i64 ld64(77872)
    %over = icmp.sge i64 %y, %rows
    condbr %over, doscroll(), fin()
  doscroll():
    call void fb_scroll()
    %rows = call i64 ld64(77872)
    %y = sub i64 %rows, 1
    call void st64(77888, %y)
    br fin()
  fin():
    ret
}

; K0 template part 6: network. A polling driver for the Intel
; 82540EM (QEMU e1000) on PCI, plus ARP and ICMP, all in Krell.
; Addresses: our IP is 10.0.2.15, the gateway is 10.0.2.2 (the
; QEMU user-network addresses). No interrupts: the shell polls.
; State (arena): 53248 present, 53256 MMIO base, 53264 MAC
; (6 bytes), 53272 our IP (4 bytes), 53280 gateway IP (4 bytes),
; 53288 rx index, 53296 tx index, 53304 gateway MAC (6 bytes),
; 53312 gateway known flag, 53320 echo reply flag,
; 53328 echo reply sequence. Rings (arena): rx descriptors
; 53504 (8 x 16 bytes), tx descriptors 53760 (8 x 16 bytes).
; Buffers (arena): rx 57344 (8 x 2048), tx staging 73728 (2048).
; Descriptor and buffer addresses handed to the device are
; arena addresses, which are physical (identity mapping).

fn pci_write32(i64, i64, i64) -> void {
  entry(dev: i64, reg: i64, val: i64):
    %base = iconst i64 2147483648
    %ds = shl i64 dev, 11
    %r = and i64 reg, 252
    %addr = or i64 %base, %ds
    %addr2 = or i64 %addr, %r
    %a32 = trunc i32 %addr2
    call void k_out32(3320, %a32)
    %v32 = trunc i32 val
    call void k_out32(3324, %v32)
    ret
}

fn nr(i64) -> i64 {
  entry(off: i64):
    %base = call i64 ld64(53256)
    %a = add i64 %base, off
    %v = call i64 mload32(%a)
    ret %v
}

fn nw(i64, i64) -> void {
  entry(off: i64, val: i64):
    %base = call i64 ld64(53256)
    %a = add i64 %base, off
    %v32 = trunc i32 val
    call void mstore32(%a, %v32)
    ret
}

fn ring_rx() -> i64 {
  entry():
    %p = call ptr ksf(53504)
    %a = bitcast i64 %p
    ret %a
}

fn ring_tx() -> i64 {
  entry():
    %p = call ptr ksf(53760)
    %a = bitcast i64 %p
    ret %a
}

fn rxbuf(i64) -> i64 {
  entry(i: i64):
    %off = shl i64 i, 11
    %o2 = add i64 57344, %off
    %p = call ptr ksf(%o2)
    %a = bitcast i64 %p
    ret %a
}

fn txbuf() -> i64 {
  entry():
    %p = call ptr ksf(73728)
    %a = bitcast i64 %p
    ret %a
}

fn bput16(i64, i64, i64) -> void {
  entry(buf: i64, off: i64, v: i64):
    %a = add i64 buf, off
    %hi = lshr i64 v, 8
    %hi8 = and i64 %hi, 255
    call void mstore8(%a, %hi8)
    %a2 = add i64 %a, 1
    %lo = and i64 v, 255
    call void mstore8(%a2, %lo)
    ret
}

fn bget16(i64, i64) -> i64 {
  entry(buf: i64, off: i64):
    %a = add i64 buf, off
    %hi = call i64 mload8(%a)
    %a2 = add i64 %a, 1
    %lo = call i64 mload8(%a2)
    %h8 = shl i64 %hi, 8
    %r = or i64 %h8, %lo
    ret %r
}

fn copy_ip(i64, i64, i64) -> void {
  entry(dst: i64, doff: i64, src: i64):
    br loop(dst, doff, src, 0)
  loop(dst: i64, doff: i64, src: i64, i: i64):
    %done = icmp.sge i64 i, 4
    condbr %done, fin(), body(dst, doff, src, i)
  body(dst: i64, doff: i64, src: i64, i: i64):
    %sa = add i64 src, i
    %v = call i64 mload8(%sa)
    %da = add i64 dst, doff
    %da2 = add i64 %da, i
    call void mstore8(%da2, %v)
    %i2 = add i64 i, 1
    br loop(dst, doff, src, %i2)
  fin():
    ret
}

fn ip_is(i64, i64, i64) -> i64 {
  entry(buf: i64, off: i64, addr: i64):
    %e1 = iconst i64 1
    br loop(buf, off, addr, 0)
  loop(buf: i64, off: i64, addr: i64, i: i64):
    %done = icmp.sge i64 i, 4
    condbr %done, yes(), body(buf, off, addr, i)
  body(buf: i64, off: i64, addr: i64, i: i64):
    %a = add i64 buf, off
    %a2 = add i64 %a, i
    %c1 = call i64 mload8(%a2)
    %b = add i64 addr, i
    %c2 = call i64 mload8(%b)
    %eq = icmp.eq i64 %c1, %c2
    condbr %eq, next(buf, off, addr, i), no()
  next(buf: i64, off: i64, addr: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(buf, off, addr, %i2)
  yes():
    ret 1
  no():
    ret 0
}

fn ip_sum(i64, i64) -> i64 {
  entry(buf: i64, len: i64):
    br loop(buf, len, 0, 0)
  loop(buf: i64, len: i64, i: i64, acc: i64):
    %done = icmp.sge i64 i, len
    condbr %done, fold(acc), body(buf, len, i, acc)
  body(buf: i64, len: i64, i: i64, acc: i64):
    %w = call i64 bget16(buf, i)
    %a2 = add i64 acc, %w
    %i2 = add i64 i, 2
    br loop(buf, len, %i2, %a2)
  fold(acc: i64):
    %hi = lshr i64 acc, 16
    %lo = and i64 acc, 65535
    %s = add i64 %hi, %lo
    %hi2 = lshr i64 %s, 16
    %lo2 = and i64 %s, 65535
    %s2 = add i64 %hi2, %lo2
    %r = xor i64 %s2, 65535
    ret %r
}

fn putx2(i64) -> void {
  entry(v: i64):
    %hi = lshr i64 v, 4
    %h2 = and i64 %hi, 15
    %lo = and i64 v, 15
    br d1(%h2, %lo)
  d1(h: i64, l: i64):
    %c = call i64 hexch(h)
    call void con_putc(%c)
    %c2 = call i64 hexch(l)
    call void con_putc(%c2)
    ret
}

fn hexch(i64) -> i64 {
  entry(v: i64):
    %lt = icmp.slt i64 v, 10
    condbr %lt, dig(v), let(v)
  dig(v: i64):
    %r = add i64 v, 48
    ret %r
  let(v: i64):
    %r = add i64 v, 87
    ret %r
}

fn print_mac(i64) -> void {
  entry(addr: i64):
    br loop(addr, 0)
  loop(addr: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, fin(), body(addr, i)
  body(addr: i64, i: i64):
    %a = add i64 addr, i
    %b = call i64 mload8(%a)
    call void putx2(%b)
    %last = icmp.slt i64 i, 5
    condbr %last, colon(addr, i), next(addr, i)
  colon(addr: i64, i: i64):
    call void con_putc(58)
    br next(addr, i)
  next(addr: i64, i: i64):
    %i2 = add i64 i, 1
    br loop(addr, %i2)
  fin():
    ret
}

fn net_init() -> void {
  entry():
    %e1 = iconst i64 1
    %e2 = iconst i64 2
    call void st64(53248, 0)
    call void st64(53312, 0)
    call void st64(53320, 0)
    br scan(0)
  scan(dev: i64):
    %over = icmp.sge i64 dev, 32
    condbr %over, fin(), probe(dev)
  probe(dev: i64):
    %id = call i64 pci_read32(dev, 0)
    %ven = and i64 %id, 65535
    %devid = lshr i64 %id, 16
    %okv = icmp.eq i64 %ven, 32902
    %okd = icmp.eq i64 %devid, 4110
    %z1 = zext i64 %okv
    %z2 = zext i64 %okd
    %both = and i64 %z1, %z2
    %hit = icmp.ne i64 %both, 0
    condbr %hit, found(dev), next(dev)
  next(dev: i64):
    %d2 = add i64 dev, 1
    br scan(%d2)
  found(dev: i64):
    %cmd0 = call i64 pci_read32(dev, 4)
    %cmd1 = or i64 %cmd0, 6
    call void pci_write32(dev, 4, %cmd1)
    %b = call i64 pci_read32(dev, 16)
    %mmio = and i64 %b, -16
    %no = icmp.eq i64 %mmio, 0
    condbr %no, fin(), setup(%mmio)
  setup(mmio: i64):
    call void st64(53256, mmio)
    %ctl = call i64 nr(0)
    %rst = or i64 %ctl, 67108864
    call void nw(0, %rst)
    br wait1(0)
  wait1(n: i64):
    %done = icmp.sge i64 n, 100000
    condbr %done, cfg(), spin(n)
  spin(n: i64):
    %n2 = add i64 n, 1
    br wait1(%n2)
  cfg():
    call void nw(208, 0)
    %ctl = call i64 nr(0)
    %c2 = or i64 %ctl, 96
    %c3 = and i64 %c2, -67108865
    call void nw(0, %c3)
    br mta(0)
  mta(i: i64):
    %done = icmp.sge i64 i, 128
    condbr %done, mac(), mbody(i)
  mbody(i: i64):
    %off = shl i64 i, 2
    %o2 = add i64 20992, %off
    call void nw(%o2, 0)
    %i2 = add i64 i, 1
    br mta(%i2)
  mac():
    %ral = call i64 nr(21504)
    %rah = call i64 nr(21508)
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %ma = add i64 %bp, 53264
    call void st64(53264, %ral)
    %ma4 = add i64 %bp, 53268
    %rah32 = trunc i32 %rah
    call void mstore32(%ma4, %rah32)
    %rah2 = or i64 %rah, 2147483648
    call void nw(21508, %rah2)
    %ip = add i64 %bp, 53272
    call void mstore8(%ip, 10)
    %ip1 = add i64 %ip, 1
    call void mstore8(%ip1, 0)
    %ip2 = add i64 %ip, 2
    call void mstore8(%ip2, 2)
    %ip3 = add i64 %ip, 3
    call void mstore8(%ip3, 15)
    %gw = add i64 %bp, 53280
    call void mstore8(%gw, 10)
    %gw1 = add i64 %gw, 1
    call void mstore8(%gw1, 0)
    %gw2 = add i64 %gw, 2
    call void mstore8(%gw2, 2)
    %gw3 = add i64 %gw, 3
    call void mstore8(%gw3, 2)
    br rxsetup()
  rxsetup():
    %ring = call i64 ring_rx()
    call void mzero(%ring, 256)
    br rfill(0)
  rfill(i: i64):
    %done = icmp.sge i64 i, 8
    condbr %done, rxregs(), rbody(i)
  rbody(i: i64):
    %ring = call i64 ring_rx()
    %off = shl i64 i, 4
    %d = add i64 %ring, %off
    %buf = call i64 rxbuf(i)
    call void mstore(%d, %buf)
    %i2 = add i64 i, 1
    br rfill(%i2)
  rxregs():
    %ring = call i64 ring_rx()
    %lo = and i64 %ring, 4294967295
    %hi = lshr i64 %ring, 32
    call void nw(10240, %lo)
    call void nw(10244, %hi)
    call void nw(10248, 128)
    call void nw(10256, 0)
    call void nw(10264, 7)
    br txsetup()
  txsetup():
    %ring = call i64 ring_tx()
    call void mzero(%ring, 256)
    %lo = and i64 %ring, 4294967295
    %hi = lshr i64 %ring, 32
    call void nw(14336, %lo)
    call void nw(14340, %hi)
    call void nw(14344, 128)
    call void nw(14352, 0)
    call void nw(14360, 0)
    call void nw(1040, 6299914)
    call void nw(1024, 262394)
    call void nw(256, 32770)
    call void st64(53288, 0)
    call void st64(53296, 0)
    call void st64(53248, 1)
    br fin()
  fin():
    ret
}

fn net_send(i64) -> void {
  entry(len: i64):
    %idx = call i64 ld64(53296)
    %ring = call i64 ring_tx()
    %off = shl i64 %idx, 4
    %d = add i64 %ring, %off
    %buf = call i64 txbuf()
    call void mstore(%d, %buf)
    %cmd = shl i64 11, 24
    %rec = or i64 len, %cmd
    %d8 = add i64 %d, 8
    call void mstore(%d8, %rec)
    %nt = add i64 %idx, 1
    %nt2 = and i64 %nt, 7
    call void st64(53296, %nt2)
    call void nw(14360, %nt2)
    br poll(%d, 0)
  poll(d: i64, n: i64):
    %a = add i64 d, 12
    %st = call i64 mload8(%a)
    %dd = and i64 %st, 1
    %done = icmp.ne i64 %dd, 0
    condbr %done, fin(), spin(d, n)
  spin(d: i64, n: i64):
    %n2 = add i64 n, 1
    %over = icmp.sgt i64 %n2, 2000000
    condbr %over, fin(), poll(d, %n2)
  fin():
    ret
}

fn eth_write(i64, i64, i64) -> void {
  entry(buf: i64, dst: i64, ty: i64):
    %e1 = iconst i64 1
    br mloop(buf, dst, 0)
  mloop(buf: i64, dst: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, src(buf, ty, 0), mbody(buf, dst, i)
  mbody(buf: i64, dst: i64, i: i64):
    %a = add i64 dst, i
    %v = call i64 mload8(%a)
    %da = add i64 buf, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br mloop(buf, dst, %i2)
  src(buf: i64, ty: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, typ(buf, ty), sbody(buf, ty, i)
  sbody(buf: i64, ty: i64, i: i64):
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %ma = add i64 %bp, 53264
    %a = add i64 %ma, i
    %v = call i64 mload8(%a)
    %d6 = add i64 buf, 6
    %da = add i64 %d6, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br src(buf, ty, %i2)
  typ(buf: i64, ty: i64):
    call void bput16(buf, 12, ty)
    ret
}

fn net_poll() -> void {
  entry():
    br loop()
  loop():
    %idx = call i64 ld64(53288)
    %ring = call i64 ring_rx()
    %off = shl i64 %idx, 4
    %d = add i64 %ring, %off
    %sa = add i64 %d, 12
    %st = call i64 mload8(%sa)
    %dd = and i64 %st, 1
    %has = icmp.ne i64 %dd, 0
    condbr %has, handle(%d, %idx), fin()
  handle(d: i64, idx: i64):
    %l8 = add i64 d, 8
    %lo = call i64 mload8(%l8)
    %l9 = add i64 d, 9
    %hi = call i64 mload8(%l9)
    %h8 = shl i64 %hi, 8
    %len = or i64 %lo, %h8
    %buf = call i64 rxbuf(idx)
    call void handle_pkt(%buf, %len)
    %sa = add i64 d, 12
    call void mstore8(%sa, 0)
    call void nw(10264, idx)
    %n2 = add i64 idx, 1
    %n3 = and i64 %n2, 7
    call void st64(53288, %n3)
    br loop()
  fin():
    ret
}

fn handle_pkt(i64, i64) -> void {
  entry(buf: i64, len: i64):
    %e22 = iconst i64 22
    %e2048 = iconst i64 2048
    %e6 = iconst i64 6
    %e2 = iconst i64 2
    %e28 = iconst i64 28
    %e53272 = iconst i64 53272
    %e0 = iconst i64 0
    %e1 = iconst i64 1
    %ty = call i64 bget16(buf, 12)
    %arp = icmp.eq i64 %ty, 2054
    condbr %arp, isarp(buf, len), chk4(buf, len, %ty)
  chk4(buf: i64, len: i64, ty: i64):
    %ip4 = icmp.eq i64 ty, 2048
    condbr %ip4, isip(buf, len), fin()
  fin():
    ret
  isarp(buf: i64, len: i64):
    %short = icmp.slt i64 len, 42
    condbr %short, fin(), arp(buf, len)
  arp(buf: i64, len: i64):
    %op = call i64 bget16(buf, 20)
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %ours = add i64 %bp, 53272
    %tip = add i64 buf, 38
    %forus = call i64 ip_is(%tip, 0, %ours)
    %is1 = icmp.eq i64 %op, 1
    %z2 = zext i64 %is1
    %both = and i64 %forus, %z2
    %req = icmp.ne i64 %both, 0
    condbr %req, reply(buf), chk2(buf, %op)
  chk2(buf: i64, op: i64):
    %is2 = icmp.eq i64 op, 2
    condbr %is2, learn(buf), fin()
  learn(buf: i64):
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %gw = add i64 %bp, 53280
    %sip = add i64 buf, 28
    %fromgw = call i64 ip_is(%sip, 0, %gw)
    %yes = icmp.ne i64 %fromgw, 0
    condbr %yes, save(buf), fin()
  save(buf: i64):
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %gm = add i64 %bp, 53304
    br sloop(buf, %gm, 0)
  sloop(buf: i64, gm: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, sfin(), sbody(buf, gm, i)
  sbody(buf: i64, gm: i64, i: i64):
    %sa = add i64 buf, 22
    %a = add i64 %sa, i
    %v = call i64 mload8(%a)
    %da = add i64 gm, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br sloop(buf, gm, %i2)
  sfin():
    call void st64(53312, 1)
    ret
  reply(buf: i64):
    %tx = call i64 txbuf()
    %smac = add i64 buf, 22
    call void eth_write(%tx, %smac, 2054)
    call void bput16(%tx, 14, 1)
    call void bput16(%tx, 16, 2048)
    %a18 = add i64 %tx, 18
    call void mstore8(%a18, 6)
    %a19 = add i64 %tx, 19
    call void mstore8(%a19, 4)
    call void bput16(%tx, 20, 2)
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %ma = add i64 %bp, 53264
    br cp1(%tx, %ma, buf)
  cp1(tx: i64, ma: i64, buf: i64):
    br m1(tx, ma, 0)
  m1(tx: i64, ma: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, cp2(tx, buf), m1b(tx, ma, i)
  m1b(tx: i64, ma: i64, i: i64):
    %a = add i64 ma, i
    %v = call i64 mload8(%a)
    %d = add i64 tx, 22
    %da = add i64 %d, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br m1(tx, ma, %i2)
  cp2(tx: i64, buf: i64):
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %ours = add i64 %bp, 53272
    call void copy_ip(%tx, 28, %ours)
    %smac = add i64 buf, 22
    br m2(tx, %smac, 0)
  m2(tx: i64, smac: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, cp3(tx, buf), m2b(tx, smac, i)
  m2b(tx: i64, smac: i64, i: i64):
    %a = add i64 smac, i
    %v = call i64 mload8(%a)
    %d = add i64 tx, 32
    %da = add i64 %d, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br m2(tx, smac, %i2)
  cp3(tx: i64, buf: i64):
    %sip = add i64 buf, 28
    call void copy_ip(%tx, 38, %sip)
    call void net_send(60)
    ret
  isip(buf: i64, len: i64):
    %short = icmp.slt i64 len, 34
    condbr %short, fin(), ip(buf, len)
  ip(buf: i64, len: i64):
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %ours = add i64 %bp, 53272
    %dip = add i64 buf, 30
    %forus = call i64 ip_is(%dip, 0, %ours)
    %no = icmp.eq i64 %forus, 0
    condbr %no, fin(), proto(buf, len)
  proto(buf: i64, len: i64):
    %a = add i64 buf, 23
    %pr = call i64 mload8(%a)
    %icmp = icmp.eq i64 %pr, 1
    condbr %icmp, icmp(buf, len), fin()
  icmp(buf: i64, len: i64):
    call void icmp_handle(buf, len)
    ret
}

fn ours() -> i64 {
  entry():
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %r = add i64 %bp, 53272
    ret %r
}

fn gwip() -> i64 {
  entry():
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %r = add i64 %bp, 53280
    ret %r
}

fn gwmac() -> i64 {
  entry():
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %r = add i64 %bp, 53304
    ret %r
}

fn ourmac() -> i64 {
  entry():
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %r = add i64 %bp, 53264
    ret %r
}

fn icmp_handle(i64, i64) -> void {
  entry(buf: i64, len: i64):
    %e6 = iconst i64 6
    %e0 = iconst i64 0
    %e1 = iconst i64 1
    %b14 = add i64 buf, 14
    %b = call i64 mload8(%b14)
    %ihl4 = and i64 %b, 15
    %ihl = shl i64 %ihl4, 2
    %ioff = add i64 %ihl, 14
    %ia = add i64 buf, %ioff
    %ty = call i64 mload8(%ia)
    %is8 = icmp.eq i64 %ty, 8
    condbr %is8, echo(buf, len, %ioff), chk0(buf, len, %ioff, %ty)
  chk0(buf: i64, len: i64, ioff: i64, ty: i64):
    %is0 = icmp.eq i64 ty, 0
    condbr %is0, got(buf, ioff), fin()
  got(buf: i64, ioff: i64):
    %o6 = add i64 ioff, 6
    %sq = call i64 bget16(buf, %o6)
    call void st64(53328, %sq)
    call void st64(53320, 1)
    ret
  echo(buf: i64, len: i64, ioff: i64):
    %tx = call i64 txbuf()
    call void copy_bytes(%tx, buf, len)
    %smac = add i64 buf, 6
    call void eth_write(%tx, %smac, 2048)
    %sip = add i64 buf, 26
    call void copy_ip(%tx, 30, %sip)
    %our = call i64 ours()
    call void copy_ip(%tx, 26, %our)
    %ia = add i64 %tx, ioff
    call void mstore8(%ia, 0)
    %ck = add i64 %ia, 2
    call void mstore8(%ck, 0)
    %ck2 = add i64 %ck, 1
    call void mstore8(%ck2, 0)
    %ilen = sub i64 len, ioff
    %sum = call i64 ip_sum(%ia, %ilen)
    %o2 = add i64 ioff, 2
    call void bput16(%tx, %o2, %sum)
    %hck = add i64 %tx, 24
    call void mstore8(%hck, 0)
    %hck2 = add i64 %hck, 1
    call void mstore8(%hck2, 0)
    %ihl = sub i64 ioff, 14
    %h14 = add i64 %tx, 14
    %hsum = call i64 ip_sum(%h14, %ihl)
    call void bput16(%tx, 24, %hsum)
    %mlt = icmp.slt i64 len, 60
    %slen = select i64 %mlt, 60, len
    call void net_send(%slen)
    ret
  fin():
    ret
}

fn arp_ask() -> void {
  entry():
    %e1 = iconst i64 1
    %tx = call i64 txbuf()
    call void mzero(%tx, 64)
    br ff(%tx, 0)
  ff(tx: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, hdr(tx), ffb(tx, i)
  ffb(tx: i64, i: i64):
    %a = add i64 tx, i
    call void mstore8(%a, 255)
    %i2 = add i64 i, 1
    br ff(tx, %i2)
  hdr(tx: i64):
    %ma = call i64 ourmac()
    br sm(tx, %ma, 0)
  sm(tx: i64, ma: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, typ(tx), smb(tx, ma, i)
  smb(tx: i64, ma: i64, i: i64):
    %a = add i64 ma, i
    %v = call i64 mload8(%a)
    %d = add i64 tx, 6
    %da = add i64 %d, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br sm(tx, ma, %i2)
  typ(tx: i64):
    call void bput16(tx, 12, 2054)
    call void bput16(tx, 14, 1)
    call void bput16(tx, 16, 2048)
    %a18 = add i64 tx, 18
    call void mstore8(%a18, 6)
    %a19 = add i64 tx, 19
    call void mstore8(%a19, 4)
    call void bput16(tx, 20, 1)
    %ma = call i64 ourmac()
    br sm2(tx, %ma, 0)
  sm2(tx: i64, ma: i64, i: i64):
    %done = icmp.sge i64 i, 6
    condbr %done, ips(tx), sm2b(tx, ma, i)
  sm2b(tx: i64, ma: i64, i: i64):
    %a = add i64 ma, i
    %v = call i64 mload8(%a)
    %d = add i64 tx, 22
    %da = add i64 %d, i
    call void mstore8(%da, %v)
    %i2 = add i64 i, 1
    br sm2(tx, ma, %i2)
  ips(tx: i64):
    %our = call i64 ours()
    call void copy_ip(tx, 28, %our)
    %gw = call i64 gwip()
    call void copy_ip(tx, 38, %gw)
    call void net_send(60)
    ret
}

fn echo_ask() -> void {
  entry():
    %tx = call i64 txbuf()
    call void mzero(%tx, 64)
    %gm = call i64 gwmac()
    call void eth_write(%tx, %gm, 2048)
    %a14 = add i64 %tx, 14
    call void mstore8(%a14, 69)
    call void bput16(%tx, 16, 36)
    call void bput16(%tx, 18, 1)
    call void bput16(%tx, 20, 0)
    %a22 = add i64 %tx, 22
    call void mstore8(%a22, 64)
    %a23 = add i64 %tx, 23
    call void mstore8(%a23, 1)
    %our = call i64 ours()
    call void copy_ip(%tx, 26, %our)
    %gw = call i64 gwip()
    call void copy_ip(%tx, 30, %gw)
    %hsum = call i64 ip_sum(%a14, 20)
    call void bput16(%tx, 24, %hsum)
    %a34 = add i64 %tx, 34
    call void mstore8(%a34, 8)
    call void bput16(%tx, 38, 19792)
    call void bput16(%tx, 40, 1)
    %d = add i64 %tx, 42
    call void mstore8(%d, 107)
    %d1 = add i64 %d, 1
    call void mstore8(%d1, 48)
    %d2 = add i64 %d, 2
    call void mstore8(%d2, 45)
    %d3 = add i64 %d, 3
    call void mstore8(%d3, 112)
    %d4 = add i64 %d, 4
    call void mstore8(%d4, 105)
    %d5 = add i64 %d, 5
    call void mstore8(%d5, 110)
    %d6 = add i64 %d, 6
    call void mstore8(%d6, 103)
    %d7 = add i64 %d, 7
    call void mstore8(%d7, 33)
    br sum(%tx)
  sum(tx: i64):
    %a34 = add i64 tx, 34
    %isum = call i64 ip_sum(%a34, 16)
    call void bput16(tx, 36, %isum)
    call void net_send(60)
    ret
}

fn cmd_ping() -> void {
  entry():
    %e250 = iconst i64 250
    %p = call i64 ld64(53248)
    %no = icmp.eq i64 %p, 0
    condbr %no, nonet(), go()
  nonet():
    %s = call ptr s_netno()
    call void con_write(%s)
    ret
  go():
    call void net_poll()
    %known = call i64 ld64(53312)
    %yes = icmp.ne i64 %known, 0
    condbr %yes, send(), ask()
  ask():
    call void arp_ask()
    %t0 = call i64 ld64(0)
    br await(%t0)
  await(t0: i64):
    call void net_poll()
    %known = call i64 ld64(53312)
    %yes = icmp.ne i64 %known, 0
    condbr %yes, send(), tick(t0)
  tick(t0: i64):
    %now = call i64 ld64(0)
    %el = sub i64 %now, t0
    %over = icmp.sgt i64 %el, 250
    condbr %over, noreply(), await(t0)
  send():
    call void st64(53320, 0)
    call void echo_ask()
    %t0 = call i64 ld64(0)
    br await2(%t0)
  await2(t0: i64):
    call void net_poll()
    %got = call i64 ld64(53320)
    %yes = icmp.ne i64 %got, 0
    condbr %yes, reply(), tick2(t0)
  tick2(t0: i64):
    %now = call i64 ld64(0)
    %el = sub i64 %now, t0
    %over = icmp.sgt i64 %el, 250
    condbr %over, noreply(), await2(t0)
  reply():
    %s = call ptr s_pingok()
    call void con_write(%s)
    ret
  noreply():
    %s = call ptr s_pingno()
    call void con_write(%s)
    ret
}
fn exec_line() -> void {
  entry():
    %e1 = iconst i64 1
    %w = call i64 ld64(528)
    %w2 = add i64 %w, 1
    call void st64(528, %w2)
    %line = call ptr ksf(304)
    %len = call i64 ld64(464)
    %e = gep i8 %line, %len
    store i8 %e, 0
    br find(%line, %len, 0)
  find(line: ptr, len: i64, i: i64):
    %done = icmp.sge i64 i, len
    condbr %done, whole(line, len), body(line, len, i)
  body(line: ptr, len: i64, i: i64):
    %a = gep i8 line, i
    %b = load i8, %a
    %sp = icmp.eq i8 %b, 32
    condbr %sp, split(line, len, i), next(line, len, i)
  next(line: ptr, len: i64, i: i64):
    %i2 = add i64 i, 1
    br find(line, len, %i2)
  whole(line: ptr, len: i64):
    %rest = gep i8 line, len
    br disp(line, len, %rest)
  split(line: ptr, len: i64, i: i64):
    %r0 = add i64 i, 1
    %rest = gep i8 line, %r0
    br disp(line, i, %rest)
  disp(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_chelp()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dohelp(), d2(line, wlen, rest)
  dohelp():
    call void cmd_help()
    ret
  d2(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cabout()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doabout(), d3(line, wlen, rest)
  doabout():
    call void cmd_about()
    ret
  d3(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cmem()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, domem(), d4(line, wlen, rest)
  domem():
    call void cmd_mem()
    ret
  d4(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cticks()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doticks(), d5(line, wlen, rest)
  doticks():
    call void cmd_ticks()
    ret
  d5(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cps()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dops(), d6(line, wlen, rest)
  dops():
    call void cmd_ps()
    ret
  d6(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_calloc()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doalloc(), d7(line, wlen, rest)
  doalloc():
    call void cmd_alloc()
    ret
  d7(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cfree()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dofree(), d8(line, wlen, rest)
  dofree():
    call void cmd_free()
    ret
  d8(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cclear()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doclear(), d9(line, wlen, rest)
  doclear():
    call void cmd_clear()
    ret
  d9(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cecho()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doecho(rest), d10(line, wlen, rest)
  doecho(rest: ptr):
    call void cmd_echo(rest)
    ret
  d10(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cheap()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doheap(), d11(line, wlen, rest)
  doheap():
    call void cmd_heap()
    ret
  d11(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_chtest()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dohtest(), d12(line, wlen, rest)
  dohtest():
    call void cmd_htest()
    ret
  d12(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cmods()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, domods(), d13(line, wlen, rest)
  domods():
    call void cmd_mods()
    ret
  d13(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_crun()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dorun(rest), d14(line, wlen, rest)
  dorun(rest: ptr):
    call void cmd_run(rest)
    ret
  d14(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cdir()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dodir(), d15(line, wlen, rest)
  dodir():
    call void cmd_dir()
    ret
  d15(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_ccat()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, docat(rest), d16(line, wlen, rest)
  docat(rest: ptr):
    call void cmd_cat(rest)
    ret
  d16(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cstore()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, dostore(rest), d17(line, wlen, rest)
  dostore(rest: ptr):
    call void cmd_store(rest)
    ret
  d17(line: ptr, wlen: i64, rest: ptr):
    %c = call ptr s_cping()
    %m = call i64 match(line, wlen, %c)
    %hit = icmp.ne i64 %m, 0
    condbr %hit, doping(), dno(line, wlen)
  doping():
    call void cmd_ping()
    ret
  dno(line: ptr, wlen: i64):
    %empty = icmp.eq i64 wlen, 0
    condbr %empty, fin(), unk(line, wlen)
  unk(line: ptr, wlen: i64):
    %m = call ptr s_unknown()
    call void con_write(%m)
    call void putn(line, wlen)
    call void con_putc(10)
    br fin()
  fin():
    ret
}

; ---- entry ------------------------------------------------------------

fn handle_sc(i64) -> void {
  entry(sc: i64):
    %e0 = iconst i64 0
    %e1 = iconst i64 1
    %e304 = iconst i64 304
    %e464 = iconst i64 464
    %e472 = iconst i64 472
    %s1 = icmp.eq i64 sc, 42
    condbr %s1, shon(), c2(sc)
  c2(sc: i64):
    %s2 = icmp.eq i64 sc, 54
    condbr %s2, shon(), c3(sc)
  c3(sc: i64):
    %s3 = icmp.eq i64 sc, 170
    condbr %s3, shoff(), c4(sc)
  c4(sc: i64):
    %s4 = icmp.eq i64 sc, 182
    condbr %s4, shoff(), c5(sc)
  c5(sc: i64):
    %rel = icmp.sge i64 sc, 128
    condbr %rel, fin(), c6(sc)
  c6(sc: i64):
    %ent = icmp.eq i64 sc, 28
    condbr %ent, enter(), c7(sc)
  c7(sc: i64):
    %bk = icmp.eq i64 sc, 14
    condbr %bk, bksp(), c8(sc)
  c8(sc: i64):
    %big = icmp.sge i64 sc, 58
    condbr %big, fin(), type(sc)
  shon():
    call void st64(472, 1)
    br fin()
  shoff():
    call void st64(472, 0)
    br fin()
  enter():
    call void con_putc(10)
    call void exec_line()
    call void st64(464, 0)
    call void prompt()
    br fin()
  bksp():
    %len = call i64 ld64(464)
    %has = icmp.sgt i64 %len, 0
    condbr %has, bkgo(%len), fin()
  bkgo(len: i64):
    %l2 = sub i64 %len, 1
    call void st64(464, %l2)
    call void con_putc(8)
    br fin()
  type(sc: i64):
    %sh = call i64 ld64(472)
    %issh = icmp.ne i64 %sh, 0
    condbr %issh, tshift(sc), tplain(sc)
  tplain(sc: i64):
    %tab = call ptr s_tab1()
    br tgo(sc, %tab)
  tshift(sc: i64):
    %tab = call ptr s_tab2()
    br tgo(sc, %tab)
  tgo(sc: i64, tab: ptr):
    %a = gep i8 tab, sc
    %b = load i8, %a
    %ch = zext i64 %b
    %nz = icmp.ne i64 %ch, 0
    condbr %nz, tstore(sc, %ch), fin()
  tstore(sc: i64, ch: i64):
    %len = call i64 ld64(464)
    %room = icmp.slt i64 %len, 150
    condbr %room, tput(%len, %ch), fin()
  tput(len: i64, ch: i64):
    %off = add i64 304, %len
    %p = call ptr ksf(%off)
    %tb = trunc i8 ch
    store i8 %p, %tb
    %l2 = add i64 %len, 1
    call void st64(464, %l2)
    call void con_putc(%ch)
    br fin()
  fin():
    ret
}

fn shell_poll() -> void {
  entry():
    br loop()
  loop():
    %sc = call i64 kbd_getc()
    %done = icmp.eq i64 %sc, -1
    condbr %done, fin(), body(%sc)
  body(sc: i64):
    call void handle_sc(sc)
    br loop()
  fin():
    ret
}

fn sched_pass() -> void {
  entry():
    call void shell_poll()
    br loop(1)
  loop(id: i64):
    %done = icmp.sge i64 id, 4
    condbr %done, fin(), body(id)
  body(id: i64):
    %due = call i64 task_due(id)
    %is = icmp.ne i64 %due, 0
    condbr %is, run(id), next(id)
  run(id: i64):
    call void task_run(id)
    br next(id)
  next(id: i64):
    %i2 = add i64 id, 1
    br loop(%i2)
  fin():
    ret
}

fn kernel_loop() -> void {
  entry():
    br loop()
  loop():
    call void sched_pass()
    call void k_hlt()
    br loop()
}

fn main(i32, ptr) -> i32 {
  entry(argc: i32, mbi: ptr):
    %enl = iconst i64 10
    call void ser_init()
    call void con_init()
    %t = call ptr s_banner1()
    call void con_write_a(%t, 11)
    call void con_putc(10)
    %s2 = call ptr s_banner2()
    call void con_write(%s2)
    call void con_putc(10)
    %ok = icmp.eq i32 argc, 0x2badb002
    condbr %ok, okb(mbi), badb(mbi)
  okb(mbi: ptr):
    %m = call ptr s_bootok()
    call void con_write(%m)
    call void con_putc(10)
    br boot2(mbi)
  badb(mbi: ptr):
    %m = call ptr s_bootbad()
    call void con_write(%m)
    call void con_putc(10)
    br boot2(mbi)
  boot2(mbi: ptr):
    %mba = bitcast i64 mbi
    call void st64(49300, %mba)
    call void pmm_init(mbi)
    %bp = call ptr s_bootpfx()
    call void con_write(%bp)
    %a = call ptr s_mema()
    call void con_write(%a)
    %ram = call i64 ld64(496)
    call void putu(%ram)
    %b = call ptr s_memb()
    call void con_write(%b)
    %fr = call i64 ld64(488)
    call void putu(%fr)
    %c = call ptr s_memc()
    call void con_write(%c)
    %tot = call i64 ld64(480)
    call void putu(%tot)
    call void con_putc(10)
    call void mods_init(mbi)
    %mo = call ptr s_modok()
    call void con_write(%mo)
    %mc = call i64 ld64(45376)
    call void putu(%mc)
    call void con_putc(10)
    call void heap_init()
    %hr = call ptr s_heapr()
    call void con_write(%hr)
    call void putu(1048576)
    %hb = call ptr s_heaprb()
    call void con_write(%hb)
    %hbase = call i64 ld64(45064)
    call void putu(%hbase)
    call void con_putc(10)
    call void fs_init()
    %fp = call ptr s_fsdisk()
    call void con_write(%fp)
    %fsp = call i64 ld64(49152)
    %fno = icmp.eq i64 %fsp, 0
    condbr %fno, fsnone(), fsshow()
  fsnone():
    %fn = call ptr s_fsnone()
    call void con_write(%fn)
    br fsdone()
  fsshow():
    %fk = call ptr s_fskfs()
    call void con_write(%fk)
    %fc = call i64 ld64(49176)
    call void putu(%fc)
    %ff = call ptr s_fsfiles()
    call void con_write(%ff)
    %ft = call i64 ld64(49160)
    %fb = call i64 ld64(49168)
    %ffr = sub i64 %ft, %fb
    call void putu(%ffr)
    %fe = call ptr s_fsfree()
    call void con_write(%fe)
    br fsdone()
  fsdone():
    %mbv = call i64 ld64(49300)
    %mbp = bitcast ptr %mbv
    call void fb_init(%mbp)
    %dp = call ptr s_fbpre()
    call void con_write(%dp)
    %dsp = call i64 ld64(77824)
    %dno = icmp.eq i64 %dsp, 0
    condbr %dno, dbnone(), dbshow()
  dbnone():
    %dn = call ptr s_fsnone()
    call void con_write(%dn)
    br dbdone()
  dbshow():
    %dw = call i64 ld64(77848)
    call void putu(%dw)
    %dx = call ptr s_fbx()
    call void con_write(%dx)
    %dh = call i64 ld64(77856)
    call void putu(%dh)
    %db = call ptr s_fbbpp()
    call void con_write(%db)
    %dc = call i64 ld64(77864)
    call void putu(%dc)
    %dx2 = call ptr s_fbcols()
    call void con_write(%dx2)
    %dr = call i64 ld64(77872)
    call void putu(%dr)
    %de = call ptr s_fbend()
    call void con_write(%de)
    br dbdone()
  dbdone():
    call void net_init()
    %np = call ptr s_netpre()
    call void con_write(%np)
    %nsp = call i64 ld64(53248)
    %nno = icmp.eq i64 %nsp, 0
    condbr %nno, nbnone(), nbshow()
  nbnone():
    %nn = call ptr s_fsnone()
    call void con_write(%nn)
    br nbdone()
  nbshow():
    %nm = call ptr s_netmac()
    call void con_write(%nm)
    %base = call ptr ks()
    %bp = bitcast i64 %base
    %ma = add i64 %bp, 53264
    call void print_mac(%ma)
    %ni = call ptr s_netip()
    call void con_write(%ni)
    br nbdone()
  nbdone():
    call void idt_init()
    call void pic_init()
    call void pit_init()
    call void task_setup()
    call void k_sti()
    %i = call ptr s_ints()
    call void con_write(%i)
    call void con_putc(10)
    %r = call ptr s_ready()
    call void con_write(%r)
    call void con_putc(10)
    call void prompt()
    call void kernel_loop()
    ret 0
}
