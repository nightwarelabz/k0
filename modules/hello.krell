data d_msg: i8 = { 104, 101, 108, 108, 111, 32, 102, 114, 111, 109, 32, 97, 32, 75, 114, 101, 108, 108, 32, 109, 111, 100, 117, 108, 101, 10, 0 }
data d_cnt: i8 = { 99, 111, 117, 110, 116, 32, 0 }
data d_tk: i8 = { 116, 105, 99, 107, 115, 32, 97, 116, 32, 115, 116, 97, 114, 116, 32, 0 }
extern kprint(ptr) -> void
extern kputn(i64) -> void
extern kputc(i64) -> void
extern kticks() -> i64

fn main() -> i32 {
  entry():
    %m = dataptr 0
    call void kprint(%m)
    %t = call i64 kticks()
    %s = dataptr 2
    call void kprint(%s)
    call void kputn(%t)
    call void kputc(10)
    br loop(0)
  loop(i: i64):
    %done = icmp.sge i64 i, 5
    condbr %done, fin(), body(i)
  body(i: i64):
    %c = dataptr 1
    call void kprint(%c)
    call void kputn(i)
    call void kputc(10)
    %i2 = add i64 i, 1
    br loop(%i2)
  fin():
    ret 7
}
